import { StoneBoxEntrypoint } from '../0721_gim_limited_sidepanel/stone-box.component';
import { StoneBoxSkin } from '../0721_gim_limited_sidepanel/gim-limited-sidepanel.constants';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { ChannelColor, Layout } from './chatchannel-current.constants';
import { ChannelButtons } from './channel-buttons.component';
import { ChannelHeader } from './channel-header.component';
import { ChannelPane } from './channel-pane.component';
import { SortColumns } from './sort-columns.component';

export function ChatchannelCurrent(): Component {
  return (
    <>
      <ChannelHeader />

      <layer x="center" y={Layout.FRAME_Y} w={{ fill: Layout.FRAME_INSET }} h={{ fill: Layout.FRAME_DROP }}>
        <rect
          x="center"
          y="center"
          w={{ fill: Layout.PLATE_INSET }}
          h={{ fill: Layout.PLATE_INSET }}
          fill
          color={ChannelColor.PLATE}
          transparency={Layout.PLATE_TRANSPARENCY}
        />

        <layer x="center" y="center" w={{ fill: Layout.INNER_INSET }} h={{ fill: Layout.INNER_INSET }}>
          <layer x="center" y={0} w="fill" h={Layout.HEADER_H}>
            <SortColumns />
            <ThinBoxEntrypoint />
          </layer>

          <ChannelPane />

          <ThinBoxEntrypoint />
        </layer>

        <StoneBoxEntrypoint skin={StoneBoxSkin.PLAIN} />
      </layer>

      <ChannelButtons />

      <layer x={0} y={0} w={Layout.TOOLTIP} h={Layout.TOOLTIP} />
    </>
  );
}
