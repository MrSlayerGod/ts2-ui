import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { JournalScrollbar } from './journal-scrollbar.component';
import { CloseSprites, JournalFonts, Layout, ROW_NUDGE, RowY, ScrollModel } from './journalscroll.constants';
import { textLayerRef } from './journalscroll.state';

export function JournalScroll(): Component {
  return (
    <>
      <model
        x={ScrollModel.x}
        y={ScrollModel.y}
        w={ScrollModel.w}
        h={ScrollModel.h}
        model={ScrollModel.MODEL}
        zoom={ScrollModel.ZOOM}
        pitch={ScrollModel.PITCH}
      />

      <text
        x={Layout.HEADING.x}
        y={Layout.HEADING.y}
        w={Layout.HEADING.w}
        h={Layout.HEADING.h}
        font={JournalFonts.QUILL}
      />

      <layer ref={textLayerRef} x={Layout.PANE.x} y={Layout.PANE.y} w={Layout.PANE.w} h={Layout.PANE.h}>
        {RowY.map((y) => (
          <text
            x={y === ROW_NUDGE.Y ? { center: ROW_NUDGE.X } : 'center'}
            y={y}
            w="fill"
            h={Layout.ROW_H}
            font={JournalFonts.BODY}
            align="center"
          />
        ))}
      </layer>

      <layer x={{ right: Layout.SCROLLBAR.right }} y={Layout.SCROLLBAR.y} w={Layout.SCROLLBAR.w} h={Layout.SCROLLBAR.h}>
        <JournalScrollbar />
      </layer>

      <sprite
        x={{ right: Layout.CLOSE.right }}
        y={Layout.CLOSE.y}
        w={Layout.CLOSE.w}
        h={Layout.CLOSE.h}
        sprite={CloseSprites.REST}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapper(event.component, CloseSprites.LIT)}
        onMouseLeave={(event) => graphicSwapper(event.component, CloseSprites.REST)}
      />
    </>
  );
}
