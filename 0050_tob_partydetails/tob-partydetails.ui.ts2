import { BoardAnchors } from '../lib/board-button.component';
import { Anchor, Layout, anchorsRef, universeRef } from './tob-partydetails.constants';
import {
  TobPartydetails,
  TobPartydetailsBack,
  TobPartydetailsFrame,
  TobPartydetailsTooltip,
} from './tob-partydetails.component';

export const tobPartydetailsUi = (): UI => (
  <ui ref={universeRef} x="center" y="center" w={Layout.PANEL_W} h={Layout.PANEL_H}>
    <TobPartydetailsFrame />
    <TobPartydetailsBack />
    <TobPartydetails />
    <TobPartydetailsTooltip />
    <TobPartydetailsAnchors />
    <layer x={0} y={0} w={0} h={0}>
      <BoardAnchors universe={anchorsRef} count={Anchor.COUNT} />
    </layer>
  </ui>
);

function TobPartydetailsAnchors(): Component {
  return <layer ref={anchorsRef} x={0} y={0} w={0} h={0} />;
}
