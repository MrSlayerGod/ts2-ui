function TobPartydetailsSortColumn({
  x,
  w,
  asc,
  desc,
  tip,
}: {
  x: Int;
  w: Int;
  asc: Int;
  desc: Int;
  tip: Int;
}): Component {
  return (
    <layer x={x} y="center" w={w} h={{ fill: Layout.SORT_INSET_H }}>
      <TobPartydetailsSortArrow asc={asc} desc={desc} tip={tip} />
    </layer>
  );
}

function TobPartydetailsRunsColumn(): Component {
  return (
    <layer
      right={Layout.SORT_RUNS_RIGHT}
      y="center"
      w={{ fill: Layout.SORT_RUNS_INSET_W }}
      h={{ fill: Layout.SORT_INSET_H }}
    >
      <TobPartydetailsSortArrow asc={SortKeys.RUNS_ASC} desc={SortKeys.RUNS_DESC} tip={Tip.SORT_RUNS} />
    </layer>
  );
}

function TobPartydetailsSortArrow({ asc, desc, tip }: { asc: Int; desc: Int; tip: Int }): Component {
  const [sort] = useState(raidsListsortDetails);
  let live: Boolean = false;
  if (sort === asc) {
    live = true;
  }
  if (sort === desc) {
    live = true;
  }
  const [hovered, setHovered] = useState(0);
  let rest: Int = 100;
  let lit: Int = 200;
  if (live) {
    rest = 0;
    lit = 120;
  }
  return (
    <layer
      w="fill"
      h="fill"
      onMouseRepeat={() => {
        setHovered(1);
        showTobPartydetailsTip(tip);
      }}
      onMouseLeave={() => {
        setHovered(0);
        hideTobPartydetailsTip();
      }}
      onClick={() => clickTobPartydetailsSort(sort === asc ? desc : asc)}
    >
      <sprite
        x="center"
        y="center"
        w={Layout.SORT_ARROW_W}
        h={Layout.SORT_ARROW_H}
        sprite={sort === desc ? TobPartydetailsSprites.SORT_DESC : TobPartydetailsSprites.SORT_ASC}
        transparency={hovered === 1 ? lit : rest}
      />
    </layer>
  );
}

function TobPartydetailsArrows(): Component {
  const [placed] = useState(arrowsPlaced);
  return (
    <layer x={0} y={Layout.ARROWS_Y} w={Layout.ARROWS_W} h={Layout.ARROWS_H}>
      <ArrowPair index={0} placed={placed} />
      <ArrowPair index={1} placed={placed} />
      <ArrowPair index={2} placed={placed} />
      <ArrowPair index={3} placed={placed} />
      <ArrowPair index={4} placed={placed} />
    </layer>
  );
}

function ArrowPair({ index, placed }: { index: Int; placed: Int }): Component {
  const live: Boolean = CS2.testbit(placed, index);
  const top: Int = index * Layout.ROW_H + Layout.ROW_TOP;
  const left: Int = ROW_COLUMNS_W + 8;
  const rightArrow: Int = left + Layout.ARROW_LIVE + 8;
  return (
    <>
      <MoveArrow x={left} y={top} sprite={TobPartydetailsSprites.MOVE_UP} label={Copy.MOVE_UP} live={live} />
      <MoveArrow x={rightArrow} y={top} sprite={TobPartydetailsSprites.MOVE_DOWN} label={Copy.MOVE_DOWN} live={live} />
    </>
  );
}

function MoveArrow({
  x,
  y,
  sprite,
  label,
  live,
}: {
  x: Int;
  y: Int;
  sprite: Sprite;
  label: String;
  live: Boolean;
}): Component {
  const [hovered, setHovered] = useState(0);
  return (
    <sprite
      x={x}
      y={y}
      w={Layout.ARROW_LIVE}
      h={Layout.ARROW_LIVE}
      sprite={sprite}
      options={[label]}
      hide={!live}
      transparency={hovered === 1 ? Layout.ARROW_HOVER : 0}
      onMouseEnter={() => setHovered(1)}
      onMouseLeave={() => setHovered(0)}
      onClick={() => opsound(1, -1)}
    />
  );
}

function PlateSkin(): Component {
  return (
    <>
      <sprite
        x="center"
        y="center"
        w={{ fill: Layout.PLATE_MID_INSET_W }}
        h={Layout.PLATE_H}
        sprite={TobPartydetailsSprites.PLATE_MID}
        tiling
      />
      <sprite x={0} y="center" w={Layout.PLATE_CAP_W} h={Layout.PLATE_H} sprite={TobPartydetailsSprites.PLATE_LEFT} />
      <sprite
        right={0}
        y="center"
        w={Layout.PLATE_CAP_W}
        h={Layout.PLATE_H}
        sprite={TobPartydetailsSprites.PLATE_RIGHT}
      />
    </>
  );
}

function TobPartydetailsPlate({
  label,
  value,
  subject,
  leader,
  anchor,
  table = false,
}: {
  label: String;
  value: Int;
  subject: String;
  leader: Boolean;
  anchor: Int;
  table?: Boolean;
}): Component {
  const [hovered, setHovered] = useState(0);
  const [busyUntil, setBusyUntil] = useState(0);
  useInterval(() => {
    if (busyUntil !== 0 && clientClock() >= busyUntil) {
      setBusyUntil(0);
      setHovered(0);
    }
  });
  const busy: Boolean = busyUntil !== 0;
  const live: Boolean = leader && !busy;
  let text: String = table ? plateMode(label, value) : plateNumber(label, value);
  let ink: Int = hovered === 1 ? TobPartydetailsColor.PLATE_HOVER : TobPartydetailsColor.PLATE;
  if (busy) {
    text = Copy.WAITING;
    ink = TobPartydetailsColor.MUTED;
  }
  return (
    <layer w="fill" h="fill">
      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        text={text}
        font={TobPartydetailsFonts.ROW}
        color={ink}
        align="center"
        valign="middle"
        shadow
        options={live ? [Copy.SET] : []}
        optionSubject={live ? subject : ''}
        onMouseRepeat={live ? () => setHovered(1) : undefined}
        onMouseLeave={live ? () => setHovered(0) : undefined}
        onOptionSelect={
          live
            ? (event) => {
                if (event.option !== 1) {
                  return;
                }
                if (CS2.cc_find(anchorsRef, anchor) !== true) {
                  return;
                }
                playSound(Sounds.INTERFACE_SELECT1);
                setBusyUntil(clientClock() + BUSY_CYCLES);
                CS2.cc_resume_pausebutton();
              }
            : undefined
        }
      />
    </layer>
  );
}

export function TobPartydetailsFrame(): Component {
  return (
    <layer ref={frameRef} x="center" y="center" w="fill" h="fill" onLoad={() => loadTobPartydetails()}>
      <TobPartydetailsTitle />
      <TobPartydetailsTick />
    </layer>
  );
}

function TobPartydetailsTick(): Component {
  const [start] = useState(autorefreshStart);
  const [forcedClock] = useState(forcedAt);
  useInterval(start >= 0 || forcedClock !== 0 ? () => tobPartydetailsTick() : undefined, tickRef);
  return <layer ref={tickRef} x={0} y={0} w={1} h={1} />;
}

function TobPartydetailsTitle(): Component {
  const [titled] = useState(partyTitled);
  const [leader] = useState(partyLeader);
  if (titled === 0) {
    return null;
  }
  return (
    <layer w="fill" h="fill">
      <SteelBorder title={partyTitle(leader)} titleColor={SteelborderColor.TITLE} flags={0} />
    </layer>
  );
}

export function TobPartydetailsBack(): Component {
  const [built] = useState(boardBuilt);
  const [pressed, setPressed] = useState(0);
  const down: Boolean = pressed === 1 && built === 1;
  return (
    <layer
      x={Layout.BACK_X}
      y={Layout.BACK_Y}
      w={Layout.BACK}
      h={Layout.BACK}
      hide={built === 0}
      options={down ? [] : [Copy.BACK]}
      onOptionSelect={
        down
          ? undefined
          : (event) => {
              if (event.option !== 1) {
                return;
              }
              playSound(Sounds.INTERFACE_SELECT1);
              setPressed(1);
              resumeAnchor(Anchor.BACK);
            }
      }
    >
      <TobPartydetailsBackButton pressed={down} />
    </layer>
  );
}

function TobPartydetailsBackButton({ pressed }: { pressed: Boolean }): Component {
  return (
    <sprite
      x="center"
      y="center"
      w={Layout.BACK}
      h={Layout.BACK}
      sprite={pressed ? TobPartydetailsSprites.BACK_LIT : TobPartydetailsSprites.BACK}
      onMouseRepeat={pressed ? undefined : (event) => backButtonLit(event.component)}
      onMouseLeave={pressed ? undefined : (event) => backButtonRest(event.component)}
    />
  );
}

function backButtonLit(target: ComponentId): void {
  if (!onMobile()) {
    target.sprite = TobPartydetailsSprites.BACK_LIT;
  }
}

function backButtonRest(target: ComponentId): void {
  target.sprite = TobPartydetailsSprites.BACK;
}

function TobPartydetailsActionButton({ role }: { role: Int }): Component {
  const [forced] = useState(forcedButton);
  const [forcedClock] = useState(forcedAt);
  return (
    <layer w="fill" h="fill">
      <BoardButton
        label={actionLabel(role)}
        pressedAt={forced === 1 ? forcedClock : 0}
        resumeIn={anchorsRef}
        resumeAt={Anchor.ACTION}
      />
    </layer>
  );
}

function actionLabel(role: Int): String {
  if (role === PartyRole.LEADER) {
    return Copy.DISBAND;
  }
  if (role === PartyRole.MEMBER) {
    return Copy.LEAVE;
  }
  if (role === PartyRole.APPLICANT) {
    return Copy.WITHDRAW;
  }
  if (role === PartyRole.BLOCKED) {
    return Copy.APPLY_DISABLED;
  }
  return Copy.APPLY;
}

function TobPartydetailsUnblockButton(): Component {
  const [forced] = useState(forcedButton);
  const [forcedClock] = useState(forcedAt);
  return (
    <layer w="fill" h="fill">
      <BoardButton
        label={Copy.UNBLOCK}
        pressedAt={forced === 2 ? forcedClock : 0}
        resumeIn={anchorsRef}
        resumeAt={Anchor.UNBLOCK}
      />
    </layer>
  );
}

function TobPartydetailsMembers(): Component {
  const [lines] = useState(memberLines);
  const [titled] = useState(partyTitled);
  return (
    <layer w="fill" h="fill">
      <rect
        x={0}
        y={0}
        w="fill"
        h={Layout.LEADER_H}
        fill
        color={TobPartydetailsColor.LEADER}
        transparency={Layout.LEADER_TRANSPARENCY}
        hide={titled === 0}
      />
      {MemberSlots.map((slot) => (
        <TobPartydetailsMemberRow slot={slot} record={recordAt(lines, slot)} />
      ))}
    </layer>
  );
}

function rowWash(wash: Int, busy: Boolean, look: Int, waited: Boolean): Int {
  if (busy) {
    return Layout.ROW_TRANSPARENCY_BUSY;
  }
  if (look === 1) {
    return waited ? wash : Layout.ROW_TRANSPARENCY_HOVER;
  }
  if (look === 2) {
    return Layout.ROW_TRANSPARENCY;
  }
  return wash;
}

function TobPartydetailsMemberRow({ slot, record }: { slot: Int; record: String }): Component {
  const [look, setLook] = useState(0);
  const [busyUntil, setBusyUntil] = useState(0);
  const [waited, setWaited] = useState(0);
  useInterval(() => {
    if (busyUntil !== 0 && clientClock() >= busyUntil) {
      setBusyUntil(0);
      setWaited(1);
      setLook(0);
    }
  });
  if (record.length === 0) {
    return null;
  }
  const role: Int = recordRole(record);
  const line: String = recordLine(record);
  const name: String = lineField(line, 0);
  const top: Int = slot * Layout.ROW_H + Layout.ROW_TOP;
  const wash: Int = rowTransparency(slot);
  const ink: Int = rowColor(name);
  const leader: Boolean = role === PartyRole.LEADER && name.length > 0;
  const busy: Boolean = busyUntil !== 0;
  const live: Boolean = leader && !busy;
  return (
    <layer x={0} y={0} w="fill" h="fill">
      <rect
        x="center"
        y={top}
        w="fill"
        h={Layout.ROW_H}
        fill
        color={TobPartydetailsColor.ROW_BACK}
        transparency={rowWash(wash, busy, look, waited === 1)}
        options={live ? ['', '', '', '', '', '', '', '', '', slot === 0 ? Copy.QUIT_PARTY : Copy.KICK] : []}
        optionSubject={live && slot > 0 ? rowSubject(name) : ''}
        onMouseRepeat={live ? () => setLook(1) : undefined}
        onMouseLeave={live ? () => setLook(waited === 1 ? 2 : 0) : undefined}
        onOptionSelect={
          live
            ? (event) => {
                if (event.option !== 10) {
                  return;
                }
                if (CS2.cc_find(anchorsRef, Anchor.KICK + slot) !== true) {
                  return;
                }
                playSound(Sounds.INTERFACE_SELECT1);
                setBusyUntil(clientClock() + BUSY_CYCLES);
                CS2.cc_resume_pausebutton();
              }
            : undefined
        }
      />
      <RowCell x={RowColumns.NAME.x} w={RowColumns.NAME.w} y={top} field={name} ink={ink} />
      <RowCell x={RowColumns.COMBAT.x} w={RowColumns.COMBAT.w} y={top} field={lineField(line, 1)} ink={ink} />
      <RowCell x={RowColumns.ATTACK.x} w={RowColumns.ATTACK.w} y={top} field={lineField(line, 2)} ink={ink} />
      <RowCell x={RowColumns.STRENGTH.x} w={RowColumns.STRENGTH.w} y={top} field={lineField(line, 3)} ink={ink} />
      <RowCell x={RowColumns.RANGED.x} w={RowColumns.RANGED.w} y={top} field={lineField(line, 4)} ink={ink} />
      <RowCell x={RowColumns.MAGIC.x} w={RowColumns.MAGIC.w} y={top} field={lineField(line, 5)} ink={ink} />
      <RowCell x={RowColumns.DEFENCE.x} w={RowColumns.DEFENCE.w} y={top} field={lineField(line, 6)} ink={ink} />
      <RowCell x={RowColumns.HITPOINTS.x} w={RowColumns.HITPOINTS.w} y={top} field={lineField(line, 7)} ink={ink} />
      <RowCell x={RowColumns.PRAYER.x} w={RowColumns.PRAYER.w} y={top} field={lineField(line, 8)} ink={ink} />
      <RowCell x={RowColumns.RUNS.x} w={RowColumns.RUNS.w} y={top} field={lineField(line, 9)} ink={ink} />
    </layer>
  );
}

function isDescendingSort(key: Int): Boolean {
  if (key === SortKeys.NAME_DESC || key === SortKeys.COMBAT_DESC || key === SortKeys.RUNS_DESC) {
    return true;
  }
  return key >= SortKeys.ATTACK_DESC && key <= SortKeys.PRAYER_DESC && key % 2 === 1;
}

function sortField(sort: Int): Int {
  if (sort === 2 || sort === 3) {
    return 1;
  }
  if (sort === 8 || sort === 9) {
    return 2;
  }
  if (sort === 10 || sort === 11) {
    return 3;
  }
  if (sort === 12 || sort === 13) {
    return 4;
  }
  if (sort === 14 || sort === 15) {
    return 5;
  }
  if (sort === 16 || sort === 17) {
    return 6;
  }
  if (sort === 18 || sort === 19) {
    return 7;
  }
  if (sort === 20 || sort === 21) {
    return 8;
  }
  if (sort === 6 || sort === 7) {
    return 9;
  }
  return 0;
}

function applicantKey(line: String, slot: Int, field: Int): String {
  const value: String = CS2.tags_remove(lineField(line, field));
  if (field === 0) {
    return value;
  }
  return `${value.padStart(SORT_KEY_W, '0')}${slot * Layout.APPLICANT_STRIDE}`;
}

function TobPartydetailsApplicants(): Component {
  const [lines] = useState(applicantLines);
  const [built] = useState(boardBuilt);
  const [role] = useState(boardRole);
  const [sort] = useState(raidsListsortDetails);
  const [raids] = useState(raidsCount);
  let count: Int = recordCount(lines);
  if (built === 0) {
    count = 0;
  }
  if (raids - 5 < count) {
    count = raids - 5;
  }
  if (count > APPLICANT_SLOTS) {
    count = APPLICANT_SLOTS;
  }
  const field: Int = sortField(sort);
  const descending: Boolean = isDescendingSort(sort);

  const ranks = intArray(APPLICANT_SLOTS);
  let slot: Int = 0;
  while (slot < APPLICANT_SLOTS) {
    let rank: Int = slot;
    if (count >= 2 && slot < count) {
      rank = 0;
      const mine: String = applicantKey(recordAt(lines, slot), slot, field);
      let other: Int = 0;
      while (other < count) {
        if (other !== slot) {
          const order: Int = CS2.compare(applicantKey(recordAt(lines, other), other, field), mine);
          if (order < 0 || (order === 0 && other < slot)) {
            rank = rank + 1;
          }
        }
        other = other + 1;
      }
    }
    ranks[slot] = rank;
    slot = slot + 1;
  }

  return (
    <layer w="fill" h="fill">
      {ApplicantSlots.map((at) => (
        <TobPartydetailsApplicantRow
          slot={at}
          line={at < count ? recordAt(lines, at) : ''}
          place={descending ? count - 1 - ranks[at] : ranks[at]}
          wash={rowTransparency(ranks[at])}
          leader={role === PartyRole.LEADER}
        />
      ))}
    </layer>
  );
}

function TobPartydetailsApplicantRow({
  slot,
  line,
  place,
  wash,
  leader,
}: {
  slot: Int;
  line: String;
  place: Int;
  wash: Int;
  leader: Boolean;
}): Component {
  const [look, setLook] = useState(0);
  const [busyUntil, setBusyUntil] = useState(0);
  const [waited, setWaited] = useState(0);
  useInterval(() => {
    if (busyUntil !== 0 && clientClock() >= busyUntil) {
      setBusyUntil(0);
      setWaited(1);
      setLook(0);
    }
  });
  if (line.length === 0) {
    return null;
  }
  const name: String = lineField(line, 0);
  const top: Int = place * Layout.ROW_H;
  const ink: Int = rowColor(name);
  const busy: Boolean = busyUntil !== 0;
  const live: Boolean = leader && !busy;
  return (
    <layer x={0} y={0} w="fill" h="fill">
      <rect
        x="center"
        y={top}
        w="fill"
        h={Layout.ROW_H}
        fill
        color={TobPartydetailsColor.ROW_BACK}
        transparency={rowWash(wash, busy, look, waited === 1)}
        options={live ? [Copy.ACCEPT, '', '', '', '', '', '', '', '', Copy.REJECT] : []}
        optionSubject={live ? rowSubject(name) : ''}
        onMouseRepeat={live ? () => setLook(1) : undefined}
        onMouseLeave={live ? () => setLook(waited === 1 ? 2 : 0) : undefined}
        onOptionSelect={
          live
            ? (event) => {
                let anchor: Int = -1;
                if (event.option === 1) {
                  anchor = Anchor.ACCEPT + slot;
                } else if (event.option === 10) {
                  anchor = Anchor.REJECT + slot;
                }
                if (anchor === -1 || CS2.cc_find(anchorsRef, anchor) !== true) {
                  return;
                }
                playSound(Sounds.INTERFACE_SELECT1);
                setBusyUntil(clientClock() + BUSY_CYCLES);
                CS2.cc_resume_pausebutton();
              }
            : undefined
        }
      />
      <ApplicantCell x={RowColumns.NAME.x} w={RowColumns.NAME.w} y={top} field={name} ink={ink} />
      <ApplicantCell x={RowColumns.COMBAT.x} w={RowColumns.COMBAT.w} y={top} field={lineField(line, 1)} ink={ink} />
      <ApplicantCell x={RowColumns.ATTACK.x} w={RowColumns.ATTACK.w} y={top} field={lineField(line, 2)} ink={ink} />
      <ApplicantCell x={RowColumns.STRENGTH.x} w={RowColumns.STRENGTH.w} y={top} field={lineField(line, 3)} ink={ink} />
      <ApplicantCell x={RowColumns.RANGED.x} w={RowColumns.RANGED.w} y={top} field={lineField(line, 4)} ink={ink} />
      <ApplicantCell x={RowColumns.MAGIC.x} w={RowColumns.MAGIC.w} y={top} field={lineField(line, 5)} ink={ink} />
      <ApplicantCell x={RowColumns.DEFENCE.x} w={RowColumns.DEFENCE.w} y={top} field={lineField(line, 6)} ink={ink} />
      <ApplicantCell
        x={RowColumns.HITPOINTS.x}
        w={RowColumns.HITPOINTS.w}
        y={top}
        field={lineField(line, 7)}
        ink={ink}
      />
      <ApplicantCell x={RowColumns.PRAYER.x} w={RowColumns.PRAYER.w} y={top} field={lineField(line, 8)} ink={ink} />
      <ApplicantCell x={RowColumns.RUNS.x} w={RowColumns.RUNS.w} y={top} field={lineField(line, 9)} ink={ink} />
    </layer>
  );
}

function RowCell({ x, y, w, field, ink }: { x: Int; y: Int; w: Int; field: String; ink: Int }): Component {
  return (
    <text
      x={x}
      y={y}
      w={w}
      h={Layout.ROW_H}
      text={cellText(field)}
      font={TobPartydetailsFonts.ROW}
      color={cellColor(field, ink)}
      align="center"
      valign="middle"
      shadow
    />
  );
}

function ApplicantCell({ x, y, w, field, ink }: { x: Int; y: Int; w: Int; field: String; ink: Int }): Component {
  return (
    <text
      x={x}
      y={y}
      w={w}
      h={Layout.ROW_H}
      text={field}
      font={TobPartydetailsFonts.ROW}
      color={ink}
      align="center"
      valign="middle"
      shadow
    />
  );
}

export function TobPartydetailsTooltip(): Component {
  const [key] = useState(tipIndex);
  const tip: TobPartydetailsTip | null = TobPartydetailsTips.at(key);

  const hostW: Int = universeRef.width;
  const hostH: Int = universeRef.height;
  const rootX: Int = universeRef.x;
  const rootY: Int = universeRef.y;

  let text: String = '';
  let anchorX: Int = 0;
  let anchorY: Int = 0;
  let anchorH: Int = 0;
  let wrap: Int = Tooltip.WRAP;
  if (tooltipUp() && key >= 0 && tip !== null) {
    text = tip.text;
    anchorX = tip.x + rootX;
    anchorY = tip.y + rootY;
    anchorH = tip.h;
    wrap = tip.wrap;
  }
  let measure: Int = wrap;
  if (measure > hostW) {
    measure = hostW;
  }
  measure = measure - TooltipBox.padX;
  const boxW: Int = TooltipBox.padX + textWidth(text, measure, TooltipBox.font);
  const boxH: Int = TooltipBox.padY + TooltipBox.line * textLineCount(text, measure, TooltipBox.font);

  let x: Int = anchorX + TooltipBox.nudge;
  if (x > hostW - boxW) {
    x = hostW - boxW;
  }
  let y: Int = anchorY + anchorH + TooltipBox.nudge;
  if (y > hostH - boxH) {
    y = anchorY - boxH - TooltipBox.nudge;
  }

  let shown: Boolean = false;
  if (text.length > 0) {
    shown = true;
  }

  return (
    <layer
      ref={tooltipRef}
      x={shown ? x : 0}
      y={shown ? y : 0}
      w={shown ? boxW : Layout.TOOLTIP}
      h={shown ? boxH : Layout.TOOLTIP}
    >
      {shown && <TooltipChrome text={text} font={TooltipBox.font} lineHeight={0} />}
    </layer>
  );
}
