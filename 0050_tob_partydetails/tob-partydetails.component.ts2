      />
      <TobPartydetailsHeader />
      <layer
        ref={currentRef}
        x="center"
        y={{ bottom: Layout.CURRENT_BOTTOM }}
        w={{ fill: Layout.CURRENT_INSET_W }}
        h={Layout.CURRENT_H}
        dragDeadZone={Layout.CURRENT_DRAG_DEAD_ZONE}
      >
        <TobPartydetailsMembers />
      </layer>
