}

function TobPartydetailsHeader(): Component {
  const [built] = useState(boardBuilt);
  const [remaining] = useState(dialRemaining);
  const [started] = useState(autorefreshStart);
  const shell: Boolean = built === 0;
  const [forced] = useState(forcedButton);
  const [forcedClock] = useState(forcedAt);
  let pressedAt: Int = 0;
  if (started >= 0 && remaining === 0) {
    pressedAt = started + AutoRefresh.CYCLES;
  }
  if (forced === 0 && forcedClock > pressedAt) {
    pressedAt = forcedClock;
  }
  return (
    <layer x="center" y={0} w="fill" h={Layout.HEADER_H} hide={shell}>
      <layer x={Layout.REFRESH_X} y="center" w={Layout.REFRESH_W} h={{ fill: Layout.HEADER_ROW_INSET_H }} hide={shell}>
        <BoardButton label={Copy.REFRESH} pressedAt={pressedAt} resumeIn={anchorsRef} resumeAt={Anchor.REFRESH} />
      </layer>

      <layer x={Layout.DIAL_X} y="center" w={Layout.DIAL_W} h="fill">
        <DialModels lit={false} />
        <TobPartydetailsTimerWipe remaining={remaining} />
      </layer>

      <sprite
        x={Layout.ICON_COMBAT_X}
        y="center"
        w={Layout.ICON_COMBAT_W}
        h={Layout.ICON_COMBAT_H}
        sprite={TobPartydetailsSprites.COMBAT}
        onMouseRepeat={() => showTobPartydetailsTip(Tip.COMBAT)}
        onMouseLeave={() => hideTobPartydetailsTip()}
      />
      <sprite
        x={Layout.ICON_ATTACK_X}
        y="center"
        w={Layout.ICON_W}
        h={Layout.ICON_W}
        sprite={TobPartydetailsSprites.ATTACK}
        onMouseRepeat={() => showTobPartydetailsTip(Tip.ATTACK)}
        onMouseLeave={() => hideTobPartydetailsTip()}
      />
      <sprite
        x={Layout.ICON_STRENGTH_X}
        y="center"
        w={Layout.ICON_W}
        h={Layout.ICON_W}
        sprite={TobPartydetailsSprites.STRENGTH}
        onMouseRepeat={() => showTobPartydetailsTip(Tip.STRENGTH)}
        onMouseLeave={() => hideTobPartydetailsTip()}
      />
      <sprite
        x={Layout.ICON_RANGED_X}
        y="center"
        w={Layout.ICON_W}
        h={Layout.ICON_W}
        sprite={TobPartydetailsSprites.RANGED}
        onMouseRepeat={() => showTobPartydetailsTip(Tip.RANGED)}
        onMouseLeave={() => hideTobPartydetailsTip()}
      />
      <sprite
        x={Layout.ICON_MAGIC_X}
        y="center"
        w={Layout.ICON_W}
        h={Layout.ICON_W}
        sprite={TobPartydetailsSprites.MAGIC}
        onMouseRepeat={() => showTobPartydetailsTip(Tip.MAGIC)}
        onMouseLeave={() => hideTobPartydetailsTip()}
      />
      <sprite
        x={Layout.ICON_DEFENCE_X}
        y="center"
        w={Layout.ICON_W}
        h={Layout.ICON_W}
        sprite={TobPartydetailsSprites.DEFENCE}
        onMouseRepeat={() => showTobPartydetailsTip(Tip.DEFENCE)}
        onMouseLeave={() => hideTobPartydetailsTip()}
      />
      <sprite
        x={Layout.ICON_HITPOINTS_X}
        y="center"
        w={Layout.ICON_W}
        h={Layout.ICON_W}
        sprite={TobPartydetailsSprites.HITPOINTS}
        onMouseRepeat={() => showTobPartydetailsTip(Tip.HITPOINTS)}
        onMouseLeave={() => hideTobPartydetailsTip()}
      />
      <sprite
        x={Layout.ICON_PRAYER_X}
        y="center"
        w={Layout.ICON_W}
        h={Layout.ICON_W}
        sprite={TobPartydetailsSprites.PRAYER}
        onMouseRepeat={() => showTobPartydetailsTip(Tip.PRAYER)}
        onMouseLeave={() => hideTobPartydetailsTip()}
      />
      <model
        right={Layout.ICON_RUNS_RIGHT}
        y={0}
        w={{ fill: Layout.ICON_RUNS_INSET_W }}
        h="fill"
        model={TobPartydetailsModels.CHEST}
        zoom={1245}
        pitch={512}
        yaw={1700}
        offsetX={-20}
        offsetY={-5}
        onMouseRepeat={() => showTobPartydetailsTip(Tip.RUNS)}
        onMouseLeave={() => hideTobPartydetailsTip()}
      />

      <ThinBoxEntrypoint />
    </layer>
  );
}

