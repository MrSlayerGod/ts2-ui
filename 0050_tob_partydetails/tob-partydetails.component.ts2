}

function TobPartydetailsLoading(): Component {
  const [built] = useState(boardBuilt);
  if (built === 1) {
    return null;
  }
  return (
    <text
      x="center"
      y="center"
      w="fill"
      h="fill"
      text={Copy.LOADING}
      font={TobPartydetailsFonts.BODY}
      color={TobPartydetailsColor.MUTED}
      align="center"
      valign="middle"
      shadow
    />
  );
}

