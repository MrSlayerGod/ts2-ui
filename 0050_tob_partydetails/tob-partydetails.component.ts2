function TobPartydetailsTimerWipe({ remaining }: { remaining: Int }): Component {
  return (
    <layer x={0} y="center" w={Layout.DIAL_W * remaining / AutoRefresh.CYCLES} h="fill">
      <DialModels lit />
    </layer>
