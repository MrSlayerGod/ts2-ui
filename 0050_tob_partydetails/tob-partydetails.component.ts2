function TobPartydetailsMiddleText(): Component {
  const [built] = useState(boardBuilt);
  const [count] = useState(raidsCount);
  if (built === 1 && count - 5 > 0) {
    return null;
  }
  return (
    <text
      x="center"
      y="center"
      w="fill"
      h="fill"
      text={built === 1 ? Copy.NO_APPLICANTS : Copy.LOADING}
      font={TobPartydetailsFonts.BODY}
      color={TobPartydetailsColor.MUTED}
      align="center"
      valign="middle"
      shadow
    />
  );
}

