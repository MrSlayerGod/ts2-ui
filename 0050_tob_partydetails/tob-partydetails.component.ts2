export function TobPartydetails(): Component {
  return (
    <layer
      x="center"
      y={{ bottom: Layout.CONTENT_BOTTOM }}
      w={{ fill: Layout.CONTENT_INSET_W }}
      h={{ fill: Layout.CONTENT_INSET_H }}
    >
      <TobPartydetailsTop />
      <TobPartydetailsMiddle />

      <model
        x={0}
        y="bottom"
        w={Layout.DECOR_W}
        h={Layout.DECOR_H}
        model={TobPartydetailsModels.CHEST_ALT}
        zoom={1800}
        pitch={512}
        offsetX={-67}
        offsetY={18}
      />
      <model
        x={0}
        y="bottom"
        w={Layout.DECOR_W}
        h={Layout.DECOR_H}
        model={TobPartydetailsModels.CHEST}
        zoom={1500}
        pitch={512}
        yaw={648}
        offsetX={21}
        offsetY={5}
      />
      <model
        x={0}
        y="bottom"
        w={Layout.DECOR_W}
        h={Layout.DECOR_H}
        model={TobPartydetailsModels.CHEST_ALT}
        zoom={1900}
        pitch={512}
        yaw={842}
        offsetX={91}
        offsetY={-33}
      />

      <TobPartydetailsBottomBar />
      <TobPartydetailsArrows />
    </layer>
  );
}

function TobPartydetailsBottomBar(): Component {
  const [built] = useState(boardBuilt);
  const [role] = useState(boardRole);
  const [size] = useState(boardSize);
  const [level] = useState(boardLevel);
  const [mode] = useState(boardMode);
  const shell: Boolean = built === 0;
  const leader: Boolean = role === PartyRole.LEADER;
  return (
    <>
      <layer x={0} y="bottom" w={Layout.BUTTON_W} h={{ fill: Layout.BUTTON_INSET_H }} hide={shell || !leader}>
        <TobPartydetailsUnblockButton />
      </layer>

      <layer
        x={Layout.PLATE_MODE_X}
        y={{ bottom: Layout.PLATE_BOTTOM }}
        w={Layout.PLATE_MODE_W}
        h={Layout.PLATE_H}
        hide={shell}
      >
        <PlateSkin />
        <TobPartydetailsPlate
          label={Copy.MODE}
          value={mode}
          leader={leader}
          subject={Copy.SUBJECT_MODE}
          anchor={Anchor.MODE}
          table
        />
      </layer>
      <layer
        x={Layout.PLATE_SIZE_X}
        y={{ bottom: Layout.PLATE_BOTTOM }}
        w={Layout.PLATE_SIZE_W}
        h={Layout.PLATE_H}
        hide={shell}
      >
        <PlateSkin />
        <TobPartydetailsPlate
          label={Copy.PREFERRED_SIZE}
          value={size}
          leader={leader}
          subject={Copy.SUBJECT_SIZE}
          anchor={Anchor.SIZE}
        />
      </layer>
      <layer
        x={Layout.PLATE_LEVEL_X}
        y={{ bottom: Layout.PLATE_BOTTOM }}
        w={Layout.PLATE_LEVEL_W}
        h={Layout.PLATE_H}
        hide={shell}
      >
        <PlateSkin />
        <TobPartydetailsPlate
          label={Copy.PREFERRED_LEVEL}
          value={level}
          leader={leader}
          subject={Copy.SUBJECT_LEVEL}
          anchor={Anchor.LEVEL}
        />
      </layer>

      <layer right={0} y="bottom" w={Layout.BUTTON_W} h={{ fill: Layout.BUTTON_INSET_H }} hide={shell}>
        <TobPartydetailsActionButton role={role} />
      </layer>
    </>
  );
}

function TobPartydetailsTop(): Component {
  return (
    <layer ref={topRef} x="center" y={0} w="fill" h={Layout.TOP_H}>
      <sprite x="center" y="center" w="fill" h="fill" sprite={TobPartydetailsSprites.BACKING} tiling />
      <rect x="center" y="center" w="fill" h="fill" color={TobPartydetailsColor.BOX_OUTER} />
      <rect
        x="center"
        y="center"
        w={{ fill: Layout.BOX_INNER_INSET }}
        h={{ fill: Layout.BOX_INNER_INSET }}
