function wearOp(held: Item, n: Int): String {
  if (held === -1) {
    return '';
  }
  let offerable: Boolean = false;
  if (membersWorld()) {
    offerable = true;
  }
  if (CS2.item_members(held) === 0) {
    offerable = true;
  }
  if (!offerable) {
    return '';
  }
  if (n === 1) {
    return held.wearOp1!;
  }
  if (n === 2) {
    return held.wearOp2!;
  }
  if (n === 3) {
    return held.wearOp3!;
  }
  if (n === 4) {
    return held.wearOp4!;
  }
  if (n === 5) {
    return held.wearOp5!;
  }
  if (n === 6) {
    return held.wearOp6!;
  }
  if (n === 7) {
    return held.wearOp7!;
  }
  return held.wearOp8!;
}

const OP_REMOVE = 'Remove';
