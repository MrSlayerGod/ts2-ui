import { useInventory } from 'ts2';
import { Inventories, SlotIcons, SlotSprites } from './wornitems.constants';

export function EquipSlotButton({ slot }: { slot: Int }): Component {
  const worn = useInventory(Inventories.WORN);
  const equipped: Boolean = worn[slot] !== -1;

  return (
    <>
      <sprite x="center" y="center" w={36} h={36} sprite={SlotSprites.PLATE} />

      {!equipped && <sprite x="center" y="center" w={32} h={32} sprite={SlotIcons.get(slot) ?? -1} />}
    </>
  );
}
