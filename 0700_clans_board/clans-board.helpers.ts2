import { CS2, intArray } from 'ts2';

import { hasBit, textLineCount, textWidth } from '../lib/lib.engine';
import { pipeHead, pipeTail } from '../lib/lib.format';
import { ClanBoardFonts, Copy, Layout, SLOT_COUNT, SortMode } from './clans-board.constants';
import { ClanInterests } from './clans-board.data';

export function packetField(line: String, n: Int): String {
  let rest: String = line;
  let skipped: Int = 0;
  while (skipped < n) {
    rest = pipeTail(rest);
    skipped = skipped + 1;
  }
  return pipeHead(rest);
}

function recordTag(slot: Int): String {
  return `^${slot}~`;
}

function slotRecord(board: String, slot: Int): String {
  const tag: String = recordTag(slot);
  const at: Int = board.indexOf(tag, 0);
  if (at === -1) {
    return '';
  }
  const start: Int = at + tag.length;
  const end: Int = board.indexOf('^', start);
  if (end === -1) {
    return board.substring(start, board.length);
  }
  return board.substring(start, end);
}

export function packetLine(board: String, slot: Int): String {
  const record: String = slotRecord(board, slot);
  if (record.length === 0) {
    return '';
  }
  return record.substring(record.indexOf('~', 0) + 1, record.length);
}

export function packetFlags(board: String, slot: Int): Int {
  const record: String = slotRecord(board, slot);
  if (record.length === 0) {
    return 0;
  }
  return parseInt(record.substring(0, record.indexOf('~', 0)));
}

export function withRecord(board: String, slot: Int, line: String, flags: Int): String {
  let rest: String = board;
  const tag: String = recordTag(slot);
  const at: Int = board.indexOf(tag, 0);
  if (at !== -1) {
    const end: Int = board.indexOf('^', at + tag.length);
    rest = end === -1 ? board.substring(0, at) : board.substring(0, at).concat(board.substring(end, board.length));
  }
  if (line.length === 0) {
    return rest;
  }
  return `${rest}${tag}${flags}~${line}`;
}

export function formatInterests(mask: String, flags: Int): String {
  const length: Int = mask.length;
  const ticked = intArray(16);
  let count: Int = 0;
  let at: Int = 0;
  while (at < length) {
    if ('01'.indexOf(mask.substring(at, at + 1), 0) === 1 && (ClanInterests.at(at) ?? '').length > 0) {
      ticked[count] = at;
      count = count + 1;
    }
    at = at + 1;
  }
  let text: String = '';
  let name: String = '';
  at = 0;
  while (at < count) {
    name = ClanInterests.at(ticked[at]) ?? '';
    if (hasBit(flags, ticked[at])) {
      name = `<col=ffffff>${name}</col>`;
    } else {
      name = `<col=afafaf>${name}</col>`;
    }
    if (at > 0) {
      if (at < count - 1) {
        text = `${text}, ${name}`;
      } else {
        text = `${text} and ${name}.`;
      }
    } else {
      text = `${text}${name}`;
    }
    at = at + 1;
  }
  if (at <= 0) {
    text = `${text}No interests listed.`;
  }
  return text;
}

export function requirementBits(line: String): Int {
  let bits: Int = 0;
  if (packetField(line, 5).length > 0) {
    bits = bits | 1;
  }
  if (packetField(line, 6).length > 0) {
    bits = bits | 2;
  }
  return bits;
}

export function requirementsText(line: String): String {
  const bits: Int = requirementBits(line);
  const combat: String = packetField(line, 5);
  const total: String = packetField(line, 6);
  if (bits === 3) {
    return `Combat level: <col=ff981f>${combat}</col>, Skill total: <col=ff981f>${total}</col>`;
  }
  if (bits === 2) {
    return `Skill total: <col=ff981f>${total}</col>`;
  }
  if (bits === 1) {
    return `Combat level: <col=ff981f>${combat}</col>`;
  }
  return '';
}

export function interestsHeight(line: String, flags: Int, wrapWidth: Int): Int {
  return textLineCount(formatInterests(packetField(line, 4), flags), wrapWidth, ClanBoardFonts.BODY) * Layout.ROW_LINE_H +
    Layout.ROW_INTERESTS_PAD;
}

export function rowHeight(line: String, flags: Int, wrapWidth: Int): Int {
  let height: Int = Layout.ROW_HEAD_H + interestsHeight(line, flags, wrapWidth) + Layout.ROW_TAIL;
  if (requirementBits(line) > 0) {
    height = height + Layout.ROW_REQUIREMENTS_H;
  }
  return height;
}

export function normalisedSort(sort: Int): Int {
  if (sort >= SortMode.CREATED_DESC && sort <= SortMode.CREATED_ASC) {
    return sort;
  }
  return SortMode.CREATED_ASC;
}

export function sortDescending(sort: Int): Boolean {
  if (sort === SortMode.NAME_DESC || sort === SortMode.SIZE_DESC || sort === SortMode.CREATED_DESC) {
    return true;
  }
  return false;
}

export function sortKey(line: String, slot: Int, sort: Int): String {
  if (sort === SortMode.NAME_ASC || sort === SortMode.NAME_DESC) {
    return CS2.tags_remove(packetField(line, 0));
  }
  if (sort === SortMode.SIZE_ASC || sort === SortMode.SIZE_DESC) {
    return `${packetField(line, 1).padStart(3, '0')}${slot}`;
  }
  return `${packetField(line, 3).padStart(6, '0')}${slot}`;
}

export function sortsBefore(keyA: String, a: Int, keyB: String, b: Int): Boolean {
  const order: Int = CS2.compare(keyA, keyB);
  if (order < 0) {
    return true;
  }
  if (order === 0 && a < b) {
    return true;
  }
  return false;
}

export function slotHeight(board: String, slot: Int, wrapWidth: Int): Int {
  const line: String = packetLine(board, slot);
  if (line.length === 0) {
    return 0;
  }
  return rowHeight(line, packetFlags(board, slot), wrapWidth);
}

export function filledRowCount(board: String): Int {
  let filled: Int = 0;
  let slot: Int = 0;
  const count: Int = SLOT_COUNT;
  while (slot < count) {
    if (packetLine(board, slot).length > 0) {
      filled = filled + 1;
    }
    slot = slot + 1;
  }
  return filled;
}

export function listExtent(board: String, wrapWidth: Int): Int {
  let extent: Int = 0;
  let slot: Int = 0;
  const count: Int = SLOT_COUNT;
  while (slot < count) {
    const line: String = packetLine(board, slot);
    if (line.length > 0) {
      extent = extent + rowHeight(line, packetFlags(board, slot), wrapWidth);
    }
    slot = slot + 1;
  }
  return extent;
}

export function filtersExtent(rowHeightEach: Int): Int {
  let extent: Int = 0;
  let index: Int = 0;
  const count: Int = ClanInterests.length;
  while (index < count) {
    if ((ClanInterests.at(index) ?? '').length > 0) {
      extent = extent + rowHeightEach;
    }
    index = index + 1;
  }
  return extent;
}

export function filtersFloor(): Int {
  return Layout.FILTERS_FLOOR + Layout.LEGEND_H;
}

export function listFloor(): Int {
  return Layout.LIST_FLOOR + Layout.SORT_H + Layout.LIST_FLOOR_PAD + Layout.BOTTOM_H;
}

export function boardHeight(slotHeight: Int, filtersContent: Int, listContent: Int): Int {
  const wanted: Int = Math.max(filtersContent + filtersFloor(), listContent + listFloor());
  return Math.min(slotHeight - Layout.PANEL_MARGIN, wanted);
}

export function paneScrollExtent(content: Int, height: Int, floor: Int): Int {
  if (content > height - floor) {
    return content;
  }
  return 0;
}

export function filtersScrollHeight(board: String, slotHeight: Int, filterRowHeight: Int): Int {
  const filtersContent: Int = filtersExtent(filterRowHeight);
  const listContent: Int = listExtent(board, Layout.LIST_PANE_W - Layout.ROW_INSET_W);
  const height: Int = boardHeight(slotHeight, filtersContent, listContent);
  return paneScrollExtent(filtersContent, height, filtersFloor());
}

export function listScrollHeight(board: String, slotHeight: Int, filterRowHeight: Int, listWidth: Int): Int {
  const filtersContent: Int = filtersExtent(filterRowHeight);
  const listContent: Int = listExtent(board, listWidth - Layout.ROW_INSET_W);
  const height: Int = boardHeight(slotHeight, filtersContent, listContent);
  return paneScrollExtent(listContent, height, listFloor());
}

export function noClansText(filtered: Int): String {
  if (filtered !== 0) {
    return 'No clans matching your filter settings, for which you satisfy the requirements, are currently accepting applications on this world.';
  }
  return 'No clans for which you satisfy the requirements are currently accepting applications on this world.';
}

export function myclanWidth(): Int {
  return Layout.BUTTON_PAD +
    Math.max(
      textWidth(Copy.LIST_CLAN, Layout.MEASURE_W, ClanBoardFonts.BODY),
      textWidth(Copy.DELIST_CLAN, Layout.MEASURE_W, ClanBoardFonts.BODY),
    );
}

export function applicantsWidth(): Int {
  return Layout.BUTTON_PAD + textWidth(Copy.APPLICANTS, Layout.MEASURE_W, ClanBoardFonts.BODY);
}

export function refreshWidth(): Int {
  return Layout.BUTTON_PAD + textWidth(Copy.REFRESH, Layout.MEASURE_W, ClanBoardFonts.BODY);
}

export function bottomBarWidth(): Int {
  return Layout.PANEL_W - Layout.CONTENT_INSET_W - Layout.LIST_COLUMN_INSET_W;
}

export function buttonGap(myclanW: Int, applicantsW: Int, refreshW: Int): Int {
  return (bottomBarWidth() - Layout.BOTTOM_INSET - (myclanW + applicantsW + refreshW)) / 4;
}
