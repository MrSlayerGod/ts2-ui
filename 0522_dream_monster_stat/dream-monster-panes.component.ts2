import { useState } from 'ts2';

import { DreamMonsterColor, DreamMonsterFonts, Layout, Panes, Tab } from './dream-monster-stat.constants';
import { dreamMonsterData, dreamMonsterPopulated, dreamMonsterTab, populatedField } from './dream-monster-stat.state';
import { textLineCount } from '../lib/lib.engine';

function paneHidden(tab: Tab, selected: Tab): Boolean {
  if (selected === Tab.NONE) {
    return false;
  }
  if (tab === selected) {
    return false;
  }
  return true;
}

function barHidden(selected: Tab): Boolean {
  if (selected === Tab.NONE) {
    return false;
  }
  return true;
}

function paneText(tab: Tab, fallback: String, populated: Int, data: String): String {
  if (populated === 0) {
    return fallback;
  }
  return populatedField(data, tab);
}

function paneScroll(text: String, paneW: Int, wellH: Int, populated: Int): Int {
  if (populated === 0) {
    return 0;
  }
  const h: Int = textLineCount(text, paneW - Layout.body.inset, DreamMonsterFonts.BODY) * 12;
  if (h > wellH) {
    return h;
  }
  return 0;
}

export function DreamMonsterPanes({ well }: { well: Ref }): Component {
  const [selected] = useState(dreamMonsterTab);
  const [populated] = useState(dreamMonsterPopulated);
  const [data] = useState(dreamMonsterData);

  return (
    <layer w="fill" h="fill">
      {Panes.map((pane) => (
        <layer
          x={0}
          y={0}
          w="fill"
          h="fill"
          hide={paneHidden(pane.tab, selected)}
          scrollHeight={paneScroll(paneText(pane.tab, pane.text, populated, data), well.width, well.height, populated)}
        >
          <text
            x={Layout.body.x}
            y={Layout.body.y}
            w={{ fill: Layout.body.inset }}
            h={{ fill: Layout.body.inset }}
            text={paneText(pane.tab, pane.text, populated, data)}
            font={DreamMonsterFonts.BODY}
            color={DreamMonsterColor.BODY}
            shadow
            lineHeight={Layout.body.LINE}
            align="left"
            valign="top"
          />
        </layer>
      ))}

      <layer x="right" y={0} w={Layout.BAR_W} h="fill" hide={barHidden(selected)} />
    </layer>
  );
}
