import { CS2, useState } from 'ts2';
import { optionAudioOverride } from '../lib/game/varcs';
import { playSound } from '../lib/lib.engine';
import {
  IntroGameOption,
  IntroSounds,
  IntroVolume,
  MusicVolumeCurve,
  introMuted,
  introReframed,
} from './league-3-intro-cutscene.constants';

export function leagueIntroMute(muted: Int): void {
  const [, setMuted] = useState(introMuted);
  if (muted === 0) {
    CS2.game_option_set(IntroGameOption.MIDI_VOLUME, MusicVolumeCurve.at(IntroVolume.PLAYING));
    setMuted(0);
  } else {
    CS2.game_option_set(IntroGameOption.MIDI_VOLUME, MusicVolumeCurve.at(IntroVolume.MUTED));
    setMuted(1);
  }
}

export function leagueIntroMuteOp(muted: Int): void {
  playSound(IntroSounds.SELECT);
  leagueIntroMute(muted);
}

export function leagueIntroMusicRadio(): void {
  const [, setOverride] = useState(optionAudioOverride);
  setOverride(1);
  leagueIntroMute(0);
}

export function leagueIntroReframe(): void {
  const [, setReframed] = useState(introReframed);
  setReframed(1);
}
