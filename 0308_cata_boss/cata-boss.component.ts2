import { createRef, useState } from 'ts2';

import { Anchor, overlayInit } from '../lib/lib.overlay';
import {
  CataBossDodge,
  CataBossModel,
  CataBossSprite,
  Layout,
  altarEastDark,
  altarNorthDark,
  altarSouthDark,
  altarWestDark,
} from './cata-boss.constants';

const timerHost = createRef('0308_cata_boss_timer_host');

const cataAltars = createRef('cata_boss_cata_altars');

export function CataBoss_(): Component {
  return (
    <layer w="fill" h="fill">
      <layer
        w="fill"
        h="fill"
        ref={timerHost}
        onLoad={() => overlayInit(timerHost, cataAltars, CataBossDodge.FLAGS, Anchor.LEFT, Anchor.TOP, 1)}
      >
        <layer ref={cataAltars} x={0} y={0} w={Layout.PLATE_W} h={Layout.PLATE_H}>
          <sprite
            x="center"
            y="center"
            w={Layout.ORB_W}
            h={Layout.ORB_H}
            sprite={CataBossSprite.ORB}
            outline={Layout.ORB_OUTLINE}
          />

          <model
            x={Layout.MODEL_X}
            y={Layout.MODEL_Y}
            w={Layout.MODEL_BOX}
            h={Layout.MODEL_BOX}
            model={CataBossModel.ALTAR}
            zoom={Layout.MODEL_ZOOM}
            pitch={Layout.MODEL_PITCH}
            yaw={Layout.MODEL_YAW}
            offsetY={Layout.MODEL_OFFSET_Y}
          />

          <AltarMarkers />
        </layer>
      </layer>
    </layer>
  );
}

function AltarMarkers(): Component {
  const [westDark] = useState(altarWestDark);
  const [eastDark] = useState(altarEastDark);
  const [southDark] = useState(altarSouthDark);
  const [northDark] = useState(altarNorthDark);

  return (
    <>
      <sprite
        x={Layout.MARKER_SIDE_INSET}
        y="center"
        w={Layout.MARKER_BOX}
        h={Layout.MARKER_BOX}
        sprite={westDark === 1 ? CataBossSprite.MARKER_OFF : CataBossSprite.MARKER}
      />

      <sprite
        x={{ right: Layout.MARKER_SIDE_INSET }}
        y="center"
        w={Layout.MARKER_BOX}
        h={Layout.MARKER_BOX}
        sprite={eastDark === 1 ? CataBossSprite.MARKER_OFF : CataBossSprite.MARKER}
      />

      <sprite
        x="center"
        y={{ bottom: Layout.MARKER_END_INSET }}
        w={Layout.MARKER_BOX}
        h={Layout.MARKER_BOX}
        sprite={southDark === 1 ? CataBossSprite.MARKER_OFF : CataBossSprite.MARKER}
      />

      <sprite
        x="center"
        y={Layout.MARKER_END_INSET}
        w={Layout.MARKER_BOX}
        h={Layout.MARKER_BOX}
        sprite={northDark === 1 ? CataBossSprite.MARKER_OFF : CataBossSprite.MARKER}
      />
    </>
  );
}

export function cataAltarUpdate(west: Boolean, east: Boolean, south: Boolean, north: Boolean): void {
  const [, setWest] = useState(altarWestDark);
  const [, setEast] = useState(altarEastDark);
  const [, setSouth] = useState(altarSouthDark);
  const [, setNorth] = useState(altarNorthDark);
  setWest(west ? 0 : 1);
  setEast(east ? 0 : 1);
  setSouth(south ? 0 : 1);
  setNorth(north ? 0 : 1);
}
