const poison0Ref = createRef();
const poisonCount0Ref = createRef();
const explosive0Ref = createRef();
const explosiveCount0Ref = createRef();
const stun0Ref = createRef();
const stunCount0Ref = createRef();
const poison1Ref = createRef();
const poisonCount1Ref = createRef();
const explosive1Ref = createRef();
const explosiveCount1Ref = createRef();
const stun1Ref = createRef();
const stunCount1Ref = createRef();
const poison2Ref = createRef();
const poisonCount2Ref = createRef();
const explosive2Ref = createRef();
const explosiveCount2Ref = createRef();
const stun2Ref = createRef();
const stunCount2Ref = createRef();
const poison3Ref = createRef();
const poisonCount3Ref = createRef();
const explosive3Ref = createRef();
const explosiveCount3Ref = createRef();
const stun3Ref = createRef();
const stunCount3Ref = createRef();
const emptyRef = createRef();
const buttonsRef = createRef();
const omegaEggRef = createRef();
const omegaCountRef = createRef();

export function barbassaultTurretData(poison: Int, explosive: Int, stun: Int, queen: Int, role: Int): void {
  const omega: Int = role !== 10 ? 0 : queen;
  if (poison <= 0 && explosive <= 0 && stun <= 0 && omega <= 0) {
    emptyRef.hide = false;
    buttonsRef.hide = true;
    return;
  }
  emptyRef.hide = true;
  buttonsRef.hide = false;
  const poisonModel: Model = poison > 0 ? TurretModel.POISON : TurretModel.EMPTY;
  const explosiveModel: Model = explosive > 0 ? TurretModel.EXPLOSIVE : TurretModel.EMPTY;
  const stunModel: Model = stun > 0 ? TurretModel.STUN : TurretModel.EMPTY;
  const poisonText: String = `${poison}`;
  const explosiveText: String = `${explosive}`;
  const stunText: String = `${stun}`;
  poison0Ref.model = poisonModel;
  explosive0Ref.model = explosiveModel;
  stun0Ref.model = stunModel;
  poisonCount0Ref.text = poisonText;
  explosiveCount0Ref.text = explosiveText;
  stunCount0Ref.text = stunText;
  poison1Ref.model = poisonModel;
  explosive1Ref.model = explosiveModel;
  stun1Ref.model = stunModel;
  poisonCount1Ref.text = poisonText;
  explosiveCount1Ref.text = explosiveText;
  stunCount1Ref.text = stunText;
  poison2Ref.model = poisonModel;
  explosive2Ref.model = explosiveModel;
  stun2Ref.model = stunModel;
  poisonCount2Ref.text = poisonText;
  explosiveCount2Ref.text = explosiveText;
  stunCount2Ref.text = stunText;
  poison3Ref.model = poisonModel;
  explosive3Ref.model = explosiveModel;
  stun3Ref.model = stunModel;
  poisonCount3Ref.text = poisonText;
  explosiveCount3Ref.text = explosiveText;
  stunCount3Ref.text = stunText;
  omegaEggRef.model = omega > 0 ? TurretModel.OMEGA : TurretModel.EMPTY;
  omegaCountRef.text = `${omega}`;
}
