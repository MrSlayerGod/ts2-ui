            color={TurretColor.REST}
            shadow
            align="center"
            valign="middle"
          />
          <model
            ref={explosive1Ref}
            x={Columns[1].explosiveX}
            y={Columns[1].explosiveY}
            w={Layout.MODEL_BOX}
            h={Layout.MODEL_BOX}
            model={TurretModel.EXPLOSIVE}
            zoom={Layout.EGG_ZOOM}
          />
          <text
            ref={explosiveCount1Ref}
            x={Columns[1].explosiveCountX}
            y={Columns[1].explosiveCountY}
            w={Layout.count.W}
            h={Layout.count.H}
            font={TurretFont.BUTTON}
            color={TurretColor.REST}
            shadow
            align="center"
            valign="middle"
          />
          <model
            ref={stun1Ref}
            x={Columns[1].stunX}
            y={Columns[1].stunY}
            w={Layout.MODEL_BOX}
            h={Layout.MODEL_BOX}
            model={TurretModel.STUN}
            zoom={Layout.EGG_ZOOM}
          />
          <text
            ref={stunCount1Ref}
            x={Columns[1].stunCountX}
            y={Columns[1].stunCountY}
            w={Layout.count.W}
            h={Layout.count.H}
            font={TurretFont.BUTTON}
            color={TurretColor.REST}
