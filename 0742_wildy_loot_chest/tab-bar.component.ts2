import { CS2, onMounted, useInventory, useServerState, useState, useWatch } from 'ts2';

import {
  LootColors,
  LootFonts,
  LootInventories,
  LootItems,
  LootLayout,
  LootSprites,
  LootText,
  LootVarbits,
  Tabs,
} from './wildy-loot-chest.constants';
import { LootKeyItems } from './loot-key-items.data';
import {
  captionLength,
  captionStart,
  clearTabCaptions,
  selectTab,
  tabCaptionLen0,
  tabCaptionLen1,
  tabCaptionLen2,
  tabCaptionLen3,
  tabCaptionLen4,
  tabCaptions,
} from './wildy-loot-chest.state';

export function TabBar(): Component {
  const tab: Int = useServerState(LootVarbits.TAB);
  const carried = useInventory(LootInventories.CARRIED);
  const [captions] = useState(tabCaptions);
  const [l0] = useState(tabCaptionLen0);
  const [l1] = useState(tabCaptionLen1);
  const [l2] = useState(tabCaptionLen2);
  const [l3] = useState(tabCaptionLen3);
  const [l4] = useState(tabCaptionLen4);
  onMounted(() => clearTabCaptions());

  return (
    <layer w="fill" h="fill">
      {Tabs.map((index) => (
        <TabPlate
          index={index}
          selected={tab === index ? 1 : 0}
          held={carried.total(LootKeyItems.at(index) ?? -1)}
          current={tab}
        />
      ))}

      {Tabs.map((index) =>
        (carried.total(LootKeyItems.at(index) ?? -1) > 0 ? (
          <sprite
            x={index * LootLayout.TAB_PITCH + LootLayout.TAB_ICON_X}
            y={LootLayout.TAB_ICON_Y}
            w={LootLayout.TAB_ICON_W}
            h={LootLayout.TAB_ICON_H}
            item={LootItems.KEY0}
            itemCount={1}
            itemCountMode="never"
            outline={LootLayout.CELL_OUTLINE}
            shadowColor={LootLayout.CELL_SHADOW}
          />
        ) : null),
      )}

      {Tabs.map((index) => (
        <text
          text={CS2.substring(
            captions,
            captionStart(index, l0, l1, l2, l3),
            captionStart(index, l0, l1, l2, l3) + captionLength(index, l0, l1, l2, l3, l4),
          )}
          x={index * LootLayout.TAB_PITCH}
          y={0}
          w={LootLayout.TAB_LABEL_W}
          h={LootLayout.TAB_LABEL_H}
          font={LootFonts.SMALL}
          color={LootColors.LABEL_HOVER}
          shadow
          align="center"
          valign="bottom"
        />
      ))}
    </layer>
  );
}

function TabPlate({
  index,
  selected,
  held,
  current,
}: {
  index: Int;
  selected: Int;
  held: Int;
  current: Int;
}): Component {
  const [hot, setHot] = useState(0);
  const x: Int = index * LootLayout.TAB_PITCH;
  useWatch(
    [LootInventories.TIER0, LootInventories.TIER1, LootInventories.TIER2, LootInventories.TIER3, LootInventories.TIER4],
    () => {
      setHot(0);
    },
  );
  const live: Int = selected === 0 && held > 0 ? 1 : 0;

  return (
    <sprite
      x={x}
      y={0}
      w={LootLayout.TAB_W}
      h={LootLayout.TAB_H}
      sprite={
        selected === 1
          ? LootSprites.TAB_SELECTED
          : held <= 0
            ? LootSprites.TAB_EMPTY
            : hot === 1
              ? LootSprites.TAB_HOVER
              : LootSprites.TAB_REST
      }
      tiling={false}
      options={[live === 1 || selected === 1 ? LootText.VIEW_TAB : LootText.NO_OP]}
      optionSubject={CS2.tostring(index)}
      onMouseRepeat={
        live === 1
          ? () => {
              setHot(1);
            }
          : null
      }
      onMouseLeave={() => {
        setHot(0);
      }}
      onOptionSelect={
        live === 1
          ? () => {
              setHot(0);
              selectTab(index, current);
            }
          : null
      }
    />
  );
}
