import { createRef, onMounted, onUpdated, useInterval, useState } from 'ts2';

import { clientClock } from '../lib/lib.engine';
import { Anchor, overlayInit } from '../lib/lib.overlay';
import {
  Clock,
  CLOCK_CACHE_TEXT,
  Layout,
  UpassBattleColor,
  UpassBattleDodge,
  UpassBattleFont,
} from './sote-upass-battle.constants';
import { upassBarrier, upassClockLabel, upassDeadline } from './sote-upass-battle.state';

const timerHost = createRef('0636_sote_upass_battle_timer_host');

const content = createRef('sote_upass_battle_content');

const healthBackground = createRef('sote_upass_battle_health_background');
const healthForeground = createRef('sote_upass_battle_health_foreground');
const timerText = createRef('sote_upass_battle_timer_text');

export function SoteUpassBattle_(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill">
      <layer
        w="fill"
        h="fill"
        ref={timerHost}
        onLoad={() => overlayInit(timerHost, content, UpassBattleDodge.FLAGS, Anchor.LEFT, Anchor.TOP, 1)}
      >
        <layer ref={content} x={0} y={0} w={Layout.PLATE_W} h={Layout.PLATE_H}>
          <layer x="center" y={Layout.BAR_Y} w={{ fill: Layout.BAR_INSET }} h={Layout.BAR_H}>
            <rect
              static
              ref={healthBackground}
              x={{ right: Layout.BAR_X }}
              y={Layout.BAR_TOP}
              w={Layout.BAR_W}
              h={Layout.BAR_ROW_H}
              color={UpassBattleColor.DAMAGE}
              fill
            />

            <rect
              static
              ref={healthForeground}
              x={Layout.BAR_X}
              y={Layout.BAR_TOP}
              w={Layout.BAR_W}
              h={Layout.BAR_ROW_H}
              color={UpassBattleColor.BARRIER}
              fill
            />

            <rect
              x={Layout.OUTLINE_X}
              y={Layout.OUTLINE_Y}
              w={Layout.OUTLINE_W}
              h={Layout.OUTLINE_H}
              color={UpassBattleColor.OUTLINE}
            />

            <text
              x={Layout.BAR_X}
              y={Layout.BAR_TOP}
              w={Layout.BAR_W}
              h={Layout.BAR_ROW_H}
              font={UpassBattleFont.LABEL}
              text="Barrier Strength"
              align="center"
              valign="middle"
              color={UpassBattleColor.OUTLINE}
            />
          </layer>

          <layer x="center" y={{ bottom: Layout.CLOCK_BOTTOM }} w={{ fill: Layout.BAR_INSET }} h={Layout.CLOCK_STRIP_H}>
            <text
              static
              ref={timerText}
              x={Layout.CLOCK_X}
              y={Layout.CLOCK_Y}
              w={Layout.CLOCK_W}
              h={Layout.CLOCK_H}
              font={UpassBattleFont.LABEL}
              text="Time Left: 4:00"
              valign="middle"
              shadow
              color={UpassBattleColor.CLOCK}
            />
          </layer>
        </layer>
      </layer>

      <UpassBattleState />
    </layer>
  );
}

function UpassBattleState(): Component {
  const [barrier] = useState(upassBarrier);
  const [deadline, setDeadline] = useState(upassDeadline);
  const [seconds, setSeconds] = useState(-1);

  useInterval(() => {
    if (deadline > 0) {
      const left: Int = deadline - clientClock();
      if (left <= 0) {
        setDeadline(0);
      } else {
        setSeconds(left / Clock.CYCLES_PER_SECOND);
      }
    }
  });

  const green: Int = barrier;
  let text: String = CLOCK_CACHE_TEXT;
  if (seconds >= 0) {
    text = upassClockLabel(seconds);
  }

  onMounted(() => paintBattle(green, text));
  onUpdated(() => paintBattle(green, text));

  return <layer x={0} y={0} w={0} h={0} />;
}

function paintBattle(barrier: Int, text: String): void {
  healthForeground.props = { w: barrier, h: Layout.BAR_ROW_H };
  healthBackground.props = { w: Layout.BAR_W - barrier, h: Layout.BAR_ROW_H };
  timerText.props = { text: text };
}
