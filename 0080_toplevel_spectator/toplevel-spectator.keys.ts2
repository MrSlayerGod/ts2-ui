import { CS2, useServerState, useState } from 'ts2';
import { crmOverlayDismiss } from '../0065_crm_surprisepopup_side/crm-overlay-dismiss';
import { keybindPanel } from '../0161_toplevel_osrs_stretch/toplevel-osrs-stretch.keys';
import { chatmodalRef } from '../0162_chatbox/chatbox.constants';
import { deadmanWorld } from '../0226_deadmanprotect/deadman-world.helpers';
import { Panel } from '../0548_toplevel/toplevel.constants';
import { switchSidePanel } from '../0548_toplevel/toplevel.helpers';
import { Varbits } from '../lib/game/varbits';
import { crmOverlayActive, meslayermode } from '../lib/game/varcs';
import { dialogueMayAdvance } from '../lib/lib.dialogue';
import {
  deadman1v1Tele,
  deadmanAreaSwitch,
  deadmanArenasTele,
  deadmanChestTele,
  deadmanFinalArea1Tele,
  deadmanFinalArea2Tele,
  deadmanFreecamEnable,
  deadmanLobbyTele,
  deadmanMapEnable,
  deadmanOverlayHide,
  freecamFaster,
  freecamSlower,
} from './deadman-keys';
import {
  controlRef,
  floaterRef,
  mainmodalRef,
  side0Ref,
  side10Ref,
  side11Ref,
  side12Ref,
  side13Ref,
  side1Ref,
  side2Ref,
  side3Ref,
  side4Ref,
  side5Ref,
  side6Ref,
  side7Ref,
  side8Ref,
  side9Ref,
  sidemodalRef,
} from './toplevel-spectator.constants';
import { spectatorToplevelInit } from './toplevel-spectator.helpers';
import { rendererNoticeBuild } from '../lib/enhanced/renderer-notice.component';

export function spectatorFrameKeypress(key: Int): void {
  if (useServerState(Varbits.SPECTATOR_TOPLEVEL_ENABLED) === 1) {
    spectatorKeypress(key);
    return;
  }
  spectatorToplevelKeypress(key);
}

export function spectatorKeypress(key: Int): void {
  if (key === Keys.F12) {
    CS2.cheat_do('~dmm_disablespectator_request');
    return;
  }
  if (key === Keys.PAGE_UP) {
    freecamFaster();
    return;
  }
  if (key === Keys.PAGE_DOWN) {
    freecamSlower();
    return;
  }
  if (key < Keys.F1 || key > Keys.F10) {
    return;
  }
  if (deadmanWorld() === 0) {
    return;
  }
  if (key === Keys.F1) {
    deadmanFreecamEnable();
  } else if (key === Keys.F2) {
    deadmanOverlayHide();
  } else if (key === Keys.F3) {
    deadmanMapEnable();
  } else if (key === Keys.F4) {
    deadmanAreaSwitch();
  } else if (key === Keys.F5) {
    deadmanFinalArea1Tele();
  } else if (key === Keys.F6) {
    deadmanFinalArea2Tele();
  } else if (key === Keys.F7) {
    deadmanArenasTele();
  } else if (key === Keys.F8) {
    deadman1v1Tele();
  } else if (key === Keys.F9) {
    deadmanChestTele();
  } else {
    deadmanLobbyTele();
  }
}

function spectatorToplevelKeypress(key: Int): void {
  if (dialogueMayAdvance(-1, -1) === false) {
    return;
  }
  if (key === Keys.ESCAPE) {
    const [mode] = useState(meslayermode);
    if (mode === 14 || mode === 17 || mode === 18 || mode === 11) {
      return;
    }
    if (useServerState(Varbits.KEYBINDING_ESC_TO_CLOSE) === 1) {
      const dismissed: Boolean = crmOverlayDismiss();
      if (CS2.if_sub_has(floaterRef)) {
        return;
      }
      if (spectatorMountOpen(Panel.INVENTORY) && CS2.if_sub_has(mainmodalRef)) {
        CS2.if_close();
        return;
      }
      if (spectatorMountOpen(Panel.INVENTORY) && CS2.if_sub_has(sidemodalRef)) {
        CS2.if_close();
        return;
      } else if (CS2.if_sub_has(chatmodalRef)) {
        CS2.if_close();
        return;
      } else if (dismissed) {
        return;
      }
    }
  }
  const panel: Int = keybindPanel(key);
  if (panel === -1 || panel === useServerState(Varbits.FLASHSIDE) - 1) {
    return;
  }
  if (spectatorMountOpen(panel)) {
    const [active] = useState(crmOverlayActive);
    if (CS2.testbit(active, 1)) {
      crmOverlayDismiss();
    }
    switchSidePanel(panel, 0, false);
  }
}

const SpectatorSideSlots = listOf<ComponentId>([
  side0Ref,
  side1Ref,
  side2Ref,
  side3Ref,
  side4Ref,
  side5Ref,
  side6Ref,
  side7Ref,
  side8Ref,
  side9Ref,
  side10Ref,
  side11Ref,
  side12Ref,
  side13Ref,
]);

function spectatorMountOpen(panel: Int): Boolean {
  const slot: ComponentId = SpectatorSideSlots.at(panel) ?? -1;
  if (slot !== -1 && CS2.if_sub_has(slot)) {
    return true;
  }
  return false;
}

enum Keys {
  F1 = 1,
  F2 = 2,
  F3 = 3,
  F4 = 4,
  F5 = 5,
  F6 = 6,
  F7 = 7,
  F8 = 8,
  F9 = 9,
  F10 = 10,
  F12 = 12,
  ESCAPE = 13,
  PAGE_UP = 104,
  PAGE_DOWN = 105,
}

export function spectatorToplevelLoad(): void {
  spectatorToplevelInit();
  controlRef.onKey = (event) => spectatorFrameKeypress(event.keyCode);
  rendererNoticeBuild();
}
