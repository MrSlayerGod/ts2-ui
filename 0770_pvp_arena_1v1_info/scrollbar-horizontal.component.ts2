import { CS2, useRef, useState } from 'ts2';

import { Layout } from './pvp-arena-1v1-info.constants';

export function ScrollbarHorizontal({
  content,
  track,
  capLeftSprite,
  thumbSprite,
  capRightSprite,
  arrowLeft,
  arrowRight,
  rebuilt = false,
}: {
  content: Ref;
  track: Sprite;
  capLeftSprite: Sprite;
  thumbSprite: Sprite;
  capRightSprite: Sprite;
  arrowLeft: Sprite;
  arrowRight: Sprite;
  rebuilt?: Boolean;
}): Component {
  const bar = useRef();
  const gutter = useRef();
  const thumb = useRef();

  const [scrolled, setScrolled] = useState(-1);
  const [draggedTo, setDraggedTo] = useState(-1);

  const scrollExtent: Int = content.scrollWidth;
  const extent: Int = scrollExtent > 0 ? scrollExtent : content.width;
  const range: Int = Math.max(1, content.scrollWidth - content.width);
  const offset: Int = scrolled >= 0 ? scrolled : content.scrollX;

  return (
    <layer ref={bar} w="fill" h="fill">
      <sprite
        ref={gutter}
        x="center"
        w={{ fill: Layout.ARROW * 2 }}
        h="fill"
        sprite={track}
        noClickThrough
        onScrollWheel={(event) => {
          const next: Int = Math.clamp(0, liveRange(content), content.scrollX + event.mouseY * Layout.WHEEL_X);
          content.scrollX = next;
          setScrolled(next);
        }}
        onClick={() => {
          CS2.cc_dragpickup(thumb.width / 2, 0);
        }}
      />
      <sprite
        ref={thumb}
        x={thumbAt(draggedTo, gutter.width, thumbWidthOf(bar.width, content.width, extent, rebuilt), offset, range)}
        y="center"
        h="fill"
        w={thumbWidthOf(bar.width, content.width, extent, rebuilt)}
        sprite={thumbSprite}
        noClickThrough
        draggable={gutter}
        dragMoves
        onDrag={(event) => {
          const travel: Int = Math.max(1, gutter.width - thumb.width);
          const next: Int = Math.clamp(
            0,
            liveRange(content),
            event.mouseX * (content.scrollWidth - content.width) / travel,
          );
          content.scrollX = next;
          setScrolled(next);
          setDraggedTo(event.mouseX);
        }}
        onDragComplete={(event) => {
          const travel: Int = Math.max(1, gutter.width - thumb.width);
          const next: Int = Math.clamp(
            0,
            liveRange(content),
            event.mouseX * (content.scrollWidth - content.width) / travel,
          );
          content.scrollX = next;
          setScrolled(next);
          setDraggedTo(-1);
        }}
      />
      <sprite
        x={thumbAt(draggedTo, gutter.width, thumbWidthOf(bar.width, content.width, extent, rebuilt), offset, range)}
        y="center"
        w={Layout.CAP}
        h="fill"
        sprite={capLeftSprite}
      />
      <sprite
        x={
          thumbAt(draggedTo, gutter.width, thumbWidthOf(bar.width, content.width, extent, rebuilt), offset, range) +
          thumbWidthOf(bar.width, content.width, extent, rebuilt) -
          Layout.CAP
        }
        y="center"
        w={Layout.CAP}
        h="fill"
        sprite={capRightSprite}
      />
      <sprite
        x="left"
        y="center"
        w={Layout.ARROW}
        h="fill"
        sprite={arrowLeft}
        noClickThrough
        onHold={() => {
          const next: Int = Math.clamp(0, liveRange(content), content.scrollX - Layout.STEP_X);
          content.scrollX = next;
          setScrolled(next);
        }}
      />
      <sprite
        x="right"
        y="center"
        w={Layout.ARROW}
        h="fill"
        sprite={arrowRight}
        noClickThrough
        onHold={() => {
          const next: Int = Math.clamp(0, liveRange(content), content.scrollX + Layout.STEP_X);
          content.scrollX = next;
          setScrolled(next);
        }}
      />
    </layer>
  );
}

function thumbWidthOf(barWidth: Int, contentWidth: Int, extent: Int, rebuilt: Boolean): Int {
  const raw: Int = Math.max(
    Layout.MIN_THUMB,
    extent > 0 ? (barWidth - Layout.ARROW * 2) * contentWidth / extent : barWidth - Layout.ARROW * 2,
  );
  if (rebuilt) {
    return Math.min(Math.max(Layout.MIN_THUMB, barWidth - Layout.ARROW * 2), raw);
  }
  return raw;
}

function thumbAt(draggedTo: Int, gutterWidth: Int, thumbWidth: Int, offset: Int, range: Int): Int {
  if (draggedTo >= 0) {
    return draggedTo + Layout.ARROW;
  }
  return Layout.ARROW + (gutterWidth - thumbWidth) * offset / range;
}

function liveRange(content: Ref): Int {
  return Math.max(1, content.scrollWidth - content.width);
}
