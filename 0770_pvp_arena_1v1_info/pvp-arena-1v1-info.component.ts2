                cy={cellY(rounds, 1, 0)}
                hidden={hiddenRound(rounds, 1)}
              />
            </layer>
          </layer>

          <layer right={Layout.pane.x} y={Layout.pane.y} w={Layout.barW} h={{ fill: Layout.pane.insetH }}>
            <ScrollbarVertical
              content={scrolling}
              track={InfoScrollbarV.TRACK}
              capTopSprite={InfoScrollbarV.CAP_TOP}
              thumbSprite={InfoScrollbarV.THUMB}
              capBottomSprite={InfoScrollbarV.CAP_BOTTOM}
              arrowUp={InfoScrollbarV.ARROW_UP}
              arrowDown={InfoScrollbarV.ARROW_DOWN}
              rebuilt
            />
          </layer>
          <layer x={Layout.pane.x} y={{ bottom: Layout.pane.y }} w={{ fill: Layout.pane.insetW }} h={Layout.barW}>
            <ScrollbarHorizontal
              content={scrolling}
              track={InfoScrollbarH.TRACK}
              capLeftSprite={InfoScrollbarH.CAP_LEFT}
              thumbSprite={InfoScrollbarH.THUMB}
              capRightSprite={InfoScrollbarH.CAP_RIGHT}
              arrowLeft={InfoScrollbarH.ARROW_LEFT}
              arrowRight={InfoScrollbarH.ARROW_RIGHT}
              rebuilt
            />
          </layer>
          <rect
            right={Layout.pane.x}
            y={{ bottom: Layout.pane.y }}
            w={Layout.corner.size}
            h={Layout.corner.size}
            fill
            color={InfoColor.CORNER}
            transparency={Layout.corner.transparency}
          />
          <ThinStoneBoxEntrypoint />
        </layer>

        <layer
          x="center"
          y={{ bottom: Layout.statusBox.bottom }}
          w={{ fill: Layout.statusBox.insetW }}
          h={Layout.statusBox.h}
        >
          <sprite
            x="center"
            y="center"
            w={{ fill: Layout.statusBackingInset }}
            h={{ fill: Layout.statusBackingInset }}
            sprite={InfoSprites.STATUS_BACKING}
            tiling
          />
          <DetailsLine />
          <ThinStoneBoxEntrypoint />
        </layer>
      </layer>

      <layer ref={preview} hide={dragging < 0} x={previewX} y={previewY} w={previewW} h={previewH}>
        <rect x="center" y="center" w="fill" h="fill" color={InfoColor.PREVIEW} transparency={100} />
        <rect x="center" y="center" w={{ fill: 2 }} h={{ fill: 2 }} color={InfoColor.PREVIEW} transparency={110} />
        <rect x="center" y="center" w={{ fill: 4 }} h={{ fill: 4 }} color={InfoColor.PREVIEW} transparency={120} />
        <rect x="center" y="center" w={{ fill: 6 }} h={{ fill: 6 }} color={InfoColor.PREVIEW} transparency={130} />
      </layer>

      {Handles.map((i) => (
        <sprite
          x={handleX(i, x, w)}
          y={handleY(i, y, h)}
          w={handleW(i, w)}
          h={handleH(i, h)}
          sprite={dragging === i ? -1 : InfoSprites.HANDLE}
          tiling
          transparency={Layout.handle.TRANSPARENT}
          draggable={dodger}
          dragDeadZone={Layout.handle.DEAD_ZONE}
          dragDeadTime={Layout.handle.DEAD_TIME}
          onMouseRepeat={(event) => ccSetTrans(event.self, Layout.handle.HOVER)}
          onMouseLeave={(event) => ccSetTrans(event.self, Layout.handle.TRANSPARENT)}
          onDrag={(event) => {
            setPreviewX(dragBox(0, i, event.mouseX, event.mouseY, top, availW, dodgerH));
            setPreviewY(dragBox(1, i, event.mouseX, event.mouseY, top, availW, dodgerH));
            setPreviewW(dragBox(2, i, event.mouseX, event.mouseY, top, availW, dodgerH));
            setPreviewH(dragBox(3, i, event.mouseX, event.mouseY, top, availW, dodgerH));
            setDragging(i);
            setCommitAt(clientClock() + Layout.COMMIT_CYCLES);
          }}
        />
      ))}
    </layer>
