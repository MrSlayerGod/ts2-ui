                cx={cellX(pitch, 6, 17)}
                cy={cellY(rounds, 6, 17)}
                hidden={hiddenRound(rounds, 6)}
              />
              <BracketCell
                round={6}
                slot={18}
                cx={cellX(pitch, 6, 18)}
                cy={cellY(rounds, 6, 18)}
                hidden={hiddenRound(rounds, 6)}
              />
              <BracketCell
                round={6}
                slot={19}
                cx={cellX(pitch, 6, 19)}
                cy={cellY(rounds, 6, 19)}
                hidden={hiddenRound(rounds, 6)}
              />
              <BracketCell
                round={6}
                slot={20}
                cx={cellX(pitch, 6, 20)}
                cy={cellY(rounds, 6, 20)}
                hidden={hiddenRound(rounds, 6)}
              />
              <BracketCell
                round={6}
                slot={21}
                cx={cellX(pitch, 6, 21)}
                cy={cellY(rounds, 6, 21)}
                hidden={hiddenRound(rounds, 6)}
              />
              <BracketCell
                round={6}
                slot={22}
                cx={cellX(pitch, 6, 22)}
                cy={cellY(rounds, 6, 22)}
                hidden={hiddenRound(rounds, 6)}
              />
              <BracketCell
                round={6}
                slot={23}
                cx={cellX(pitch, 6, 23)}
                cy={cellY(rounds, 6, 23)}
                hidden={hiddenRound(rounds, 6)}
              />
              <BracketCell
                round={6}
                slot={24}
                cx={cellX(pitch, 6, 24)}
                cy={cellY(rounds, 6, 24)}
                hidden={hiddenRound(rounds, 6)}
              />
              <BracketCell
                round={6}
                slot={25}
                cx={cellX(pitch, 6, 25)}
                cy={cellY(rounds, 6, 25)}
                hidden={hiddenRound(rounds, 6)}
              />
              <BracketCell
                round={6}
                slot={26}
                cx={cellX(pitch, 6, 26)}
                cy={cellY(rounds, 6, 26)}
                hidden={hiddenRound(rounds, 6)}
              />
              <BracketCell
                round={6}
                slot={27}
                cx={cellX(pitch, 6, 27)}
                cy={cellY(rounds, 6, 27)}
                hidden={hiddenRound(rounds, 6)}
              />
              <BracketCell
                round={6}
                slot={28}
                cx={cellX(pitch, 6, 28)}
                cy={cellY(rounds, 6, 28)}
                hidden={hiddenRound(rounds, 6)}
              />
              <BracketCell
                round={6}
                slot={29}
                cx={cellX(pitch, 6, 29)}
                cy={cellY(rounds, 6, 29)}
                hidden={hiddenRound(rounds, 6)}
              />
              <BracketCell
                round={6}
                slot={30}
                cx={cellX(pitch, 6, 30)}
                cy={cellY(rounds, 6, 30)}
                hidden={hiddenRound(rounds, 6)}
              />
              <BracketCell
                round={6}
                slot={31}
                cx={cellX(pitch, 6, 31)}
                cy={cellY(rounds, 6, 31)}
                hidden={hiddenRound(rounds, 6)}
              />
              <BracketCell
                round={5}
                slot={0}
                cx={cellX(pitch, 5, 0)}
                cy={cellY(rounds, 5, 0)}
                hidden={hiddenRound(rounds, 5)}
              />
              <BracketCell
                round={5}
                slot={1}
                cx={cellX(pitch, 5, 1)}
                cy={cellY(rounds, 5, 1)}
                hidden={hiddenRound(rounds, 5)}
              />
              <BracketCell
                round={5}
                slot={2}
                cx={cellX(pitch, 5, 2)}
                cy={cellY(rounds, 5, 2)}
                hidden={hiddenRound(rounds, 5)}
              />
              <BracketCell
                round={5}
                slot={3}
                cx={cellX(pitch, 5, 3)}
                cy={cellY(rounds, 5, 3)}
                hidden={hiddenRound(rounds, 5)}
              />
              <BracketCell
                round={5}
                slot={4}
                cx={cellX(pitch, 5, 4)}
                cy={cellY(rounds, 5, 4)}
                hidden={hiddenRound(rounds, 5)}
              />
              <BracketCell
                round={5}
