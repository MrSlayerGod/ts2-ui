import { useInterval, useOnResize, useRef, useState, useUniverse } from 'ts2';

import { ccSetTrans } from '../0332_thormac/cc-settrans';
import { clientClock } from '../lib/lib.engine';
import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { SteelBorder } from '../lib/steel-border.component';
import { SteelborderColor } from '../lib/lib.constants';
import { ThinStoneBoxEntrypoint } from '../lib/thin-stone-box.component';
import { onMobile } from '../lib/lib.helpers';
import { BracketCell, DetailsLine } from './bracket-cell.component';
import { BracketLines, gapFor } from './bracket-lines.component';
import { InfoCloseButton } from './close-button.component';
import {
  Copy,
  InfoColor,
  InfoFonts,
  InfoScrollbarH,
  InfoScrollbarV,
  InfoSprites,
  Layout,
  infoHeight,
  infoWidth,
  infoX,
  infoY,
} from './pvp-arena-1v1-info.constants';
import {
  dodgerDrop,
  dragBox,
  handleX,
  handleY,
  maxHeight,
  maxWidth,
  panelHeight,
  panelWidth,
  panelX,
  panelY,
  rawHeight,
  rawWidth,
  roundCount,
} from './pvp-arena-1v1-info.layout';
import { ScrollbarHorizontal } from './scrollbar-horizontal.component';

export function PvpArena1v1Info(): Component {
  const dodger = useRef();
  const content = useRef();
  const scrolling = useRef();
  const display = useRef();
  const preview = useRef();

  const [dragging, setDragging] = useState(-1);
  const [previewX, setPreviewX] = useState(0);
  const [previewY, setPreviewY] = useState(0);
  const [previewW, setPreviewW] = useState(0);
  const [previewH, setPreviewH] = useState(0);
  const [commitAt, setCommitAt] = useState(-1);
  const [storedW, setStoredW] = useState(infoWidth);
  const [storedH, setStoredH] = useState(infoHeight);
  const [storedX, setStoredX] = useState(infoX);
  const [storedY, setStoredY] = useState(infoY);
  const [seenW, setSeenW] = useState(Layout.UNSEEN);
  const [seenH, setSeenH] = useState(Layout.UNSEEN);

  const universe = useUniverse();
  useOnResize(universe);

  const mobile = onMobile();
  const top: Int = mobile ? Layout.MOBILE_TOP : 0;
  const drop: Int = mobile ? 0 : dodgerDrop();

  const dodgerH: Int = universe.height - drop;
  const availW: Int = universe.width;
  const availH: Int = dodgerH - top;

  const rounds: Int = roundCount();
  const gap: Int = gapFor(rounds);
  const pitch: Int = Layout.bracket.CELL_W + gap;
  const gridW: Int = maxWidth(rounds) - Layout.bracket.PAD_W;
  const gridH: Int = maxHeight(rounds) - Layout.bracket.PAD_H;

  let nudgeW: Int = 0;
  let nudgeH: Int = 0;
  let nudgeX: Int = 0;
  let nudgeY: Int = 0;
  if (seenW !== Layout.UNSEEN && storedX + storedW >= seenW - Layout.GLUE) {
    if (storedX <= Layout.GLUE) {
      nudgeW = availW - seenW;
    } else {
      nudgeX = availW - seenW;
    }
  }
  if (seenH !== Layout.UNSEEN && storedY + storedH >= seenH - Layout.GLUE) {
    if (storedY <= top + Layout.GLUE) {
      nudgeH = availH - seenH;
    } else {
      nudgeY = availH - seenH;
    }
  }
  setSeenW(availW);
  setSeenH(availH);

  const w: Int = panelWidth(rounds, availW, nudgeW);
  const h: Int = panelHeight(rounds, availH, nudgeH);
  const x: Int = panelX(availW, rawWidth(nudgeW), w, nudgeX);
  const y: Int = panelY(top, dodgerH, availH, rawHeight(nudgeH), h, nudgeY);
  setStoredW(w);
  setStoredH(h);
  setStoredX(x);
  setStoredY(y);

  useInterval(
    commitAt >= 0
      ? () => {
          if (clientClock() >= commitAt) {
            setStoredW(previewW);
            setStoredH(previewH);
            setStoredX(previewX);
            setStoredY(previewY);
            setDragging(-1);
            setCommitAt(-1);
          }
        }
      : undefined,
    dodger,
  );

  return (
    <layer ref={dodger} x="center" y={mobile ? 'center' : 'bottom'} w="fill" h={mobile ? 'fill' : { fill: drop }}>
      <layer ref={content} hide={dragging >= 0} x={x} y={y} w={w} h={h}>
        <SteelBorder title={Copy.TITLE} titleColor={SteelborderColor.TITLE} flags={SteelFlags.INFO} noClickThrough />

        <InfoCloseButton />

        <layer
          x="center"
          y={{ bottom: Layout.scrollBox.y }}
          w={{ fill: Layout.scrollBox.insetW }}
          h={{ fill: Layout.scrollBox.insetH }}
        >
          <layer
            ref={scrolling}
            x={Layout.pane.x}
            y={Layout.pane.y}
            w={{ fill: Layout.pane.insetW }}
            h={{ fill: Layout.pane.insetH }}
            scrollWidth={gridW}
            scrollHeight={gridH}
          >
            <layer
              ref={display}
              x={(Math.max(paneWidth(w), gridW) - gridW) / 2}
              y={(Math.max(paneHeight(h), gridH) - gridH) / 2}
              w={gridW}
              h={gridH}
            >
              <layer x="center" y="center" w="fill" h="fill">
                <BracketLines />
              </layer>

              <BracketCell
                round={6}
                slot={0}
                cx={cellX(pitch, 6, 0)}
                cy={cellY(rounds, 6, 0)}
                hidden={hiddenRound(rounds, 6)}
              />
              <BracketCell
                round={6}
                slot={1}
                cx={cellX(pitch, 6, 1)}
                cy={cellY(rounds, 6, 1)}
                hidden={hiddenRound(rounds, 6)}
              />
              <BracketCell
                round={6}
                slot={2}
                cx={cellX(pitch, 6, 2)}
                cy={cellY(rounds, 6, 2)}
                hidden={hiddenRound(rounds, 6)}
              />
              <BracketCell
                round={6}
                slot={3}
                cx={cellX(pitch, 6, 3)}
                cy={cellY(rounds, 6, 3)}
                hidden={hiddenRound(rounds, 6)}
              />
              <BracketCell
                round={6}
                slot={5}
                cx={cellX(pitch, 6, 5)}
                cy={cellY(rounds, 6, 5)}
                hidden={hiddenRound(rounds, 6)}
              />
              <BracketCell
                round={6}
                slot={4}
                cx={cellX(pitch, 6, 4)}
                cy={cellY(rounds, 6, 4)}
                hidden={hiddenRound(rounds, 6)}
              />
              <BracketCell
                round={6}
                slot={6}
                cx={cellX(pitch, 6, 6)}
                cy={cellY(rounds, 6, 6)}
                hidden={hiddenRound(rounds, 6)}
              />
              <BracketCell
                round={6}
                slot={7}
                cx={cellX(pitch, 6, 7)}
                cy={cellY(rounds, 6, 7)}
                hidden={hiddenRound(rounds, 6)}
              />
              <BracketCell
                round={6}
                slot={8}
                cx={cellX(pitch, 6, 8)}
                cy={cellY(rounds, 6, 8)}
                hidden={hiddenRound(rounds, 6)}
              />
              <BracketCell
                round={6}
                slot={9}
                cx={cellX(pitch, 6, 9)}
                cy={cellY(rounds, 6, 9)}
                hidden={hiddenRound(rounds, 6)}
              />
              <BracketCell
