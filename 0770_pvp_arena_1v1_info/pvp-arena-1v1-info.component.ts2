                cy={cellY(rounds, 6, 12)}
                hidden={hiddenRound(rounds, 6)}
              />
              <BracketCell
                round={6}
                slot={13}
                cx={cellX(pitch, 6, 13)}
                cy={cellY(rounds, 6, 13)}
                hidden={hiddenRound(rounds, 6)}
              />
              <BracketCell
                round={6}
                slot={14}
