                cx={cellX(pitch, 4, 7)}
                cy={cellY(rounds, 4, 7)}
                hidden={hiddenRound(rounds, 4)}
              />
              <BracketCell
                round={3}
                slot={0}
                cx={cellX(pitch, 3, 0)}
                cy={cellY(rounds, 3, 0)}
                hidden={hiddenRound(rounds, 3)}
              />
              <BracketCell
                round={3}
                slot={1}
                cx={cellX(pitch, 3, 1)}
                cy={cellY(rounds, 3, 1)}
                hidden={hiddenRound(rounds, 3)}
              />
              <BracketCell
                round={3}
                slot={2}
                cx={cellX(pitch, 3, 2)}
                cy={cellY(rounds, 3, 2)}
                hidden={hiddenRound(rounds, 3)}
              />
              <BracketCell
                round={3}
                slot={3}
                cx={cellX(pitch, 3, 3)}
                cy={cellY(rounds, 3, 3)}
                hidden={hiddenRound(rounds, 3)}
              />
              <BracketCell
                round={2}
                slot={0}
                cx={cellX(pitch, 2, 0)}
                cy={cellY(rounds, 2, 0)}
                hidden={hiddenRound(rounds, 2)}
              />
              <BracketCell
                round={2}
                slot={1}
                cx={cellX(pitch, 2, 1)}
