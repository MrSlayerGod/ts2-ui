                hidden={hiddenRound(rounds, 4)}
              />
              <BracketCell
                round={4}
                slot={4}
                cx={cellX(pitch, 4, 4)}
                cy={cellY(rounds, 4, 4)}
                hidden={hiddenRound(rounds, 4)}
              />
              <BracketCell
                round={4}
                slot={5}
                cx={cellX(pitch, 4, 5)}
                cy={cellY(rounds, 4, 5)}
                hidden={hiddenRound(rounds, 4)}
              />
              <BracketCell
                round={4}
                slot={6}
