}

enum SteelFlags {
  INFO = 11,
}

const Handles = [0, 1, 2, 3, 4, 5, 6, 7] as const;

function paneWidth(panel: Int): Int {
  return panel - Layout.scrollBox.insetW - Layout.pane.insetW;
}

function paneHeight(panel: Int): Int {
  return panel - Layout.scrollBox.insetH - Layout.pane.insetH;
}

function hiddenRound(rounds: Int, round: Int): Boolean {
  if (round > rounds) {
    return true;
  }
  return false;
}

function cellX(pitch: Int, round: Int, slot: Int): Int {
  if (round === 1) {
    return 0;
  }
  const half: Int = Math.pow(2, round - 2);
  if (slot < half) {
    return 0 - (round - 1) * pitch;
  }
  return (round - 1) * pitch;
}

function cellY(rounds: Int, round: Int, slot: Int): Int {
  if (round === 1) {
    return 0;
  }
  const half: Int = Math.pow(2, round - 2);
  let index: Int = slot;
  if (slot >= half) {
    index = slot - half;
  }
  const span: Int = Math.pow(2, rounds - round) * Layout.bracket.STEP;
  return (1 - half + 2 * index) * span / 2;
}

function handleW(index: Int, w: Int): Int {
  if (index === 0 || index === 1) {
    return w - Layout.handle.EDGE * 2;
  }
  return Layout.handle.EDGE;
}

function handleH(index: Int, h: Int): Int {
  if (index === 0) {
    return Layout.handle.TOP_H;
  }
  if (index === 2 || index === 3) {
    return h - Layout.handle.EDGE * 2;
  }
  return Layout.handle.EDGE;
}
