                cx={cellX(pitch, 5, 5)}
                cy={cellY(rounds, 5, 5)}
                hidden={hiddenRound(rounds, 5)}
              />
              <BracketCell
                round={5}
                slot={6}
                cx={cellX(pitch, 5, 6)}
                cy={cellY(rounds, 5, 6)}
                hidden={hiddenRound(rounds, 5)}
              />
              <BracketCell
                round={5}
                slot={7}
                cx={cellX(pitch, 5, 7)}
                cy={cellY(rounds, 5, 7)}
                hidden={hiddenRound(rounds, 5)}
              />
              <BracketCell
                round={5}
                slot={8}
                cx={cellX(pitch, 5, 8)}
                cy={cellY(rounds, 5, 8)}
                hidden={hiddenRound(rounds, 5)}
              />
              <BracketCell
                round={5}
                slot={9}
                cx={cellX(pitch, 5, 9)}
                cy={cellY(rounds, 5, 9)}
                hidden={hiddenRound(rounds, 5)}
              />
              <BracketCell
                round={5}
                slot={10}
                cx={cellX(pitch, 5, 10)}
                cy={cellY(rounds, 5, 10)}
                hidden={hiddenRound(rounds, 5)}
              />
              <BracketCell
                round={5}
                slot={11}
                cx={cellX(pitch, 5, 11)}
                cy={cellY(rounds, 5, 11)}
                hidden={hiddenRound(rounds, 5)}
              />
              <BracketCell
                round={5}
                slot={12}
                cx={cellX(pitch, 5, 12)}
                cy={cellY(rounds, 5, 12)}
                hidden={hiddenRound(rounds, 5)}
              />
              <BracketCell
                round={5}
                slot={13}
                cx={cellX(pitch, 5, 13)}
                cy={cellY(rounds, 5, 13)}
                hidden={hiddenRound(rounds, 5)}
              />
              <BracketCell
                round={5}
                slot={14}
                cx={cellX(pitch, 5, 14)}
                cy={cellY(rounds, 5, 14)}
                hidden={hiddenRound(rounds, 5)}
              />
              <BracketCell
                round={5}
                slot={15}
                cx={cellX(pitch, 5, 15)}
                cy={cellY(rounds, 5, 15)}
                hidden={hiddenRound(rounds, 5)}
              />
              <BracketCell
                round={4}
                slot={0}
                cx={cellX(pitch, 4, 0)}
                cy={cellY(rounds, 4, 0)}
                hidden={hiddenRound(rounds, 4)}
              />
              <BracketCell
                round={4}
                slot={1}
                cx={cellX(pitch, 4, 1)}
                cy={cellY(rounds, 4, 1)}
                hidden={hiddenRound(rounds, 4)}
              />
              <BracketCell
                round={4}
                slot={2}
                cx={cellX(pitch, 4, 2)}
                cy={cellY(rounds, 4, 2)}
                hidden={hiddenRound(rounds, 4)}
              />
              <BracketCell
                round={4}
                slot={3}
                cx={cellX(pitch, 4, 3)}
