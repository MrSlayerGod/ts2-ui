export function roomRow(type: Int): PohRoomRow | null {
  let fallback: PohRoomRow | null = null;
  let i: Int = 0;
  while (i < PohRooms.length) {
    const row: PohRoomRow | null = PohRooms.at(i);
    if (row !== null) {
      if (row.roomType === type) {
        return row;
      }
      if (row.id === PohRoomId.PARLOUR) {
        fallback = row;
      }
    }
    i = i + 1;
  }
  return fallback;
}

export function roomName(type: Int): String {
  const row: PohRoomRow | null = roomRow(type);
  if (row === null) {
    return '';
  }
  return row.nameUppercase;
}
