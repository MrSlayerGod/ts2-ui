export function skillmultiQuantityXReceive(typed: String): void {
  const [, setQuantity] = useState(smQuantity);
  const [, setQuantityString] = useState(smQuantityString);
  playSound(Sounds.INTERFACE_SELECT1);
  let text: String = countDialogValue(typed);
  let length: Int = text.length;
  const cap: Int = 28;
  if (length > `${cap}`.length) {
    setQuantity(cap);
    return;
  }
  let value: Int = 0;
  while (length > 0) {
    const digit: Int = '0123456789'.indexOf(text.substring(0, 1), 0);
    value = value + digit * pow10(length - 1);
    text = text.substring(1, length);
    length = length - 1;
  }
  setQuantity(value);
  setQuantityString(text);
}

function pow10(n: Int): Int {
  let out: Int = 1;
  let i: Int = 0;
  while (i < n) {
    out = out * 10;
    i = i + 1;
  }
  return out;
}

export function setGridScroll(y: Int): void {
  const [count] = useState(smCount);
  const [, setScroll] = useState(smScroll);
  setScroll(clampGridScroll(count, y));
}

export function scrollGridBy(delta: Int): void {
  const [scroll] = useState(smScroll);
  setGridScroll(scroll + delta);
}
