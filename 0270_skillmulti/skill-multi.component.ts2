import { useState } from 'ts2';
import { Sprites } from '../lib/game/sprites';
import { GridScrollbar } from './grid-scrollbar.component';
import { ProductSlot } from './product-slot.component';
import { QuantityButton } from './quantity-button.component';
import { SkillMultiTooltip, skillMultiRootRef } from './skill-multi-tooltip.component';
import { textDevice } from '../lib/lib.helpers';
import { smCount, smKind, smMax, smQuantity, smSuggested, smTitle } from './skillmulti.cells';
import { KindHasFreeEntry, KindHasQuantity, Layout, SkillMultiFonts, SlotColors } from './skillmulti.constants';
import { isGrid } from './skillmulti.layout';

export function SkillMulti(): Component {
  return (
    <layer ref={skillMultiRootRef} x="center" y="center" w={519} h={142}>
      <sprite x={0} y={0} w="fill" h="fill" sprite={Sprites.CHAT_BACKGROUND} />
      <SkillMultiHeader />
      <layer static x={0} y={0} w="fill" h="fill">
        <ProductSlot index={0} />
      </layer>
      <layer static x={0} y={0} w="fill" h="fill">
        <ProductSlot index={1} />
      </layer>
      <layer static x={0} y={0} w="fill" h="fill">
        <ProductSlot index={2} />
      </layer>
      <layer static x={0} y={0} w="fill" h="fill">
        <ProductSlot index={3} />
      </layer>
      <layer static x={0} y={0} w="fill" h="fill">
        <ProductSlot index={4} />
      </layer>
      <layer static x={0} y={0} w="fill" h="fill">
        <ProductSlot index={5} />
      </layer>
      <layer static x={0} y={0} w="fill" h="fill">
        <ProductSlot index={6} />
      </layer>
      <layer static x={0} y={0} w="fill" h="fill">
        <ProductSlot index={7} />
      </layer>
      <layer static x={0} y={0} w="fill" h="fill">
        <ProductSlot index={8} />
      </layer>
      <layer static x={0} y={0} w="fill" h="fill">
        <ProductSlot index={9} />
      </layer>
      <layer static x={0} y={0} w="fill" h="fill">
        <ProductSlot index={10} />
      </layer>
      <layer static x={0} y={0} w="fill" h="fill">
        <ProductSlot index={11} />
      </layer>
      <layer static x={0} y={0} w="fill" h="fill">
        <ProductSlot index={12} />
      </layer>
      <layer static x={0} y={0} w="fill" h="fill">
        <ProductSlot index={13} />
      </layer>
      <layer static x={0} y={0} w="fill" h="fill">
        <ProductSlot index={14} />
      </layer>
      <layer static x={0} y={0} w="fill" h="fill">
        <ProductSlot index={15} />
      </layer>
      <layer static x={0} y={0} w="fill" h="fill">
        <ProductSlot index={16} />
      </layer>
      <layer static x={0} y={0} w="fill" h="fill">
        <ProductSlot index={17} />
      </layer>
      <SkillMultiTooltip />
    </layer>
  );
}

function SkillMultiHeader(): Component {
  const [count] = useState(smCount);
  const [kind] = useState(smKind);
  const [title] = useState(smTitle);
  const hasQuantity: Boolean = KindHasQuantity.get(kind) ?? true;

  let instructions: String = 'Choose a quantity, then click an item to begin.';
  if (count > 0) {
    if (hasQuantity) {
      instructions = `Choose a quantity, then ${textDevice('click', 'tap')} an item to begin.`;
    } else {
      instructions = `${textDevice('Click', 'Tap')} an item to begin.`;
    }
  }
  const rowWidth: Int = count > 0 && hasQuantity ? quantityRowWidth() : 0;

  return (
    <>
      <layer x={{ center: 1 }} y={15} w={480} h={30}>
        <layer x={0} y="center" w={{ fill: rowWidth }} h="fill">
          <text
            x={0}
            y={0}
            w="fill"
            h="fill"
            text={title}
            align="center"
            valign="top"
            font={SkillMultiFonts.TITLE}
            color={SlotColors.TITLE}
          />
          <text
            x={0}
            y={0}
            w="fill"
            h="fill"
            text={instructions}
            align="center"
            valign="bottom"
            font={SkillMultiFonts.LABEL}
            color={SlotColors.HINT}
          />
        </layer>
        {count > 0 && hasQuantity && <QuantityRow />}
      </layer>
      <layer x={0} y={0} w={Layout.ROOT_WIDTH} h={Layout.ROOT_HEIGHT}>
        {isGrid(count) && <GridScrollbar />}
      </layer>
    </>
  );
}

function showOther(max: Int, suggested: Int): Boolean {
  if (suggested === 1 || suggested === 5 || suggested === 10 || suggested === max) {
    return false;
  }
  if (suggested < 1 || suggested > max) {
    return false;
  }
  return true;
}

function quantityRowWidth(): Int {
  const [kind] = useState(smKind);
  const [max] = useState(smMax);
  const [suggested] = useState(smSuggested);
  let x: Int = 0;
  if (KindHasFreeEntry.get(kind) ?? true) {
    if (max > 1) {
      x = x + 35;
    }
    if (max > 5) {
      x = x + 35;
    }
    if (max > 10) {
      x = x + 35;
    }
    if (showOther(max, suggested)) {
      x = x + 35;
    }
    if (max > 2) {
      x = x + 35;
    }
    x = x + 40;
  } else {
    x = x + 35;
    if (max >= 5) {
      x = x + 35;
    }
    if (max >= 10) {
      x = x + 35;
    }
  }
  return x - 5;
}

function QuantityRow(): Component {
  const [kind] = useState(smKind);
  const [max] = useState(smMax);
  const [quantity] = useState(smQuantity);
  const [suggested] = useState(smSuggested);
  const width: Int = quantityRowWidth();

  if (KindHasFreeEntry.get(kind) ?? true) {
    let x1: Int = 0;
    let x5: Int = x1;
    if (max > 1) {
      x5 = x1 + 35;
    }
    let x10: Int = x5;
    if (max > 5) {
      x10 = x5 + 35;
    }
    let xOther: Int = x10;
    if (max > 10) {
      xOther = x10 + 35;
    }
    const other: Boolean = showOther(max, suggested);
    let xX: Int = xOther;
    if (other) {
      xX = xOther + 35;
    }
    let xAll: Int = xX;
    if (max > 2) {
      xAll = xX + 35;
    }
    return (
      <layer x="right" y="center" w={width} h={30}>
        {max > 1 && <QuantityButton label="1" amount={1} x={x1} selected={quantity === 1} />}
        {max > 5 && <QuantityButton label="5" amount={5} x={x5} selected={quantity === 5} />}
        {max > 10 && <QuantityButton label="10" amount={10} x={x10} selected={quantity === 10} />}
        {other && (
          <QuantityButton label={`${suggested}`} amount={suggested} x={xOther} selected={quantity === suggested} />
        )}
        {max > 2 && <QuantityButton label="X" amount={0} x={xX} isX />}
        <QuantityButton label="All" amount={max} x={xAll} w={35} selected={quantity >= max} />
      </layer>
    );
  }
  return (
    <layer x="right" y="center" w={width} h={30}>
      <QuantityButton label="1" amount={1} x={0} selected={quantity === 1} />
      {max >= 5 && <QuantityButton label="5" amount={5} x={35} selected={quantity === 5} />}
      {max >= 10 && <QuantityButton label="10" amount={10} x={70} selected={quantity === 10} />}
    </layer>
  );
}
