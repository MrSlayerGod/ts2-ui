import { useState } from 'ts2';

import { onMobile } from '../lib/lib.helpers';
import { Button, WelcomeColors } from './welcome-screen.constants';

export function ButtonWash(): Component {
  const [hovered, setHovered] = useState(0);
  return (
    <layer
      x="center"
      y="center"
      w="fill"
      h="fill"
      onMouseRepeat={() => {
        if (!onMobile()) {
          setHovered(1);
        }
      }}
      onMouseLeave={() => {
        if (!onMobile()) {
          setHovered(0);
        }
      }}
    >
      <rect
        x="center"
        y="center"
        w={{ fill: Button.WASH_INSET }}
        h={{ fill: Button.WASH_INSET }}
        hide={hovered === 0}
        fill
        color={WelcomeColors.WHITE}
        transparency={Button.WASH_TRANSPARENCY}
      />
    </layer>
  );
}
