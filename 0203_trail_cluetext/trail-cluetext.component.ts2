import { createRef, onMounted, onUpdated, useState } from 'ts2';

import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import { ClueColor, ClueFonts, ClueModel, CloseSprites, Layout } from './trail-cluetext.constants';
import { resetClueTextTight, trailClueTextTight } from './trail-cluetext.state';

const clueText = createRef('trail_cluetext_text');

export function TrailClueText(): Component {
  return (
    <>
      <model
        x={Layout.MODEL_X}
        y={Layout.MODEL_Y}
        w={Layout.MODEL_BOX}
        h={Layout.MODEL_BOX}
        model={ClueModel.SCROLL}
        zoom={Layout.MODEL_ZOOM}
        pitch={Layout.MODEL_PITCH}
        yaw={Layout.MODEL_YAW}
      />

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={CloseSprites.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseEnter={(event) => graphicSwapper(event.component, CloseSprites.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, CloseSprites.CLOSE)}
      />

      <text
        static
        ref={clueText}
        x={Layout.TEXT_X}
        y={Layout.TEXT_Y}
        w={Layout.TEXT_W}
        h={Layout.TEXT_H}
        font={ClueFonts.CLUE}
        color={ClueColor.TEXT}
        shadow
        align="center"
        valign="middle"
        lineHeight={Layout.TEXT_LINE_H}
        onLoad={() => resetClueTextTight()}
      />

      <ClueTextSpacing />
    </>
  );
}

function ClueTextSpacing(): Component {
  const [tight] = useState(trailClueTextTight);
  const lineHeight = tight !== 0 ? Layout.TEXT_LINE_H_TIGHT : Layout.TEXT_LINE_H;

  onMounted(() => placeClueText(lineHeight));
  onUpdated(() => placeClueText(lineHeight));

  return <layer x={0} y={0} w={0} h={0} />;
}

function placeClueText(lineHeight: Int): void {
  clueText.props = { align: 'center', valign: 'middle', lineHeight: lineHeight };
}
