import { CS2, createRef } from 'ts2';

import { StoneBorderEntrypoint } from '../lib/stone-border-entrypoint.component';
import { ChallengeList } from './challenge-list.component';
import { RaidsScoreBoard, resetRaidsScore } from './raids-score.component';
import { Challenge, ChallengeColors, ChallengeFonts, ChallengeText } from './raids-challenge.constants';

const raidsChallenge = createRef('raids_challenge');

export function WorldLabel(): Component {
  return (
    <text
      x={0}
      y={0}
      w="fill"
      h="fill"
      font={ChallengeFonts.LABEL}
      color={ChallengeColors.LABEL}
      shadow
      align="center"
      valign="middle"
      text={`World ${CS2.map_world()}`}
    />
  );
}

export function RaidsChallenge(): Component {
  return (
    <layer x="center" y="center" w={{ fill: Challenge.ROOT_INSET }} h={{ fill: Challenge.ROOT_INSET }}>
      <StoneBorderEntrypoint title={ChallengeText.TITLE} />

      <layer x="center" y={Challenge.BODY_Y} w={{ fill: Challenge.BODY_INSET_W }} h={{ fill: Challenge.BODY_INSET_H }}>
        <ChallengeList />

        <layer
          x={Challenge.BOARD_X}
          y={0}
          w={{ fill: Challenge.BOARD_INSET_W }}
          h="fill"
          onLoad={() => resetRaidsScore()}
        >
          <rect
            x={Challenge.PLATE_X}
            y={Challenge.PLATE_Y_0}
            w={Challenge.PLATE_W}
            h={Challenge.PLATE_H}
            fill
            color={ChallengeColors.WASH}
            transparency={ChallengeColors.PLATE_FADE}
          />
          <rect
            x={Challenge.PLATE_X}
            y={Challenge.PLATE_Y_1}
            w={Challenge.PLATE_W}
            h={Challenge.PLATE_H}
            fill
            color={ChallengeColors.WASH}
            transparency={ChallengeColors.PLATE_FADE}
          />
          <rect
            x={Challenge.PLATE_X}
            y={Challenge.PLATE_Y_2}
            w={Challenge.PLATE_W}
            h={Challenge.PLATE_H}
            fill
            color={ChallengeColors.WASH}
            transparency={ChallengeColors.PLATE_FADE}
          />

          <text
            x={{ center: Challenge.GLOBAL_CENTER_X }}
            y={0}
            w={Challenge.GLOBAL_W}
            h={Challenge.LABEL_H}
            font={ChallengeFonts.LABEL}
            color={ChallengeColors.LABEL}
            shadow
            valign="middle"
            text={ChallengeText.GLOBAL_BEST}
          />
          <RaidsScoreBoard />

          <WorldLabel x="center" y={Challenge.WORLD_Y} w={Challenge.WORLD_W} h={Challenge.WORLD_H} />
        </layer>

        <text
          x={0}
          y={0}
          w={Challenge.BRACKET_W}
          h={Challenge.BRACKET_H}
          font={ChallengeFonts.LABEL}
          color={ChallengeColors.LABEL}
          shadow
          align="center"
          valign="middle"
          text={ChallengeText.BRACKET}
        />
      </layer>
    </layer>
  );
}

export const raidsChallengeUi = (): UI => (
  <ui ref={raidsChallenge}>
    <RaidsChallenge />
  </ui>
);
