import { CS2, sessionState, useServerState, useSkill, useSkillBase, useState } from 'ts2';

import { clientClock } from '../lib/lib.engine';
import { Varbits } from '../lib/game/varbits';
import {
  toaClientName0,
  toaClientName1,
  toaClientName2,
  toaClientName3,
  toaClientName4,
  toaClientName5,
  toaClientName6,
  toaClientName7,
  toaClientNextrefresh,
} from '../lib/game/varcs';
import { Health, Layout, ToaHudSkills } from './toa-hud.constants';

export enum Slot {
  S0 = 0,
  S1 = 1,
  S2 = 2,
  S3 = 3,
  S4 = 4,
  S5 = 5,
  S6 = 6,
  S7 = 7,
}

export function slotHealth(slot: Slot): Int {
  switch (slot) {
    case Slot.S0:
      return useServerState(Varbits.TOA_CLIENT_P0);
    case Slot.S1:
      return useServerState(Varbits.TOA_CLIENT_P1);
    case Slot.S2:
      return useServerState(Varbits.TOA_CLIENT_P2);
    case Slot.S3:
      return useServerState(Varbits.TOA_CLIENT_P3);
    case Slot.S4:
      return useServerState(Varbits.TOA_CLIENT_P4);
    case Slot.S5:
      return useServerState(Varbits.TOA_CLIENT_P5);
    case Slot.S6:
      return useServerState(Varbits.TOA_CLIENT_P6);
    case Slot.S7:
      return useServerState(Varbits.TOA_CLIENT_P7);
  }
  return 0;
}

export function slotPrimary(slot: Slot): Int {
  switch (slot) {
    case Slot.S0:
      return useServerState(Varbits.TOA_CLIENT_PRIMARY0);
    case Slot.S1:
      return useServerState(Varbits.TOA_CLIENT_PRIMARY1);
    case Slot.S2:
      return useServerState(Varbits.TOA_CLIENT_PRIMARY2);
    case Slot.S3:
      return useServerState(Varbits.TOA_CLIENT_PRIMARY3);
    case Slot.S4:
      return useServerState(Varbits.TOA_CLIENT_PRIMARY4);
    case Slot.S5:
      return useServerState(Varbits.TOA_CLIENT_PRIMARY5);
    case Slot.S6:
      return useServerState(Varbits.TOA_CLIENT_PRIMARY6);
    case Slot.S7:
      return useServerState(Varbits.TOA_CLIENT_PRIMARY7);
  }
  return 0;
}

export function activeSlots(): Int {
  let active: Int = 0;
  if (useServerState(Varbits.TOA_CLIENT_P0) !== Health.EMPTY) {
    active = active + 1;
  }
  if (useServerState(Varbits.TOA_CLIENT_P1) !== Health.EMPTY) {
    active = active + 1;
  }
  if (useServerState(Varbits.TOA_CLIENT_P2) !== Health.EMPTY) {
    active = active + 1;
  }
  if (useServerState(Varbits.TOA_CLIENT_P3) !== Health.EMPTY) {
    active = active + 1;
  }
  if (useServerState(Varbits.TOA_CLIENT_P4) !== Health.EMPTY) {
    active = active + 1;
  }
  if (useServerState(Varbits.TOA_CLIENT_P5) !== Health.EMPTY) {
    active = active + 1;
  }
  if (useServerState(Varbits.TOA_CLIENT_P6) !== Health.EMPTY) {
    active = active + 1;
  }
  if (useServerState(Varbits.TOA_CLIENT_P7) !== Health.EMPTY) {
    active = active + 1;
  }
  return active;
}

export function nameRows(active: Int): Int {
  return Math.max((active * 10 / 2 + 5) / 10, 1);
}

export function namesHeight(rows: Int): Int {
  return rows * Layout.ROW_H + (rows - 1);
}

export function myOrbHeight(): Int {
  const current: Int = useSkill(ToaHudSkills.HITPOINTS);
  let height: Int = Math.min(
    Layout.ORB,
    CS2.scale(current, Math.max(1, useSkillBase(ToaHudSkills.HITPOINTS)), Layout.ORB),
  );
  if (current > 0) {
    height = Math.max(1, height);
  }
  return height;
}

export const shownName0 = sessionState('');
export const shownName1 = sessionState('');
export const shownName2 = sessionState('');
export const shownName3 = sessionState('');
export const shownName4 = sessionState('');
export const shownName5 = sessionState('');
export const shownName6 = sessionState('');
export const shownName7 = sessionState('');

const REFRESH = 30;

export function drawToaHud(): void {
  const [, setNextRefresh] = useState(toaClientNextrefresh);
  const [raw0] = useState(toaClientName0);
  const [raw1] = useState(toaClientName1);
  const [raw2] = useState(toaClientName2);
  const [raw3] = useState(toaClientName3);
  const [raw4] = useState(toaClientName4);
  const [raw5] = useState(toaClientName5);
  const [raw6] = useState(toaClientName6);
  const [raw7] = useState(toaClientName7);
  const [, set0] = useState(shownName0);
  const [, set1] = useState(shownName1);
  const [, set2] = useState(shownName2);
  const [, set3] = useState(shownName3);
  const [, set4] = useState(shownName4);
  const [, set5] = useState(shownName5);
  const [, set6] = useState(shownName6);
  const [, set7] = useState(shownName7);
  setNextRefresh(clientClock() + REFRESH);
  set0(raw0);
  set1(raw1);
  set2(raw2);
  set3(raw3);
  set4(raw4);
  set5(raw5);
  set6(raw6);
  set7(raw7);
}

export function toaHudDrawTick(): void {
  const [nextRefresh] = useState(toaClientNextrefresh);
  if (clientClock() >= nextRefresh) {
    drawToaHud();
  }
}

export function name0(): String {
  const [n] = useState(shownName0);
  return n;
}
export function name1(): String {
  const [n] = useState(shownName1);
  return n;
}
export function name2(): String {
  const [n] = useState(shownName2);
  return n;
}
export function name3(): String {
  const [n] = useState(shownName3);
  return n;
}
export function name4(): String {
  const [n] = useState(shownName4);
  return n;
}
export function name5(): String {
  const [n] = useState(shownName5);
  return n;
}
export function name6(): String {
  const [n] = useState(shownName6);
  return n;
}
export function name7(): String {
  const [n] = useState(shownName7);
  return n;
}

export function partyName(raw: String): String {
  if (raw.length <= 0) {
    return '-';
  }
  if (CS2.compare(raw, 'null') === 0) {
    return '-';
  }
  return raw;
}

export function isMyself(slot: Slot): Boolean {
  if (slot === useServerState(Varbits.TOA_CLIENT_PARTYSLOT) - 1) {
    return true;
  }
  return false;
}
