import { createRef } from 'ts2';

import { Anchor, overlayInit } from '../lib/lib.overlay';
import { GauntletTimerStrip, resetGauntletClock } from './gauntlet-clock.component';
import { GauntletDodge, Layout } from './gauntlet-overlay.constants';

const timerHost = createRef('0637_gauntlet_overlay_timer_host');

const content = createRef('gauntlet_overlay_content');

export function GauntletOverlay_(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill" onLoad={() => resetGauntletClock()}>
      <layer
        w={Layout.PLATE_W}
        h={Layout.PLATE_H}
        ref={timerHost}
        onLoad={() => overlayInit(timerHost, content, GauntletDodge.FLAGS, Anchor.LEFT, Anchor.TOP, 1)}
      >
        <layer ref={content} x={0} y={0} w={Layout.PLATE_W} h={Layout.PLATE_H}>
          <GauntletTimerStrip />
        </layer>
      </layer>
    </layer>
  );
}
