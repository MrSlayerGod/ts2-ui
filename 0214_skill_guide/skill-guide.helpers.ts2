import { CS2, useServerState, useState } from 'ts2';

import { Varbits } from '../lib/game/varbits';
import { skillGuideV2CurrentSkill, skillGuideV2CurrentTab, skillGuideV2X, skillGuideV2Y } from '../lib/game/varcs';
import { Sounds } from '../lib/game/sounds';
import { playSound } from '../lib/lib.engine';
import { onMobile } from '../lib/lib.helpers';
import { GuideChrome, GuideDrag } from './skill-guide.constants';
import { guideFrom, guideSkill, guideTab, guideTo } from './skill-guide.state';

export function textColourSwapper(component: ComponentId, colour: Int): void {
  component.color = colour;
}

export function guideTopInset(): Int {
  if (onMobile()) {
    return GuideChrome.MOBILE_TOP_INSET;
  }
  return GuideChrome.DESKTOP_TOP_INSET;
}

export function guideDraggable(): Boolean {
  if (CS2.window_mode_get() === 1) {
    return false;
  }
  if (onMobile()) {
    return false;
  }
  const setting: Int = useServerState(Varbits.SETTINGS_INTERFACE_RESIZING);
  if (setting === 0) {
    return false;
  }
  return true;
}

export function dragGuideWindow(window: ComponentId, root: ComponentId, mouseX: Int, mouseY: Int): void {
  if (!guideDraggable()) {
    return;
  }

  const top: Int = guideTopInset();
  const windowW: Int = window.width!;
  const windowH: Int = window.height!;
  const frameW: Int = root.width!;
  const frameH: Int = root.height! - top;

  let x: Int = mouseX;
  let y: Int = mouseY;
  if (x < GuideDrag.SNAP_X) {
    x = 0;
  }
  if (y < top + GuideDrag.SNAP_Y) {
    y = top;
  }
  x = Math.max(0, Math.min(x, frameW - windowW));
  y = Math.max(top, Math.min(y, top + frameH - windowH));

  window.x = x;
  window.y = y;

  const [, setX] = useState(skillGuideV2X);
  const [, setY] = useState(skillGuideV2Y);
  setX(x);
  setY(y);
}

export function skillGuideShow(skill: Int, tab: Int, from: Int, to: Int): void {
  const [, setSkill] = useState(guideSkill);
  const [, setTab] = useState(guideTab);
  const [, setFrom] = useState(guideFrom);
  const [, setTo] = useState(guideTo);
  const [, setSharedSkill] = useState(skillGuideV2CurrentSkill);
  const [, setSharedTab] = useState(skillGuideV2CurrentTab);
  let first: Int = from;
  let last: Int = to;
  if (tab !== LEVEL_UP_TAB) {
    first = 0;
    last = 0;
  }
  setSharedSkill(skill);
  setSharedTab(tab);
  setSkill(skill);
  setTab(tab);
  setFrom(first);
  setTo(last);
}

export function skillGuideCategory(index: Int): void {
  const [skill] = useState(guideSkill);
  playSound(Sounds.INTERFACE_SELECT1);
  skillGuideShow(skill, index, 0, 0);
}

export const LEVEL_UP_TAB = 31;
