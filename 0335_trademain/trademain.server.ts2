export function stampOtherSlot(slot: Int): void {
  const now: Int = clientClock();
  switch (slot) {
    case 0: {
      const [, s] = useState(tradeSlot0Changed);
      s(now);
      return;
    }
    case 1: {
      const [, s] = useState(tradeSlot1Changed);
      s(now);
      return;
    }
    case 2: {
