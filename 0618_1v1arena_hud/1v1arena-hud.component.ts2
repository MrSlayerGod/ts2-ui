import { onMounted, onUpdated, useInterval, useState } from 'ts2';

import { SteelFrameEntrypoint } from '../lib/steel-frame-entrypoint.component';
import { ButtonBackground } from './button-background.component';
import {
  ArenaButton,
  ArenaColor,
  ArenaFonts,
  ArenaSprites,
  ArenaTransparency,
  Layout,
  ReviewRows,
} from './1v1arena-hud.constants';
import {
  arenaFlashTick,
  arenaHudOpen,
  collapseArenaHud,
  displaySlot,
  expandArenaHud,
  hideSlot,
  paintButtonLabel,
  paintToggleLabel,
  pressArenaButton,
  showSlot,
} from './1v1arena-hud.helpers';
import {
  arenaCollapsed,
  arenaToggleColour,
  spectatorColour,
  spectatorFlashUntil,
  startAllColour,
  startAllFlashUntil,
} from './1v1arena-hud.state';

export function Arena1v1Hud(): Component {
  return (
    <layer x="center" y="center" w="fill" h="fill" onLoad={() => arenaHudOpen()}>
      <layer
        static
        ref={showSlot}
        x={Layout.SHOW_X}
        y="center"
        w={Layout.SHOW_W}
        h={Layout.SHOW_H}
        hide
        noClickThrough
        options={['Show']}
        onMouseEnter={() => paintToggleLabel(ArenaColor.HOVER)}
        onMouseLeave={() => paintToggleLabel(ArenaColor.LABEL)}
        onOptionSelect={() => expandArenaHud()}
      >
        <ButtonBackground />
        <ShowLabel />
      </layer>

      <layer static ref={displaySlot} x={Layout.DISPLAY_X} y="center" w={Layout.DISPLAY_W} h={Layout.DISPLAY_H}>
        <sprite
          x="center"
          y="center"
          w={{ fill: Layout.BACKDROP_INSET }}
          h={{ fill: Layout.BACKDROP_INSET }}
          sprite={ArenaSprites.BACKDROP}
          tiling
          transparency={ArenaTransparency.BACKDROP}
        />

        <layer x="center" y="center" w={{ fill: Layout.CONTENTS_INSET }} h={{ fill: Layout.CONTENTS_INSET }} dragTarget>
          <layer
            static
            ref={hideSlot}
            x={{ right: Layout.HIDE_INSET_X }}
            y={Layout.HIDE_Y}
            w={Layout.HIDE_W}
            h={Layout.HIDE_H}
            noClickThrough
            options={['Hide']}
            onMouseEnter={() => paintToggleLabel(ArenaColor.HOVER)}
            onMouseLeave={() => paintToggleLabel(ArenaColor.LABEL)}
            onOptionSelect={() => collapseArenaHud()}
          >
            <ButtonBackground />
            <HideLabel />
          </layer>

          <layer
            x={{ right: Layout.SPECTATOR_INSET_X }}
            y={Layout.SPECTATOR_Y}
            w={Layout.SPECTATOR_W}
            h={Layout.SPECTATOR_H}
            noClickThrough
            options={['Spectator']}
            onMouseRepeat={() => paintButtonLabel(ArenaButton.SPECTATOR, ArenaColor.HOVER)}
            onMouseLeave={() => paintButtonLabel(ArenaButton.SPECTATOR, ArenaColor.LABEL)}
            onOptionSelect={() => pressArenaButton(ArenaButton.SPECTATOR)}
          >
            <ButtonBackground />
            <SpectatorLabel />
          </layer>

          <layer
            x={{ right: Layout.STARTALL_INSET_X }}
            y={Layout.STARTALL_Y}
            w={Layout.STARTALL_W}
            h={Layout.STARTALL_H}
            noClickThrough
            options={['Start All']}
            onMouseRepeat={() => paintButtonLabel(ArenaButton.START_ALL, ArenaColor.HOVER)}
            onMouseLeave={() => paintButtonLabel(ArenaButton.START_ALL, ArenaColor.LABEL)}
            onOptionSelect={() => pressArenaButton(ArenaButton.START_ALL)}
          >
            <ButtonBackground />
            <StartAllLabel />
          </layer>

          <layer
            x={0}
            y={0}
            w={Layout.ARENA_W}
            h={Layout.ARENA_H}
            noClickThrough
            dragTarget
            options={['', '', '', '', '', '', '', '', '', '*']}
          />
          <layer
            x="center"
            y={0}
            w={Layout.ARENA_W}
            h={Layout.ARENA_H}
            noClickThrough
            dragTarget
            options={['', '', '', '', '', '', '', '', '', '*']}
          />
          <layer
            x={0}
            y={Layout.ARENA_ROW_2_Y}
            w={Layout.ARENA_W}
            h={Layout.ARENA_H}
            noClickThrough
            dragTarget
            options={['', '', '', '', '', '', '', '', '', '*']}
          />
          <layer
            x="center"
            y={Layout.ARENA_ROW_2_Y}
            w={Layout.ARENA_W}
            h={Layout.ARENA_H}
            noClickThrough
            dragTarget
            options={['', '', '', '', '', '', '', '', '', '*']}
          />
          <layer
            x="right"
            y={Layout.ARENA_ROW_2_Y}
            w={Layout.ARENA_W}
            h={Layout.ARENA_H}
            noClickThrough
            dragTarget
            options={['', '', '', '', '', '', '', '', '', '*']}
          />

          {ReviewRows.map(() => (
            <layer
              x={0}
              y="bottom"
              w={Layout.REVIEW_W}
              h={Layout.REVIEW_H}
              hide
              options={['Review']}
              interactionDepth={1}
              dragDeadZone={5}
              dragDeadTime={5}
            />
          ))}

          <ArenaFlashHost />
        </layer>

        <SteelFrameEntrypoint />
      </layer>

      <ArenaToggle />
    </layer>
  );
}

function ArenaToggle(): Component {
  const [collapsed] = useState(arenaCollapsed);
  const folded: Boolean = collapsed === 1;
  onMounted(() => placeArenaToggle(folded));
  onUpdated(() => placeArenaToggle(folded));
  return <layer x={0} y={0} w={0} h={0} />;
}

function placeArenaToggle(folded: Boolean): void {
  displaySlot.props = { hide: folded };
  hideSlot.props = { hide: folded };
  showSlot.props = { hide: !folded };
}

function ShowLabel(): Component {
  const [colour] = useState(arenaToggleColour);
  return (
    <text
      x="center"
      y="center"
      w="fill"
      h="fill"
      text="Show"
      font={ArenaFonts.LABEL}
      color={colour}
      align="center"
      valign="middle"
      shadow
    />
  );
}

function HideLabel(): Component {
  const [colour] = useState(arenaToggleColour);
  return (
    <text
      x="center"
      y="center"
      w="fill"
      h="fill"
      text="Hide"
      font={ArenaFonts.LABEL}
      color={colour}
      align="center"
      valign="middle"
      shadow
    />
  );
}

function SpectatorLabel(): Component {
  const [colour] = useState(spectatorColour);
  return (
    <text
      x="center"
      y="center"
      w="fill"
      h="fill"
      text="Spectator"
      font={ArenaFonts.LABEL}
      color={colour}
      align="center"
      valign="middle"
      shadow
    />
  );
}

function StartAllLabel(): Component {
  const [colour] = useState(startAllColour);
  return (
    <text
      x="center"
      y="center"
      w="fill"
      h="fill"
      text="Start All"
      font={ArenaFonts.LABEL}
      color={colour}
      align="center"
      valign="middle"
      shadow
    />
  );
}

function ArenaFlashHost(): Component {
  const [spectatorUntil] = useState(spectatorFlashUntil);
  const [startAllUntil] = useState(startAllFlashUntil);
  const idle: Boolean = spectatorUntil === -1 && startAllUntil === -1;
  return (
    <layer x={0} y={0} w={1} h={1} hide={idle}>
      <ArenaFlashTimer />
    </layer>
  );
}

function ArenaFlashTimer(): Component {
  useInterval(() => arenaFlashTick());
  return <layer x={0} y={0} w={1} h={1} />;
}
