import { CS2, useState } from 'ts2';

import { opsound } from '../lib/lib.helpers';
import { PanelBorder } from './panel-border.component';
import { PartnerButtonFrame } from './partner-button-frame.component';
import { Colors, Fonts, Models } from './slayer-partner.constants';
import { resetSlayerPartnerLabel, slayerPartnerLabel } from './slayer-partner.state';

export function SlayerPartner(): Component {
  return (
    <layer w="fill" h="fill" onLoad={() => resetSlayerPartnerLabel()}>
      <PanelBorder title="Slayer Partner" />

      <layer x={10} y={40} w={280} h={{ fill: 50 }}>
        <model x={245} y={-5} w={40} h={50} model={Models.PARTNER_ICON} pitch={153} yaw={109} zoom={340} offsetY={20} />

        <text x={0} y={0} w={280} h={20} font={Fonts.HEADING} color={Colors.TEXT} shadow />
        <text x={0} y={20} w={280} h={{ fill: 60 }} font={Fonts.BODY} color={Colors.TEXT} shadow valign="middle" />

        <PartnerButtonFrame x={70} y="bottom" w={140} h={30} />

        <PartnerLabel x="center" y="bottom" w={140} h={30} />
      </layer>
    </layer>
  );
}

function PartnerLabel(): Component {
  const [label] = useState(slayerPartnerLabel);
  return (
    <text
      w="fill"
      h="fill"
      font={Fonts.BUTTON}
      text={label}
      color={Colors.TEXT}
      hover={{ color: Colors.TEXT_HOVER }}
      shadow
      align="center"
      valign="middle"
      options={[CS2.string_length(label) === 0 ? '*' : CS2.tags_remove(label)]}
      onOptionSelect={(event) => opsound(event.option, 2)}
    />
  );
}
