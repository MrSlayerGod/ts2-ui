import { CS2, useServerState, useState } from 'ts2';
import { SteelFrame } from '../0032_boardgames_draughts/steel-frame.component';
import { onMobile } from '../lib/lib.helpers';
import { Varbits } from '../lib/game/varbits';
import {
  Dropdown,
  DropdownEntry,
  LeagueInfoColors,
  LeagueInfoFade,
  LeagueInfoFonts,
  LeagueInfoSounds,
  LeagueInfoSprites,
  MenuButton,
} from '../0654_league_info/league-info.constants';
import {
  colourSwapper,
  combatMasteriesEntry,
  desktop,
  dropdownRows,
  dropdownWidth,
  inLeagueTutorial,
  isLeagueThree,
  rowHoverable,
} from '../0654_league_info/league-info.helpers';
import { LeagueThemes } from './league-themes.data';
import { fragmentMenuOpen } from './league-3-fragments.state';

export function LeagueSwitcher(): Component {
  const league: Int = useServerState(Varbits.LEAGUE_TYPE);
  const theme = LeagueThemes.get(league);
  const known: Boolean = theme !== null;
  const accent: Int = theme === null ? LeagueInfoColors.GOLD : theme.colour;
  const mobile: Boolean = onMobile();
  const button: Boolean = known && !inLeagueTutorial();
  return (
    <>
      <SwitcherOverlay />
      {button && (
        <layer
          x={mobile ? MenuButton.MOBILE.x : MenuButton.DESKTOP.x}
          y={mobile ? MenuButton.MOBILE.y : MenuButton.DESKTOP.y}
          w={mobile ? MenuButton.MOBILE.w : MenuButton.DESKTOP.w}
          h={mobile ? MenuButton.MOBILE.h : MenuButton.DESKTOP.h}
        >
          <SwitcherButton />
        </layer>
      )}
      <layer x={0} y={29} w={dropdownWidth()} h={dropdownRows() + Dropdown.EXTRA_H}>
        {known && <SwitcherDropdown league={league} accent={accent} />}
      </layer>
    </>
  );
}

function SwitcherButton(): Component {
  const [open, setOpen] = useState(fragmentMenuOpen);
  const swap: Boolean = desktop();
  const locked: Boolean = inLeagueTutorial();
  const rest: Sprite = open === 1 ? LeagueInfoSprites.MENU_OVER : LeagueInfoSprites.MENU;
  return (
    <layer
      w="fill"
      h="fill"
      options={['Show Menu']}
      onOptionSelect={() => {
        if (locked) {
          CS2.sound_effect(LeagueInfoSounds.REFUSED, 1, 0);
          setOpen(0);
        } else if (open === 1) {
          setOpen(0);
        } else {
          setOpen(1);
        }
      }}
    >
      <sprite
        x="center"
        y="center"
        w={MenuButton.ICON}
        h={MenuButton.ICON}
        sprite={rest}
        onMouseRepeat={
          swap
            ? (event) => {
                event.self.sprite = LeagueInfoSprites.MENU_OVER;
              }
            : undefined
        }
        onMouseLeave={
          swap
            ? (event) => {
                event.self.sprite = LeagueInfoSprites.MENU;
              }
            : undefined
        }
      />
    </layer>
  );
}

function SwitcherOverlay(): Component {
  const [open, setOpen] = useState(fragmentMenuOpen);
  return (
    <layer
      w="fill"
      h="fill"
      hide={open === 1 ? false : true}
      noClickThrough
      onClick={() => {
        CS2.sound_effect(LeagueInfoSounds.CLICK, 1, 0);
        setOpen(0);
      }}
    />
  );
}

function SwitcherRow({
  label,
  entry,
  colour,
  top,
  height,
  width,
}: {
  label: String;
  entry: Int;
  colour: Int;
  top: Int;
  height: Int;
  width: Int;
}): Component {
  const [, setOpen] = useState(fragmentMenuOpen);
  const active: Boolean = entry === DropdownEntry.RELICS;
  const swap: Boolean = rowHoverable(active);
  return (
    <>
      <rect
        x={Dropdown.ROW_X}
        y={top}
        w={width - Dropdown.ROW_INSET}
        h={height}
        color={LeagueInfoColors.BACKING}
        fill
        transparency={active ? LeagueInfoFade.SOFT : LeagueInfoFade.OPAQUE}
      />
      <text
        x={Dropdown.ROW_X}
        y={top}
        w={width - Dropdown.ROW_INSET}
        h={height}
        text={label}
        font={LeagueInfoFonts.BODY}
        shadow
        color={active ? LeagueInfoColors.WHITE : colour}
        align="center"
        valign="middle"
        onMouseEnter={swap ? (event) => colourSwapper(event.component, LeagueInfoColors.WHITE) : undefined}
        onMouseLeave={swap ? (event) => colourSwapper(event.component, colour) : undefined}
        options={[`View ${label}`]}
        onOptionSelect={() => {
          CS2.sound_effect(LeagueInfoSounds.CLICK, 1, 0);
          setOpen(0);
        }}
      />
    </>
  );
}

function SwitcherDropdown({ league, accent }: { league: Int; accent: Int }): Component {
  const [open] = useState(fragmentMenuOpen);
  const rows: Int = dropdownRows();
  const width: Int = dropdownWidth();
  const step: Int = rows / 4;
  const fifth: Boolean = combatMasteriesEntry(league);
  const three: Boolean = isLeagueThree(league);
  return (
    <layer w="fill" h="fill" hide={open === 1 ? false : true} noClickThrough={open === 1 ? true : false}>
      <sprite x={0} y={0} w="fill" h="fill" sprite={LeagueInfoSprites.DROPDOWN_BACK} />
      <SteelFrame backdrop={false} />
      <SwitcherRow
        label="Info"
        entry={DropdownEntry.INFO}
        colour={accent}
        top={Dropdown.TOP}
        height={step}
        width={width}
      />
      <SwitcherRow
        label="Tasks"
        entry={DropdownEntry.TASKS}
        colour={accent}
        top={Dropdown.TOP + step}
        height={step}
        width={width}
      />
      <SwitcherRow
        label={three ? 'Unlocks' : 'Areas'}
        entry={DropdownEntry.AREAS}
        colour={accent}
        top={Dropdown.TOP + step * 2}
        height={step}
        width={width}
      />
      <SwitcherRow
        label={three ? 'Fragments' : 'Relics'}
        entry={DropdownEntry.RELICS}
        colour={accent}
        top={Dropdown.TOP + step * 3}
        height={step}
        width={width}
      />
      {fifth && (
        <SwitcherRow
          label="Combat Masteries"
          entry={DropdownEntry.COMBAT_MASTERIES}
          colour={accent}
          top={Dropdown.TOP + step * 4}
          height={step}
          width={width}
        />
      )}
    </layer>
  );
}
