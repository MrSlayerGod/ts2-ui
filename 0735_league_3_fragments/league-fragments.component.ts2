import { useServerState, useState } from 'ts2';

import { Varbits } from '../lib/game/varbits';
import { leagueColour } from './league-3-fragments.helpers';
import { ClearFiltersButton } from './clear-filters-button.component';
import { CloseButton } from './close-button.component';
import { DropdownPopup } from './dropdown-popup.component';
import { FilterPanel } from './filter-panel.component';
import { FragmentDetail } from './fragment-detail.component';
import { FragmentList } from './fragment-list.component';
import { FragmentLoadout } from './fragment-loadout.component';
import { FragmentLoadoutIcons } from './fragment-loadout-icons.component';
import { SteelBorder } from '../lib/steel-border.component';
import { StoneTabButton } from './stone-tab-button.component';
import { LeagueSwitcher } from './league-switcher.component';
import { fragmentFiltersShown, fragmentPane, Pane, resetFragments, TabAction } from './league-3-fragments.state';

export function LeagueFragments(): Component {
  return (
    <layer w="fill" h="fill" onLoad={() => resetFragments()}>
      <layer x="center" y="center" w={480} h={314}>
        <FragmentsBorder />

        <CloseButton />

        <FiltersTab />
        <ClearFiltersButton />
        <PaneTab x={243} label="Passive Effects" pane={Pane.PASSIVE} action={TabAction.PASSIVE} />
        <PaneTab x={358} label="Active Effects" pane={Pane.ACTIVE} action={TabAction.ACTIVE} />
        <StoneTabButton
          x={414}
          y={41}
          w={54}
          h={51}
          op="Unequip all"
          optionSubject=""
          label="Unequip all"
          action={TabAction.ACTIVE}
        />

        <FragmentList />
        <FilterPanel />
        <FragmentDetail />
        <FragmentLoadout />
        <FragmentLoadoutIcons />

        <LeagueSwitcher />

        <layer w="fill" h="fill" hide />
      </layer>

      <DropdownPopup />
    </layer>
  );
}

function FragmentsBorder(): Component {
  const league = useServerState(Varbits.LEAGUE_TYPE);
  return <SteelBorder title="League Fragments" flags={1} titleColor={leagueColour(league)} />;
}

function FiltersTab(): Component {
  const [shown] = useState(fragmentFiltersShown);
  return (
    <StoneTabButton
      x={12}
      y={99}
      w={110}
      h={30}
      op={shown === 1 ? 'Hide' : 'Show'}
      optionSubject="<col=ff9040>Filters</col>"
      label={shown === 1 ? 'Hide Filters' : 'Show Filters'}
      action={TabAction.FILTERS}
    />
  );
}

function PaneTab({ x, label, pane, action }: { x: Int; label: String; pane: Int; action: Int }): Component {
  const [current] = useState(fragmentPane);
  return (
    <StoneTabButton
      x={x}
      y={99}
      w={110}
      h={30}
      selected={current === pane}
      op="View"
      optionSubject={`<col=ff9040>${label}</col>`}
      label={label}
      action={action}
    />
  );
}
