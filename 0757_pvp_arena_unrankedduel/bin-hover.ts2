import { sessionState, useState } from 'ts2';
import { BIN_LABEL } from '../lib/pvp-arena/loadout-chrome.component';
import {
  Build,
  Layout,
  SuppliesColor,
  SuppliesFonts,
} from '../0758_pvp_arena_stagingarea_supplies/pvp-arena-stagingarea-supplies.constants';

export const binHot = sessionState(-1);

export function binHover(build: Int, hot: Boolean): void {
  const [current, setHot] = useState(binHot);
  if (hot) {
    setHot(build);
    return;
  }
  if (current === build) {
    setHot(-1);
  }
}

export function BinLabelA(): Component {
  const [hot] = useState(binHot);
  return (
    <text
      x="right"
      y="center"
      w={{ fill: Layout.bin.textInset }}
      h="fill"
      color={hot === Build.MAX_MED ? SuppliesColor.WHITE : SuppliesColor.LABEL}
      font={SuppliesFonts.BODY}
      shadow
      align="center"
      valign="middle"
      text={BIN_LABEL}
    />
  );
}

