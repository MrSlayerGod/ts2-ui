export function medalSprite(league: Int): Sprite {
  if (league === 1) {
    return FirstsTableSprites.MEDAL_1;
  }
  if (league === 2) {
    return FirstsTableSprites.MEDAL_2;
  }
  if (league === 3) {
    return FirstsTableSprites.MEDAL_3;
  }
  if (league === 4) {
    return FirstsTableSprites.MEDAL_4;
  }
  if (league === 5) {
    return FirstsTableSprites.MEDAL_5;
  }
  return FirstsTableSprites.MEDAL_6;
}

export function blankSprite(league: Int): Sprite {
  if (league === 1) {
    return FirstsTableSprites.BLANK_1;
  }
  if (league === 2) {
    return FirstsTableSprites.BLANK_2;
  }
  if (league === 3) {
    return FirstsTableSprites.BLANK_3;
  }
  if (league === 4) {
    return FirstsTableSprites.BLANK_4;
  }
  if (league === 5) {
    return FirstsTableSprites.BLANK_5;
  }
  return FirstsTableSprites.BLANK_6;
}

