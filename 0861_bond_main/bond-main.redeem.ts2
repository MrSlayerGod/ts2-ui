  BOND_RIGHT = 67,
  ICON_LEFT = 5,
  LABEL_GAP = 2,
  WASH = 75,
  PRICE_COLOUR = 0xff981f,
  WARNING_COLOUR = 0xcfcfcf,
}

export enum RedeemLineStyle {
  COLOUR = 0xffb83f,
  LINE_H = 12,
  PAD = 5,
  GAP = 5,
}

