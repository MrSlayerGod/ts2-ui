export const redeemFinished = sessionState(0);

function modalOpen(): Boolean {
  return CS2.if_sub_has(gameframeSlot(GameframeSlot.VIEWPORT));
}

export function redeemLine(text: String): void {
  if (!modalOpen()) {
    return;
  }
  const [extent, setExtent] = useState(raidsScroll);
  const [count, setCount] = useState(raidsCount);
  const top: Int = extent + RedeemLineStyle.GAP;
  const height: Int = textLineCount(text, redeemWidth(), Fonts.B12_FULL) * RedeemLineStyle.LINE_H + RedeemLineStyle.PAD;
  if (count >= 0 && count < 8) {
    writeLine(count, text, top, height);
  }
  setCount(count + 1);
  setExtent(top + height);
}

function writeLine(line: Int, text: String, top: Int, height: Int): void {
  const [, setAt] = useState(redeemLineAt[line]);
  const [, setLen] = useState(redeemLineLen[line]);
  const [, setY] = useState(redeemLineY[line]);
  const [, setH] = useState(redeemLineH[line]);
  setAt(appendText(text));
  setLen(text.length);
  setY(top);
  setH(height);
}

function appendText(text: String): Int {
  const [all, setAll] = useState(redeemText);
  const at: Int = all.length;
  setAll(`${all}${text}`);
  return at;
}

export function redeemPiece(all: String, at: Int, length: Int): String {
  return all.substring(at, at + length);
}

export function redeemOption(
  slot: Int,
  price: Int,
  icon: Sprite,
  iconSize: Coord,
  label: String,
  warning: String,
): void {
  if (!modalOpen() || slot < 0 || slot >= 15) {
    return;
  }
  if (label.length <= 0) {
    hideOption(slot);
    return;
  }
  const [extent, setExtent] = useState(raidsScroll);
  let top: Int = extent;
  if (top > 0) {
    top = top + 1;
  }
  writeOption(slot, price, icon, iconSize, label, warning, top);
  setExtent(top + Layout.OPTION_H);
}

function hideOption(slot: Int): void {
  const [, setShown] = useState(redeemShown[slot]);
  setShown(0);
}

function writeOption(
  slot: Int,
  price: Int,
  icon: Sprite,
  iconSize: Coord,
  label: String,
  warning: String,
  top: Int,
): void {
  const [, setPrice] = useState(redeemPrice[slot]);
  const [, setIcon] = useState(redeemIcon[slot]);
  const [, setSize] = useState(redeemIconSize[slot]);
  const [, setLabelAt] = useState(redeemLabelAt[slot]);
  const [, setLabelLen] = useState(redeemLabelLen[slot]);
  const [, setWarningAt] = useState(redeemWarningAt[slot]);
  const [, setWarningLen] = useState(redeemWarningLen[slot]);
  const [, setWarned] = useState(redeemWarned[slot]);
  const [, setY] = useState(redeemY[slot]);
  const [, setShown] = useState(redeemShown[slot]);
  setPrice(price);
  setIcon(icon as Int);
  setSize(iconSize as Int);
  setLabelAt(appendText(label));
  setLabelLen(label.length);
  setWarningAt(appendText(warning));
  setWarningLen(warning.length);
  setWarned(warning.length > 0 ? 1 : 0);
  setY(top);
  setShown(1);
}

export function redeemFinish(): void {
  if (!modalOpen()) {
    return;
  }
  const [, setPoll] = useState(pollScroll);
  const [extent, setExtent] = useState(raidsScroll);
  const [, setFinished] = useState(redeemFinished);
  setPoll(0);
  if (extent > 0) {
    setExtent(extent + 1);
  }
  setFinished(1);
}

export function resetRedeem(): void {
  let slot: Int = 0;
  while (slot < 15) {
    hideOption(slot);
    slot = slot + 1;
  }
  const [, setFinished] = useState(redeemFinished);
  const [, setAll] = useState(redeemText);
  setFinished(0);
  setAll('');
}

export function affordable(tradeable: Int, untradeable: Int, price: Int): Boolean {
  let held: Int = 2147483647;
  if (2147483647 - tradeable >= untradeable) {
    held = tradeable + untradeable;
  }
  return held >= price;
}

export function priceText(price: Int): String {
  if (price > 1) {
    return `${price} bonds`;
  }
  if (price === 1) {
    return '1 bond';
  }
  return '---';
}

export function optionLabel(label: String): String {
  return replaceAll(label, '<br>', ' ');
}

export function redeemRefused(slot: Int): void {
  const [all] = useState(redeemText);
  const [at] = useState(redeemWarningAt[slot]);
  const [length] = useState(redeemWarningLen[slot]);
  const warning: String = redeemPiece(all, at, length);
  CS2.sound_effect(Sounds.PILLORY_WRONG, 1, 0);
  chatMessage(CS2.tags_remove(warning));
}
