import { useInterval, useRef, useState } from 'ts2';
import { closeInterface, graphicSwapper } from '../lib/lib.helpers';
import {
  sandwichTrayDrift,
  sandwichTraySeed,
  trayRoll0,
  trayRoll1,
  trayRoll2,
  trayRoll3,
  trayRoll4,
  trayRoll5,
  trayRoll6,
  trayYaw0,
  trayYaw1,
  trayYaw2,
  trayYaw3,
  trayYaw4,
  trayYaw5,
  trayYaw6,
} from './sandwich-tray.state';
import { CAPTION_TEXT, Drift, Layout, TrayColors, TrayFonts, TrayModels, TraySprites } from './sandwich-tray.constants';

export function SandwichTray(): Component {
  return (
    <>
      <model
        x={Layout.TRAY_X}
        y={Layout.TRAY_Y}
        w={Layout.TRAY_SIZE}
        h={Layout.TRAY_SIZE}
        model={TrayModels.TRAY}
        zoom={Layout.TRAY_ZOOM}
        pitch={Layout.TRAY_PITCH}
      />

      <text
        x={Layout.CAPTION_X}
        y={Layout.CAPTION_Y}
        w={Layout.CAPTION_W}
        h={Layout.CAPTION_H}
        text={CAPTION_TEXT}
        font={TrayFonts.LABEL}
        color={TrayColors.CAPTION}
        align="center"
        shadow
      />

      <sprite
        x={Layout.CLOSE_X}
        y={Layout.CLOSE_Y}
        w={Layout.CLOSE_W}
        h={Layout.CLOSE_H}
        sprite={TraySprites.CLOSE}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
        onMouseRepeat={(event) => graphicSwapper(event.component, TraySprites.CLOSE_HOVER)}
        onMouseLeave={(event) => graphicSwapper(event.component, TraySprites.CLOSE)}
      />

      <layer x={0} y={0} w={Layout.CARD_W} h={Layout.CARD_H} hide>
        <rect x={0} y={0} w={Layout.CARD_W} h={Layout.CARD_H} fill color={TrayColors.CARD} />

        <model x={7} y={122} w={70} h={69} model={TrayModels.BAGUETTE} zoom={500} pitch={233} yaw={2036} />
        <model x={11} y={179} w={74} h={70} model={TrayModels.TRIANGLE_SANDWICH} zoom={500} pitch={260} yaw={2000} />
        <model x={12} y={235} w={74} h={71} model={TrayModels.SQUARE_SANDWICH} zoom={500} pitch={244} yaw={2024} />
        <model x={7} y={282} w={73} h={71} model={TrayModels.ROLL} zoom={500} pitch={236} yaw={2041} />
        <model x={10} y={-2} w={67} h={68} model={TrayModels.MEAT_PIE} zoom={500} pitch={249} yaw={2020} />
        <model x={4} y={36} w={74} h={71} model={TrayModels.KEBAB} zoom={500} pitch={339} yaw={2017} />
        <model x={3} y={72} w={75} h={71} model={TrayModels.CHOCOLATE_BAR} zoom={500} pitch={281} yaw={2034} />

        <text
          x={Layout.NAME_X}
          y={18}
          w={Layout.NAME_W}
          h={Layout.NAME_H}
          text="Meat Pie"
          font={TrayFonts.LABEL}
          color={TrayColors.LABEL}
          shadow
        />
        <text
          x={Layout.NAME_X}
          y={62}
          w={Layout.NAME_W}
          h={Layout.NAME_H}
          text="Kebab"
          font={TrayFonts.LABEL}
          color={TrayColors.LABEL}
          shadow
        />
        <text
          x={Layout.NAME_X}
          y={102}
          w={Layout.NAME_W}
          h={Layout.NAME_H}
          text="Chocolate Bar"
          font={TrayFonts.LABEL}
          color={TrayColors.LABEL}
          shadow
        />
        <text
          x={Layout.NAME_X}
          y={152}
          w={Layout.NAME_W}
          h={Layout.NAME_H}
          text="Baguette"
          font={TrayFonts.LABEL}
          color={TrayColors.LABEL}
          shadow
        />
        <text
          x={Layout.NAME_X}
          y={205}
          w={Layout.NAME_W}
          h={Layout.NAME_H}
          text="Triangle Sandwich"
          font={TrayFonts.LABEL}
          color={TrayColors.LABEL}
          shadow
        />
        <text
          x={Layout.NAME_X}
          y={260}
          w={Layout.NAME_W}
          h={Layout.NAME_H}
          text="Square Sandwich"
          font={TrayFonts.LABEL}
          color={TrayColors.LABEL}
          shadow
        />

        <text
          x={Layout.BACK_X}
          y={Layout.BACK_Y}
          w={Layout.BACK_SIZE}
          h={Layout.BACK_SIZE}
          text="Back"
          font={TrayFonts.BACK}
          color={TrayColors.BACK}
          shadow
        />

        <text
          x={Layout.NAME_X}
          y={303}
          w={Layout.NAME_W}
          h={Layout.NAME_H}
          text="Roll"
          font={TrayFonts.LABEL}
          color={TrayColors.LABEL}
          shadow
        />

        <text
          x={Layout.CARD_HIT_X}
          y={Layout.CARD_HIT_Y}
          w={Layout.CARD_HIT_W}
          h={Layout.CARD_HIT_H}
          font={TrayFonts.LABEL}
          color={TrayColors.LABEL}
          shadow
          options={['Back']}
        />
      </layer>

      <layer
        x={Layout.TRAY_LAYER_X}
        y={Layout.TRAY_LAYER_Y}
        w={Layout.TRAY_LAYER_W}
        h={Layout.TRAY_LAYER_H}
        onLoad={() => sandwichTraySeed()}
      >
        <TrayRefreshments />

        <text
          x={Layout.KEY_X}
          y={Layout.KEY_Y}
          w={Layout.KEY_SIZE}
          h={Layout.KEY_SIZE}
          text="Key"
          font={TrayFonts.LABEL}
          color={TrayColors.LABEL}
          align="center"
          valign="middle"
          shadow
          options={['Show key']}
        />
      </layer>
    </>
  );
}

function TrayRefreshments(): Component {
  const [yaw0] = useState(trayYaw0);
  const [yaw1] = useState(trayYaw1);
  const [yaw2] = useState(trayYaw2);
  const [yaw3] = useState(trayYaw3);
  const [yaw4] = useState(trayYaw4);
  const [yaw5] = useState(trayYaw5);
  const [yaw6] = useState(trayYaw6);
  const [roll0] = useState(trayRoll0);
  const [roll1] = useState(trayRoll1);
  const [roll2] = useState(trayRoll2);
  const [roll3] = useState(trayRoll3);
  const [roll4] = useState(trayRoll4);
  const [roll5] = useState(trayRoll5);
  const [roll6] = useState(trayRoll6);
  const self = useRef();
  useInterval(() => sandwichTrayDrift(), self);
  return (
    <layer ref={self} w="fill" h="fill">
      <model
        x={16}
        y={120}
        w={70}
        h={69}
        model={TrayModels.BAGUETTE}
        zoom={Drift.ZOOM}
        pitch={Drift.PITCH}
        yaw={yaw0}
        roll={roll0}
        options={['Pick refreshment']}
      />
      <model
        x={108}
        y={120}
        w={74}
        h={70}
        model={TrayModels.TRIANGLE_SANDWICH}
        zoom={Drift.ZOOM}
        pitch={Drift.PITCH}
        yaw={yaw1}
        roll={roll1}
        options={['Pick refreshment']}
      />
      <model
        x={204}
        y={119}
        w={74}
        h={71}
        model={TrayModels.SQUARE_SANDWICH}
        zoom={Drift.ZOOM}
        pitch={Drift.PITCH}
        yaw={yaw2}
        roll={roll2}
        options={['Pick refreshment']}
      />
      <model
        x={295}
        y={118}
        w={73}
        h={71}
        model={TrayModels.ROLL}
        zoom={Drift.ZOOM}
        pitch={Drift.PITCH}
        yaw={yaw3}
        roll={roll3}
        options={['Pick refreshment']}
      />
      <model
        x={57}
        y={30}
        w={67}
        h={68}
        model={TrayModels.MEAT_PIE}
        zoom={Drift.ZOOM}
        pitch={Drift.PITCH}
        yaw={yaw4}
        roll={roll4}
        options={['Pick refreshment']}
      />
      <model
        x={157}
        y={28}
        w={74}
        h={71}
        model={TrayModels.KEBAB}
        zoom={Drift.ZOOM}
        pitch={Drift.PITCH}
        yaw={yaw5}
        roll={roll5}
        options={['Pick refreshment']}
      />
      <model
        x={260}
        y={29}
        w={75}
        h={71}
        model={TrayModels.CHOCOLATE_BAR}
        zoom={Drift.ZOOM}
        pitch={Drift.PITCH}
        yaw={yaw6}
        roll={roll6}
        options={['Pick refreshment']}
      />
    </layer>
  );
}
