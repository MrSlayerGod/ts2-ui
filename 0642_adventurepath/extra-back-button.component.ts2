import { useState } from 'ts2';

import { playSound } from '../lib/lib.engine';
import { StoneButtonOutFilled } from '../lib/stone-button-out-filled.component';
import { StoneButtonPressedFilled } from '../lib/stone-button-pressed-filled.component';
import { adventurePathChangePage } from './adventurepath.builders';
import { Colour, Font, Sound } from './adventurepath.constants';

export function ExtraBackButton(): Component {
  const [pressed, setPressed] = useState(0);
  return (
    <layer
      w="fill"
      h="fill"
      options={['Back']}
      onMouseRepeat={() => setPressed(1)}
      onMouseLeave={() => setPressed(0)}
      onOptionSelect={() => {
        playSound(Sound.SELECT);
        adventurePathChangePage(1);
      }}
    >
      {pressed === 1 ? <StoneButtonPressedFilled /> : <StoneButtonOutFilled />}
      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        text="<lt><lt>   Back"
        font={Font.P12_FULL}
        shadow
        color={Colour.CAPTION}
        align="center"
        valign="middle"
      />
    </layer>
  );
}
