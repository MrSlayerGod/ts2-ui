export function attackStyleName(index: Int): String {
  if (index === 1) return 'Accurate';
  if (index === 2) return 'Aggressive';
  if (index === 3) return 'Controlled';
  if (index === 4) return 'Defensive';
  if (index === 5) return 'Ranging';
  if (index === 6) return 'Longrange';
  if (index === 7) return 'Casting';
  return 'Other';
}
