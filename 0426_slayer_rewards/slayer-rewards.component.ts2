import { useRef, useState } from 'ts2';

import { playSound } from '../lib/lib.engine';
import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { SteelFrameEntrypoint } from '../lib/steel-frame-entrypoint.component';
import { slayerRewardsTabLastOpened } from '../lib/game/varcs';
import {
  ConfirmCodes,
  Ink,
  PANEL_TITLE,
  Panel,
  SlayerFonts,
  SlayerSounds,
  SlayerSprites,
  Tab,
  TAB_BUY,
  TAB_COSMETICS,
  TAB_EXTEND,
  TAB_TASKS,
  TAB_UNLOCK,
} from './slayer-rewards.constants';
import { UnlockList } from './unlock-list.component';
import { UnlockList as UnlockSlice } from './slayer-rewards.data';
import { pointsLine } from './slayer-rewards.helpers';
import { BuyPane } from './buy-grid.component';
import { TasksPane } from './tasks-pane.component';
import {
  Confirm,
  confirmBack,
  confirmBackLater,
  confirmCode,
  confirmInfo,
  confirmLabel,
  confirmShown,
  confirmSubject,
  resetConfirm,
} from './slayer-rewards.confirm';

export function SlayerRewards(): Component {
  return (
    <>
      <SteelBorderEntrypoint title={PANEL_TITLE} />

      <ConfirmDialog />

      <layer x={0} y={0} w="fill" h="fill" onLoad={() => resetConfirm()}>
        <ConfirmHits />
      </layer>

      <MainPanel />

      <layer x="center" y="center" w="fill" h="fill" />
    </>
  );
}

function ConfirmHits(): Component {
  const [shown] = useState(confirmShown);
  const [code] = useState(confirmCode);
  const label: String = confirmLabel(code);
  const subject: String = confirmSubject(code);
  return (
    <>
      {ConfirmCodes.map(
        (index) =>
          index <= code &&
          shown === Confirm.SHOWN_DIALOG && (
            <rect
              x={Confirm.HIT_X}
              y={Confirm.HIT_Y}
              w={Confirm.HIT_W}
              h={Confirm.HIT_H}
              color={0}
              fill
              transparency={255}
              hide={index < code}
              options={index === code ? [label] : []}
              optionSubject={subject}
              onOptionSelect={index === code ? (event) => confirmBack(true, event.option) : null}
            />
          ),
      )}
    </>
  );
}

function ConfirmDialog(): Component {
  const [shown] = useState(confirmShown);
  const [info] = useState(confirmInfo);
  const [code] = useState(confirmCode);
  return (
    <layer x="center" y={{ center: 15 }} w={268} h={200} hide={shown === Confirm.SHOWN_NONE}>
      <sprite x={1} y={1} w={266} h={198} sprite={SlayerSprites.DIALOG_BACK} tiling />
      <text
        x={10}
        y={10}
        w={248}
        h={155}
        text={info}
        font={SlayerFonts.DIALOG}
        color={Ink.DIALOG}
        shadow
        align="center"
        valign="middle"
      />
      <DialogButton
        x={code === Confirm.NONE ? Confirm.BACK_X_ALONE : Confirm.BACK_X}
        label="Back"
        option={shown === Confirm.SHOWN_DIALOG ? 'Back' : ''}
        onBack={shown === Confirm.SHOWN_DIALOG}
      />
      <ConfirmButton shown={shown} code={code} />
      <SteelFrameEntrypoint />
    </layer>
  );
}

function MainPanel(): Component {
  const [lastOpened] = useState(slayerRewardsTabLastOpened);
  const tab: Int = lastOpened >= Tab.UNLOCK && lastOpened <= Tab.COSMETICS ? lastOpened : Tab.UNLOCK;
  const [shown] = useState(confirmShown);
  return (
    <layer
      x="center"
      y={{ bottom: Panel.MAIN_BOTTOM }}
      hide={shown !== Confirm.SHOWN_NONE}
      w={{ fill: Panel.MAIN_W_INSET }}
      h={{ fill: Panel.MAIN_H_INSET }}
    >
      <layer x={0} y={0} w={Panel.TABS_W} h={Panel.TABS_H}>
        <TabButton slot={Tab.UNLOCK} label={TAB_UNLOCK} tab={tab} />
        <TabButton slot={Tab.EXTEND} label={TAB_EXTEND} tab={tab} />
        <TabButton slot={Tab.BUY} label={TAB_BUY} tab={tab} />
        <TabButton slot={Tab.TASKS} label={TAB_TASKS} tab={tab} />
        <TabButton slot={Tab.COSMETICS} label={TAB_COSMETICS} tab={tab} />
        <text
          x="right"
          y={0}
          w={{ fill: Tab.STRIDE * 5 }}
          h="fill"
          text={pointsLine()}
          font={SlayerFonts.SMALL}
          color={Ink.AMBER}
          shadow
          align="center"
          valign="middle"
        />
      </layer>

      <layer x={0} y={Panel.BODY_Y} w="fill" h={{ fill: Panel.BODY_H_INSET }}>
        <layer x="center" y="center" w="fill" h="fill" hide={tab !== Tab.UNLOCK}>
          <UnlockList from={UnlockSlice.UNLOCK_FROM} count={UnlockSlice.UNLOCK_COUNT} inset={0} />
        </layer>

        <layer x="center" y="center" w="fill" h="fill" hide={tab !== Tab.EXTEND}>
          <UnlockList from={UnlockSlice.EXTEND_FROM} count={UnlockSlice.EXTEND_COUNT} inset={Panel.EXTEND_H_INSET} />
          <layer x="center" y="bottom" w="fill" h={20} />
        </layer>

        <layer x="center" y="center" w="fill" h="fill" hide={tab !== Tab.BUY}>
          <BuyPane />
        </layer>

        <layer x="center" y="center" w="fill" h="fill" hide={tab !== Tab.TASKS}>
          <TasksPane />
        </layer>

        <layer x="center" y="center" w="fill" h="fill" hide={tab !== Tab.COSMETICS}>
          <UnlockList from={UnlockSlice.COSMETIC_FROM} count={UnlockSlice.COSMETIC_COUNT} inset={0} />
        </layer>
      </layer>
    </layer>
  );
}

function TabButton({ slot, label, tab }: { slot: Int; label: String; tab: Int }): Component {
  const text = useRef();
  const selected: Boolean = slot === tab;

  return (
    <>
      <sprite
        x={slot * Tab.STRIDE}
        y={0}
        w={Tab.W}
        h={Tab.H}
        sprite={selected ? SlayerSprites.TAB_ON : SlayerSprites.TAB}
        options={selected ? undefined : [label]}
        onOptionSelect={selected ? null : () => openTab(slot)}
        onMouseEnter={
          selected
            ? null
            : () => {
                text.color = Ink.WHITE;
              }
        }
        onMouseLeave={
          selected
            ? null
            : () => {
                text.color = Ink.AMBER;
              }
        }
      />
      <text
        ref={text}
        x={slot * Tab.STRIDE}
        y={0}
        w={Tab.W}
        h={Tab.H}
        text={label}
        font={SlayerFonts.SMALL}
        color={Ink.AMBER}
        shadow
        align="center"
        valign="middle"
      />
    </>
  );
}

function openTab(slot: Int): void {
  const [, setTab] = useState(slayerRewardsTabLastOpened);
  playSound(SlayerSounds.SELECT);
  setTab(slot);
}

function ConfirmButton({ shown, code }: { shown: Int; code: Int }): Component {
  const text = useRef();

  return (
    <layer
      x={150}
      y={165}
      w={85}
      h={22}
      hide={code === Confirm.NONE}
      onMouseEnter={() => {
        text.color = Ink.WHITE;
      }}
      onMouseLeave={() => {
        text.color = Ink.DIALOG;
      }}
      onTimer={shown === Confirm.SHOWN_REQUESTING ? () => confirmBackLater() : null}
    >
      <sprite x={0} y={0} w={85} h={22} sprite={SlayerSprites.DIALOG_BUTTON} />
      <text
        ref={text}
        x={0}
        y={0}
        w={85}
        h={22}
        text="Confirm"
        font={SlayerFonts.BUTTON}
        color={Ink.DIALOG}
        shadow
        align="center"
        valign="middle"
      />
    </layer>
  );
}

function DialogButton({
  x,
  label,
  option,
  onBack,
}: {
  x: Int;
  label: String;
  option: String;
  onBack: Boolean;
}): Component {
  const text = useRef();

  return (
    <layer
      x={x}
      y={165}
      w={85}
      h={22}
      options={[option]}
      onOptionSelect={onBack ? (event) => confirmBack(false, event.option) : null}
      onMouseEnter={() => {
        text.color = Ink.WHITE;
      }}
      onMouseLeave={() => {
        text.color = Ink.DIALOG;
      }}
    >
      <sprite x={0} y={0} w={85} h={22} sprite={SlayerSprites.DIALOG_BUTTON} />
      <text
        ref={text}
        x={0}
        y={0}
        w={85}
        h={22}
        text={label}
        font={SlayerFonts.BUTTON}
        color={Ink.DIALOG}
        shadow
        align="center"
        valign="middle"
      />
    </layer>
  );
}
