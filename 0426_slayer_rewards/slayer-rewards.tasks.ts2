export function blockedByMaster(task: Int, master: Int): Boolean {
  let slot: Int = 1;
  while (slot <= 7) {
    if (task === blockedTask(master, slot)) {
      return true;
    }
    slot = slot + 1;
  }
  return false;
}

export function blockedTaskName(task: Int): String {
  if (task === -1) {
    return "Kree'arra";
  }
  return slayerTaskName(task, -1);
}
