import { useServerState } from 'ts2';

import { Varbits } from '../lib/game/varbits';
import { slayerTaskName } from '../0711_helper_generic/helper-slayer.state';

export function blockCost(master: Int): Int {
  switch (master) {
    case 1:
      return 40;
    case 9:
      return 40;
    case 2:
      return 50;
    case 3:
      return 60;
    case 4:
      return 70;
    case 5:
      return 100;
    case 6:
      return 90;
    case 7:
      return 100;
    case 8:
      return 80;
  }
  return 100;
}

export function blockedTask(master: Int, slot: Int): Int {
  switch (master) {
    case 1:
      return blockedTurael(slot);
    case 9:
      return blockedTurael(slot);
    case 2:
      return blockedMazchna(slot);
    case 3:
      return blockedVannaka(slot);
    case 4:
      return blockedChaeldar(slot);
    case 5:
      return blockedDuradel(slot);
    case 6:
      return blockedNieve(slot);
    case 7:
      return blockedKrystilia(slot);
    case 8:
      return blockedKonar(slot);
  }
  return -1;
}

function blockedTurael(slot: Int): Int {
  switch (slot) {
    case 1:
      return useServerState(Varbits.SLAYER_BLOCKED_TURAEL_1);
    case 2:
      return useServerState(Varbits.SLAYER_BLOCKED_TURAEL_2);
    case 3:
      return useServerState(Varbits.SLAYER_BLOCKED_TURAEL_3);
    case 4:
      return useServerState(Varbits.SLAYER_BLOCKED_TURAEL_4);
    case 5:
      return useServerState(Varbits.SLAYER_BLOCKED_TURAEL_5);
    case 6:
      return useServerState(Varbits.SLAYER_BLOCKED_TURAEL_6);
    case 7:
      return useServerState(Varbits.SLAYER_BLOCKED_TURAEL_DIARY);
  }
  return -1;
}

