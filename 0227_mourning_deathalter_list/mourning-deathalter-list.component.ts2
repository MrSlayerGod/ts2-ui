import { closeInterface } from '../lib/lib.helpers';
import { CloseSprites, ListFonts, ListModels } from './mourning-deathalter-list.constants';
import {
  LIST_CONTAINER,
  LIST_SCROLLBAR,
  LIST_TEXT,
  mourningDeathalterListInit,
} from './mourning-deathalter-list.state';

export function NeededItemsList(): Component {
  return (
    <layer w={512} h={334} onLoad={() => mourningDeathalterListInit()}>
      <layer x={37} y={37} w={387} h={287}>
        <model x={163} y={79} w={55} h={81} model={ListModels.BACKDROP} zoom={643} pitch={510} />
      </layer>

      <text x={53} y={56} w={297} h={17} text="List of needed items:" font={ListFonts.TITLE} />

      <layer static ref={LIST_CONTAINER} x={48} y={80} w={326} h={215}>
        <text static ref={LIST_TEXT} w="fill" h="fill" text="" font={ListFonts.LIST} align="center" />
      </layer>

      <layer static ref={LIST_SCROLLBAR} x={383} y={80} w={16} h={218} />

      <sprite
        x={378}
        y={53}
        w={26}
        h={23}
        sprite={CloseSprites.DEFAULT}
        hover={{ sprite: CloseSprites.HOVER }}
        options={['Close']}
        onOptionSelect={() => closeInterface()}
      />
    </layer>
  );
}
