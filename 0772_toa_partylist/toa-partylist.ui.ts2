import { BoardAnchors } from '../lib/board-button.component';
import { boardAnchorsRef, Layout, toaPartylistRef, tooltipRef } from './toa-partylist.constants';
import { ToaPanelResizer, ToaPartylist } from './toa-partylist.component';

export const toaPartylistUi = (): UI => (
  <ui ref={toaPartylistRef} x="center" y="center">
    <ToaPanelResizer />
    <ToaPartylist />
    <ToaPartylistTooltipAnchor />
    <layer ref={boardAnchorsRef} x={0} y={0} w={0} h={0}>
      <BoardAnchors universe={boardAnchorsRef} count={3} />
    </layer>
  </ui>
);

function ToaPartylistTooltipAnchor(): Component {
  return <layer ref={tooltipRef} x={0} y={0} w={Layout.TOOLTIP} h={Layout.TOOLTIP} />;
}
