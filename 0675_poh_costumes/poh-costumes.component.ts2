import { CS2, intArray, useInventory, useOnResize, useState, useUniverse } from 'ts2';

import { Inventories } from '../lib/game/inventories';
import { pohCostumeRoomScroll } from '../lib/game/varcs';
import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { CostumeItem, CostumeSet } from './costume-grid.component';
import { DepositAllButton, ModeButton, SearchButton, TierButton } from './costume-buttons.component';
import {
  CostumeAlternates,
  CostumeCategories,
  CostumeCategory,
  CostumeEntries,
  CostumeEntry,
  CostumePiece,
  CostumePieces,
} from './poh-costumes.data';
import { countMembers, entryHasAlternates } from './poh-costumes.helpers';
import { costumeCanSet, costumeCategory } from './poh-costumes.state';
import {
  Grid,
  Layout,
  MAX_BORDERS,
  MAX_ITEMS,
  MAX_SETS,
  OtherInventory,
  Scrollbar,
  SetArt,
  SetMode,
  SetState,
  itemsRef,
} from './poh-costumes.constants';

export function PohCostumes(): Component {
  const root = useUniverse();
  useOnResize(root);
  const [category] = useState(costumeCategory);
  const [canSetCell] = useState(costumeCanSet);
  const [remembered] = useState(pohCostumeRoomScroll);
  const store = useInventory(Inventories.POH_COSTUMES);
  const storeSize: Int = store.size;
  const canSet: Boolean = canSetCell === 1;

  const room: CostumeCategory | null = CostumeCategories.at(category);
  const opened: Boolean = room !== null && storeSize >= 0;
  const title: String = room === null ? '' : room.title;
  const first: Int = room === null ? 0 : room.first;
  const count: Int = room === null ? 0 : room.count;

  let font: Font = SetArt.TITLE_P12;
  let alternates: Boolean = false;
  let k: Int = 0;
  while (k < count) {
    const entry: CostumeEntry | null = CostumeEntries.at(first + k);
    const name: String = entry === null ? '' : entry.name;
    if (font === SetArt.TITLE_P12 && CS2.parawidth(name, Grid.MEASURE_W, SetArt.TITLE_P12) > Grid.TITLE_FIT) {
      font = SetArt.TITLE_P11;
    }
    if (entryHasAlternates(first + k)) {
      alternates = true;
    }
    k = k + 1;
  }

  const mode = intArray(MAX_SETS);
  k = 0;
  while (k < count) {
    if (k + 1 >= count || countMembers(first + k) > Grid.SHARE_MAX || countMembers(first + k + 1) > Grid.SHARE_MAX) {
      mode[k] = SetMode.BIG;
      k = k + 1;
    } else {
      mode[k] = SetMode.LEFT;
      mode[k + 1] = SetMode.RIGHT;
      k = k + 2;
    }
  }

  const setTop = intArray(MAX_SETS);
  const setHeight = intArray(MAX_SETS);
  const setState = intArray(MAX_SETS);
  const setDivider = intArray(MAX_SETS);
  const slotItem = intArray<Item>(MAX_ITEMS);
  const slotCount = intArray(MAX_ITEMS);
  const slotX = intArray(MAX_ITEMS);
  const slotY = intArray(MAX_ITEMS);
  const borderTop = intArray(MAX_BORDERS);
  const borderHeight = intArray(MAX_BORDERS);
  let slots: Int = 0;
  let borders: Int = 0;
  let complete: Int = 0;
  let y: Int = 0;
  k = 0;
  while (k < count) {
    const entry: CostumeEntry | null = CostumeEntries.at(first + k);
    const pieceFirst: Int = entry === null ? 0 : entry.pieceFirst;
    const pieceCount: Int = entry === null ? 0 : entry.pieceCount;
    const setMode: Int = mode[k];
    const columns: Int = setMode === SetMode.BIG ? Grid.BIG_COLUMNS : Grid.SMALL_COLUMNS;
    const inset: Int = setMode === SetMode.RIGHT ? Grid.INSET + Grid.HALF : Grid.INSET;
    let column: Int = 0;
    let row: Int = 0;
    let used: Int = 0;
    let anyHeld: Boolean = false;
    let everyHeld: Boolean = true;

    let p: Int = 0;
    while (p < pieceCount) {
      const piece: CostumePiece | null = CostumePieces.at(pieceFirst + p);
      const base: Item = piece === null ? -1 : piece.item;
      const altFirst: Int = piece === null ? 0 : piece.altFirst;
      const altCount: Int = piece === null ? 0 : piece.altCount;
      const single: Item = piece === null ? -1 : piece.single;
      const exclusiveFlag: Int = piece === null ? 0 : piece.exclusive;
      const exclusive: Boolean = exclusiveFlag === 1;
      let tries: Int = altCount;
      if (altCount === 0 && single !== -1) {
        tries = 1;
      }
      let held: Boolean = false;
      let stop: Boolean = false;
      let t: Int = 0;
      while (t <= tries && !stop) {
        let item: Item = base;
        if (t < tries) {
          item = altCount > 0 ? (CostumeAlternates.at(altFirst + altCount - 1 - t) ?? -1) : single;
        }
        const n: Int = CS2.invother_total(OtherInventory.POH_COSTUMES, item);
        let action: Int = -1;
        if (t < tries) {
          if (n > 0) {
            action = 1;
            held = true;
            if (exclusive) {
              stop = true;
            }
          } else if (!exclusive) {
            action = 0;
          }
        } else if (!held || n > 0) {
          action = 1;
          if (n > 0) {
            held = true;
          }
        } else {
          action = 0;
        }
        if (action !== -1 && used < Grid.SLOT_LIMIT) {
          if (action === 1) {
            slotItem[slots] = item;
            slotCount[slots] = n;
            slotX[slots] = inset + Grid.STEP_X * column;
            slotY[slots] = y + Grid.TITLE_H + Grid.STEP_Y * row;
            slots = slots + 1;
            column = column + 1;
            if (column >= columns) {
              column = 0;
              row = row + 1;
            }
          }
          used = used + 1;
        }
        t = t + 1;
      }
      if (held) {
        anyHeld = true;
      } else {
        everyHeld = false;
      }
      p = p + 1;
    }

    let height: Int = Grid.TITLE_H + Grid.STEP_Y * row;
    if (column > 0) {
      height = height + Grid.STEP_Y;
    }
    setTop[k] = y;
    setHeight[k] = height;
    setState[k] = everyHeld ? SetState.COMPLETE : (anyHeld ? SetState.SOME : SetState.NONE);
    if (everyHeld) {
      complete = complete + 1;
    }
    setDivider[k] = -1;
    if (setMode === SetMode.BIG) {
      y = y + height;
      if (k < count - 1) {
        y = y + Grid.GAP;
        setDivider[k] = y - Grid.TITLE_H;
      }
    } else if (setMode === SetMode.LEFT) {
      if (k < count - 2) {
        setDivider[k] = y + height + Grid.GAP - Grid.TITLE_H;
      }
      borderTop[borders] = y;
      borderHeight[borders] = height;
      borders = borders + 1;
    } else if (k < count - 1) {
      y = y + height + Grid.GAP;
      setDivider[k] = y - Grid.TITLE_H;
    } else {
      y = y + height;
    }
    k = k + 1;
  }

  let filler: Int = -1;
  if (opened && y < Grid.FILL_TO) {
    filler = y + Grid.GAP - Grid.TITLE_H;
    y = y + Math.max(Grid.FILL_MIN, Grid.FILL_TO - y);
  }
  const extent: Int = y;
  const panelH: Int = opened
    ? Math.min(Math.min(Grid.PANEL_MAX_H, extent + Grid.PANEL_CHROME), root.height - Grid.ROOT_SLACK)
    : root.height - Layout.UNIVERSE_H_INSET;
  const paneH: Int = panelH - Grid.PANE_CHROME;
  const scrollHeight: Int = opened && extent > paneH ? extent : 0;
  const scrollY: Int = scrollHeight > 0 ? Math.clamp(0, extent - paneH, remembered) : 0;

  return (
    <layer x="center" y="center" w={Layout.UNIVERSE_W} h={panelH}>
      <layer x="center" y="center" w="fill" h="fill">
        {opened && <SteelBorderEntrypoint title={`${title} (${complete} / ${count})`} />}
      </layer>

      <layer
        x={Layout.ITEMS_BOX_X}
        y={{ bottom: Layout.ITEMS_BOX_BOTTOM }}
        w={{ fill: Layout.ITEMS_BOX_W_INSET }}
        h={{ fill: Layout.ITEMS_BOX_H_INSET }}
      >
        <layer
          ref={itemsRef}
          x={Layout.ITEMS_X}
          y="center"
          w={{ fill: Layout.ITEMS_W_INSET }}
          h={{ fill: Layout.ITEMS_H_INSET }}
          scrollHeight={scrollHeight}
          scrollY={scrollY}
        >
          {setTop.map(
            (top, index) =>
              index < count && (
                <CostumeSet
                  mode={mode[index]}
                  top={top}
                  height={setHeight[index]}
                  state={setState[index]}
                  divider={setDivider[index]}
                  entryAt={first + index}
                  font={font}
                  canSet={canSet}
                />
              ),
          )}
          {slotItem.map(
            (item, index) =>
              index < slots && (
                <CostumeItem item={item} count={slotCount[index]} x={slotX[index]} y={slotY[index]} canSet={canSet} />
              ),
          )}
          {borderTop.map(
            (top, index) =>
              index < borders && (
                <sprite
                  x={Grid.HALF - Grid.BORDER_W}
                  y={top}
                  w={Grid.BORDER_W}
                  h={borderHeight[index]}
                  sprite={SetArt.BORDER}
                  tiling
                />
              ),
          )}
          {filler !== -1 && <sprite x={0} y={filler} w={Grid.W} h={Grid.TITLE_H} sprite={SetArt.DIVIDER} tiling />}
        </layer>
        <layer
          x={{ right: Layout.SCROLLBAR_RIGHT }}
          y="center"
          w={Layout.SCROLLBAR_W}
          h={{ fill: Layout.SCROLLBAR_H_INSET }}
        >
          {opened && (
            <ScrollbarVertical
              content={itemsRef}
              track={Scrollbar.TRACK}
              capTopSprite={Scrollbar.CAP_TOP}
              thumbSprite={Scrollbar.THUMB}
              capBottomSprite={Scrollbar.CAP_BOTTOM}
              arrowUp={Scrollbar.ARROW_UP}
              arrowDown={Scrollbar.ARROW_DOWN}
              rebuilt
            />
          )}
        </layer>
        <ThinBoxEntrypoint />
      </layer>

      <layer
        x={{ right: Layout.BUTTONS_RIGHT }}
        y={{ bottom: Layout.BUTTONS_BOTTOM }}
        w={Layout.BUTTONS_W}
        h={{ fill: Layout.BUTTONS_H_INSET }}
      >
        <TierButton opened={opened} bottom={canSet && alternates ? Layout.TIER_BOTTOM : Layout.MODE_BOTTOM} />
        <ModeButton opened={opened} shown={canSet && alternates} />
        <SearchButton opened={opened} />
        <DepositAllButton opened={opened} />
      </layer>
    </layer>
  );
}
