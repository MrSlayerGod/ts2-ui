import { createRef } from 'ts2';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { Layout, ViewerColor, ViewerFonts } from './deadman-tournament-viewer.constants';
import { RefreshButton } from './refresh-button.component';
import { TournamentNames } from './tournament-names.component';

const survivorsRef = createRef('deadman_tournament_viewer_survivors');
const fogRef = createRef('deadman_tournament_viewer_fog');

export function DeadmanTournamentViewer(): Component {
  return (
    <>
      <text
        x="center"
        y={0}
        w="fill"
        h={Layout.TITLE_H}
        text="Tournament Viewer"
        font={ViewerFonts.TITLE}
        color={ViewerColor.LABEL}
        shadow
        align="center"
        valign="middle"
      />

      <layer x="center" y={Layout.LIST_Y} w={Layout.LIST_W} h={Layout.LIST_H}>
        <layer x="center" y="center" w={{ fill: Layout.NAMES_INSET }} h={{ fill: Layout.NAMES_INSET }}>
          <TournamentNames />
        </layer>

        <ThinBoxEntrypoint />
      </layer>

      <text
        x={Layout.CAPTION_X}
        y={{ bottom: Layout.ROW_1_BOTTOM }}
        w={Layout.CAPTION_W}
        h={Layout.ROW_H}
        text="Survivors:"
        font={ViewerFonts.BODY}
        color={ViewerColor.LABEL}
        shadow
        valign="middle"
      />

      <text
        x={Layout.CAPTION_X}
        y={{ bottom: Layout.ROW_2_BOTTOM }}
        w={Layout.CAPTION_W}
        h={Layout.ROW_H}
        text="Fog status:"
        font={ViewerFonts.BODY}
        color={ViewerColor.LABEL}
        shadow
        valign="middle"
      />

      <text
        ref={survivorsRef}
        x={{ right: Layout.VALUE_RIGHT }}
        y={{ bottom: Layout.ROW_1_BOTTOM }}
        w={{ fill: Layout.VALUE_W_INSET }}
        h={Layout.ROW_H}
        font={ViewerFonts.BODY}
        color={ViewerColor.VALUE}
        shadow
        valign="middle"
      />

      <text
        ref={fogRef}
        x={{ right: Layout.VALUE_RIGHT }}
        y={{ bottom: Layout.ROW_2_BOTTOM }}
        w={{ fill: Layout.VALUE_W_INSET }}
        h={Layout.ROW_H}
        font={ViewerFonts.BODY}
        color={ViewerColor.VALUE}
        shadow
        valign="middle"
      />

      <layer x="center" y={{ bottom: Layout.BUTTON_BOTTOM }} w={Layout.BUTTON_W} h={Layout.BUTTON_H} options={['*']}>
        <RefreshButton />
      </layer>
    </>
  );
}
