import { CS2, onMounted, onUpdated, useDerived, useInterval, useRef, useServerState, useState } from 'ts2';

import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { Varbits } from '../lib/game/varbits';
import { tobClientLastprogress } from '../lib/game/varcs';
import {
  Layout,
  PartyStatus,
  Progress,
  TobHudColor,
  TobHudFonts,
  WaveProgress,
  hudRef,
  middleDodgerRef,
  progressRef,
} from './tob-hud.constants';
import {
  inTobRaid,
  stepWaveProgress,
  stripIsShare,
  stripReserve,
  waveProportion,
  waveTenths,
  wavePercentText,
} from './tob-hud.state';

function fillWidth(hostWidth: Int, proportion: Int): Int {
  return CS2.scale(proportion, Progress.PROPORTION, hostWidth);
}

function stripBarWidth(parentWidth: Int, share: Boolean, reserve: Int): Int {
  if (share) {
    return CS2.scale(
        CS2.scale(Progress.SHARE_NUM, Progress.SHARE_DEN, Progress.PROPORTION),
        Progress.PROPORTION,
        parentWidth,
      ) - Layout.PROGRESS_INSET;
  }
  return parentWidth - reserve - Layout.PROGRESS_INSET;
}

function widthOf(component: ComponentId): Int {
  return CS2.if_width_get(component);
}

function placeStrip(drawn: Boolean, share: Boolean, reserve: Int): void {
  if (!drawn) {
    return;
  }
  progressRef.props = {
    w: share ? '57.14%' : { fill: reserve },
    h: Layout.PROGRESS_H,
  };
}

function barBack(type: Int): Int {
  if (type === WaveProgress.ROOM) {
    return TobHudColor.LETTER_DEAD;
  }
  if (type === WaveProgress.SPECIAL) {
    return TobHudColor.BAR_SPECIAL_BACK;
  }
  return TobHudColor.BAR_IDLE_BACK;
}

function barFront(type: Int): Int {
  if (type === WaveProgress.ROOM) {
    return TobHudColor.BAR_ROOM;
  }
  if (type === WaveProgress.SPECIAL) {
    return TobHudColor.BAR_SPECIAL;
  }
  return TobHudColor.BAR_IDLE;
}

function barLabel(type: Int, tenths: Int): String {
  if (type === WaveProgress.ROOM) {
    return wavePercentText(tenths);
  }
  if (type === WaveProgress.SPECIAL) {
    return `<col=ff0000>${wavePercentText(tenths)}</col>`;
  }
  return '';
}

export function TobHudProgress(): Component {
  const bar = useRef();
  const hudWidth: Int = useDerived(() => widthOf(hudRef));

  const inRaid: Int = useDerived(() => inTobRaid());
  const status: Int = useServerState(Varbits.TOB_CLIENT_PARTYSTATUS);
  const type: Int = useServerState(Varbits.TOB_CLIENT_WAVEPROGRESS_TYPE);
  const target: Int = useDerived(() => waveProportion());
  const [eased] = useState(tobClientLastprogress);
  const tenths: Int = useDerived(() => waveTenths());

  const easing: Boolean = eased !== -1 && eased !== target;
  useInterval(easing ? () => stepWaveProgress(target) : undefined, bar);

  const drawn: Boolean = inRaid === 1 && status === PartyStatus.READY;
  const reserve: Int = stripReserve();
  const share: Boolean = stripIsShare(hudWidth, reserve);
  onMounted(() => placeStrip(drawn, share, reserve));
  onUpdated(() => placeStrip(drawn, share, reserve));

  if (!drawn || type === WaveProgress.NONE) {
    return null;
  }

  const shown: Int = eased === -1 ? target : eased;
  const back: Int = barBack(type);
  const front: Int = barFront(type);
  const label: String = barLabel(type, tenths);

  return (
    <layer w="fill" h="fill">
      <layer ref={bar} x="center" y="center" w={{ fill: Layout.PROGRESS_INSET }} h={{ fill: Layout.PROGRESS_INSET }}>
        <rect x="center" y="center" w="fill" h="fill" color={back} fill />
        <rect
          x={0}
          y="center"
          w={fillWidth(stripBarWidth(widthOf(middleDodgerRef), share, reserve), shown)}
          h="fill"
          color={front}
          fill
        />
      </layer>
      <text
        x="center"
        y="center"
        w={{ fill: Layout.PROGRESS_INSET }}
        h={{ fill: Layout.PROGRESS_INSET }}
        text={label}
        font={TobHudFonts.PROGRESS}
        align="center"
        valign="middle"
      />
      <ThinBoxEntrypoint />
    </layer>
  );
}
