import { BoardAnchors } from '../lib/board-button.component';
import { boardAnchorsRef, Layout, tobPartylistRef, tooltipRef } from './tob-partylist.constants';
import { TobPartylist } from './tob-partylist.component';

export const tobPartylistUi = (): UI => (
  <ui ref={tobPartylistRef} x="center" y="center">
    <TobPartylist />
    <TobPartylistTooltipAnchor />
    <layer ref={boardAnchorsRef} x={0} y={0} w={0} h={0}>
      <BoardAnchors universe={boardAnchorsRef} count={3} />
    </layer>
  </ui>
);

function TobPartylistTooltipAnchor(): Component {
  return <layer ref={tooltipRef} x={0} y={0} w={Layout.TOOLTIP} h={Layout.TOOLTIP} />;
}
