import { CS2, useInterval, useRef, useState } from 'ts2';

import { hideTooltip } from '../0128_hosidius_seedbox/hosidius-seedbox.state';
import { clientClock, playSound, textWidth } from '../lib/lib.engine';
import { Sounds } from '../lib/lib.constants';
import {
  ChatChannelColor,
  ChatChannelFonts,
  ChatChannelSprites,
  FriendRowLayout,
  RankBySlot,
  RankTitles,
} from './chatchannel-setup.constants';
import { applyFriendRank } from './chatchannel-setup.state';

function rankOptionLabel(slot: Int): String {
  return RankTitles.get(RankBySlot.get(slot) ?? -1) ?? '';
}

export function FriendRow({
  index,
  top,
  rowHeight,
  nameWidth,
  rankWidth,
  listWidth,
  mobile,
}: {
  index: Int;
  top: Int;
  rowHeight: Int;
  nameWidth: Int;
  rankWidth: Int;
  listWidth: Int;
  mobile: Int;
}): Component {
  const [name, previousName] = CS2.friend_name_get(index);
  const rank: Int = CS2.friend_rank_get(index);

  const badge = useRef();

  const [hovered, setHovered] = useState(0);
  const [picked, setPicked] = useState(FriendRowLayout.RANK_UNPICKED);
  const [revealUntil, setRevealUntil] = useState(0);
  useInterval(
    revealUntil > 0
      ? () => {
          if (clientClock() >= revealUntil) {
            setRevealUntil(0);
          }
        }
      : undefined,
    badge,
  );

  const subject: String = `<col=ff9040>${name}</col>`;

  const stripe: Int = index % 2 === 0 ? FriendRowLayout.STRIPE_EVEN : FriendRowLayout.STRIPE_ODD;

  const shownRank: Int = picked === FriendRowLayout.RANK_UNPICKED ? rank : picked;

  let renamed: Int = 0;
  let badgeHidden: Boolean = true;
  if (previousName.length > 0) {
    renamed = 1;
    badgeHidden = false;
  }

  return (
    <>
      <rect
        x="center"
        y={top}
        w="fill"
        h={rowHeight}
        fill
        color={ChatChannelColor.VALUE}
        transparency={hovered === 1 ? FriendRowLayout.STRIPE_HOVER : stripe}
        optionSubject={subject}
        options={[
          rankOptionLabel(1),
          rankOptionLabel(2),
          rankOptionLabel(3),
          rankOptionLabel(4),
          rankOptionLabel(5),
          rankOptionLabel(6),
          rankOptionLabel(7),
        ]}
        onOptionSelect={(event) => setPicked(applyFriendRank(event.optionSubject, event.option))}
        onMouseRepeat={() => setHovered(1)}
        onMouseLeave={() => setHovered(0)}
      />

      <text
        x={{ right: 0 }}
        y={top}
        w={rankWidth}
        h={rowHeight}
        text={RankTitles.get(shownRank) ?? ''}
        font={ChatChannelFonts.BODY}
        color={ChatChannelColor.VALUE}
        align="left"
        valign="middle"
        shadow
      />

      {renamed === 1 && mobile === 1 && (
        <text
          x={FriendRowLayout.NAME_X}
          y={top}
          w={nameWidth}
          h={rowHeight}
          text={revealUntil > 0 ? `<col=ff2020>${previousName}</col>` : name}
          font={ChatChannelFonts.BODY}
          color={ChatChannelColor.NAME}
          align="left"
          valign="middle"
          shadow
          optionSubject={subject}
          options={['Reveal previous name']}
          onOptionSelect={() => {
            playSound(Sounds.CLICK);
            setRevealUntil(clientClock() + FriendRowLayout.REVEAL_CYCLES);
          }}
        />
      )}

      {renamed === 1 && mobile === 0 && (
        <text
          x={FriendRowLayout.NAME_X}
          y={top}
          w={nameWidth}
          h={rowHeight}
          text={name}
          font={ChatChannelFonts.BODY}
          color={ChatChannelColor.NAME}
          align="left"
          valign="middle"
          shadow
          onMouseLeave={() => hideTooltip()}
        />
      )}

      {renamed === 0 && (
        <text
          x={FriendRowLayout.NAME_X}
          y={top}
          w={nameWidth}
          h={rowHeight}
          text={name}
          font={ChatChannelFonts.BODY}
          color={ChatChannelColor.NAME}
          align="left"
          valign="middle"
          shadow
          onMouseEnter={() => hideTooltip()}
        />
      )}

      <sprite
        ref={badge}
        x={textWidth(name, listWidth, ChatChannelFonts.BODY) + FriendRowLayout.BADGE_GAP}
        y={top + (rowHeight - FriendRowLayout.BADGE) / 2}
        w={FriendRowLayout.BADGE}
        h={FriendRowLayout.BADGE}
        sprite={ChatChannelSprites.CHANGED_NAME}
        shadowColor={ChatChannelColor.BADGE_SHADOW}
        hide={badgeHidden}
        transparency={revealUntil > 0 ? FriendRowLayout.BADGE_HIDDEN : FriendRowLayout.BADGE_SHOWN}
      />
    </>
  );
}
