export function playlistSlot(playlist: Int, slot: Int): Int {
  if (playlist === 1) {
    return playlistOneSlot(slot);
  }
  if (playlist === 2) {
    return playlistTwoSlot(slot);
  }
  return playlistThreeSlot(slot);
}
