import { createRef } from 'ts2';
import { BankMain } from './bankmain.component';
import { BankTabDropdown } from './bankmain-dropdown.component';
import { setMobileFullscreen } from '../lib/lib.toplevel';

const bankmainRef = createRef('bankmain');

export const bankmainUi = (): UI => (
  <ui ref={bankmainRef} x="center" y="center">
    <BankMain />

    <BankTabDropdown />

    <layer x={0} y={0} w={1} h={1} />
    <layer x={0} y={0} w={0} h={0} onLoad={() => setMobileFullscreen(1)} />
  </ui>
);
