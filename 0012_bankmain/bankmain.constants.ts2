export const POTION_STORE_HELP =
  'In this potion storage space, you can store your potions, including unfinished ones.<br><br>When you deposit potions, their vials will be stored here, and you can deposit empty vials too. The vials will be needed when you withdraw your potions again.<br><br>The <img=53> icon allows you to mark up to 8 potions as your favourites. These will appear at the top of the list.';
