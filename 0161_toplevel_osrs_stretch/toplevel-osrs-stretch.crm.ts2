import { CS2 } from 'ts2';

import { Fonts } from '../lib/game/fonts';
import { chatMessage } from '../lib/lib.engine';
import { GameframeSlot, gameframeSlot } from '../lib/lib.gameframe';
import { releaseCrmOverlaySlot } from '../0065_crm_surprisepopup_side/crm-overlay-reset';
import { floaterRef } from './toplevel-osrs-stretch.constants';

export function crmOverlayYield(slot: Int): void {
  if (CS2.if_sub_has(gameframeSlot(GameframeSlot.VIEWPORT))) {
    releaseCrmOverlaySlot(slot);
  }
}

export function crmPopupTest(campaign: Int): void {
  floaterRef.onTimer = null;
  CS2.cc_all_delete(floaterRef);
  CS2.cc_create(floaterRef, CRM_VIEW_TYPE, 0, false);
  CS2.cc_size_set(480, 300, 0, 0);
  CS2.cc_position_set(0, 0, 0, 0);
  CS2.cc_crmview_init_v2(crmTestUrl(campaign), CRM_DEV_BASE, crmTestViewName(campaign));
  CS2.cc_crmview_text_font_set(0, Fonts.B12_FULL);
  CS2.cc_crmview_text_font_set(1, Fonts.P11_FULL);
  CS2.cc_crmview_on_updated_set(() => {
    crmTestUpdated(floaterRef, 0, campaign);
  });
  chatMessage("Finished Jon's New crm flow!");
}

const CRM_VIEW_TYPE = 11;

function crmTestUpdated(host: ComponentId, child: Int, campaign: Int): void {
  if (CS2.cc_find(host, child) && CS2.cc_crmview_has_response_get()) {
    if (campaign === 1) {
      CS2.cc_crmview_server_targets_set('membership_prompt_custom_event', 1);
      CS2.cc_crmview_server_targets_set('membership_prompt_open_store', 2);
      CS2.cc_crmview_server_targets_set('membership_prompt_open_store_membership', 3);
      CS2.cc_crmview_server_targets_set('membership_prompt_open_store_bonds', 4);
      CS2.cc_crmview_server_targets_set('membership_prompt_bond_pouch', 5);
      CS2.cc_crmview_server_targets_set('membership_prompt_quest_list', 6);
      CS2.cc_crmview_server_targets_set('membership_prompt_world_map', 7);
    }
    if (campaign === 6) {
      CS2.cc_crmview_server_targets_set('surprisepopup_open_store_bonds', 4);
    }
    if (campaign === 7) {
      CS2.cc_crmview_server_targets_set('surprisepopup_open_store', 2);
    }
    const close: Int = CS2.cc_crmview_int_get('closebutton');
    chatMessage(`Got CRM response. 'closebutton' is ${close}.`);
  }
  chatMessage("We Finished Jon's Recieve!");
}

const CRM_DEV_BASE = 'https://crmintegration.development.rs.aws.jagex.network/';

const CRM_DEV_TEST_URL =
  'https://crmintegration.development.rs.aws.jagex.network/getlatestcampaign/bcac1d70-f282-42e4-82b6-7a6c9494033e/?userHash=123456789';

const CRM_DEV_LIVE_URL =
  'https://crmintegration.development.rs.aws.jagex.network/getlatestcampaign/%deviceid%/?userHash=%userhash%';

function crmTestUrl(campaign: Int): String {
  if (campaign >= 1 && campaign <= 8) {
    return CRM_DEV_TEST_URL;
  }
  return CRM_DEV_LIVE_URL;
}

function crmTestViewName(campaign: Int): String {
  switch (campaign) {
    case 1:
      return 'chatbox_memberactivity_minigame_noncombat';
    case 2:
      return 'jon_test';
    case 3:
      return 'jon_mobile';
    case 4:
      return 'jon_android';
    case 5:
      return 'jon_ios';
    case 6:
      return 'jon_noend';
    case 7:
      return 'jon_frfr';
    case 8:
      return 'jon_web';
    default:
      return 'welcome_screen';
  }
}
