import { createRef, useState, useWatch } from 'ts2';

import { Anchor, overlayInit } from '../lib/lib.overlay';
import { Varbits } from '../lib/game/varbits';
import { CLAN_CUP_TEXT, ClanCupDodge, ClanCupFonts, ClanCupSideways, Layout } from './clan-cup-hud.constants';
import { clanCupLabels, clanCupValues, clancupHudUpdate } from './clan-cup-hud.helpers';
import { clanCupScoreMe, clanCupScoreThem, clanCupTimeRemaining } from './clan-cup-hud.state';

const timerHost2 = createRef('0208_clan_cup_hud_timer_host2');

const content = createRef('clan_cup_hud_content');

export function ClanCupHud(): Component {
  useWatch([Varbits.CLANCUP_SCORE_ME, Varbits.CLANCUP_TIME_REMAINING], () => clancupHudUpdate());

  return (
    <layer x="center" y="center" w="fill" h="fill" onLoad={() => clancupHudUpdate()}>
      <layer
        w="fill"
        h="fill"
        ref={timerHost2}
        onLoad={() =>
          overlayInit(timerHost2, content, ClanCupDodge.CONTENT, Anchor.LEFT, Anchor.TOP, ClanCupSideways.ALLOWED)
        }
      >
        <layer ref={content} x={0} y={0} w={Layout.CONTENT_W} h={Layout.CONTENT_H}>
          <ClanCupColumns />
        </layer>
      </layer>
    </layer>
  );
}

export function ClanCupColumns(): Component {
  const [me] = useState(clanCupScoreMe);
  const [them] = useState(clanCupScoreThem);
  const [remaining] = useState(clanCupTimeRemaining);

  return (
    <layer x={0} y={0} w="fill" h="fill">
      <text
        x={Layout.TEXT_X}
        y={Layout.TEXT_Y}
        w={Layout.TEXT_W}
        h={Layout.TEXT_H}
        font={ClanCupFonts.BODY}
        lineHeight={Layout.LINE_HEIGHT}
        shadow
        color={CLAN_CUP_TEXT}
        text={clanCupLabels(me, them, remaining)}
      />

      <text
        x={Layout.TEXT_X}
        y={Layout.TEXT_Y}
        w={Layout.TEXT_W}
        h={Layout.TEXT_H}
        font={ClanCupFonts.BODY}
        align="right"
        lineHeight={Layout.LINE_HEIGHT}
        shadow
        color={CLAN_CUP_TEXT}
        text={clanCupValues(me, them, remaining)}
      />
    </layer>
  );
}
