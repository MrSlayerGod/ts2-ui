import { useServerState, useState } from 'ts2';

import { groupDigits } from '../lib/lib.format';
import { Varbits } from '../lib/game/varbits';
import { NOT_STARTED, THOUSANDS } from './clan-cup-hud.constants';
import { clanCupScoreMe, clanCupScoreThem, clanCupTimeRemaining } from './clan-cup-hud.state';

export function clancupHudUpdate(): void {
  const [, setMe] = useState(clanCupScoreMe);
  const [, setThem] = useState(clanCupScoreThem);
  const [, setRemaining] = useState(clanCupTimeRemaining);
  setMe(useServerState(Varbits.CLANCUP_SCORE_ME));
  setThem(useServerState(Varbits.CLANCUP_SCORE_THEM));
  setRemaining(useServerState(Varbits.CLANCUP_TIME_REMAINING));
}

export function clanCupLabels(me: Int, them: Int, remaining: Int): String {
  if (remaining >= NOT_STARTED) {
    return 'Your team:<br>Opponents:<br>Starting soon...';
  }
  if (remaining > 0) {
    return 'Your team:<br>Opponents:<br>Time:';
  }
  if (me === them) {
    return 'Your team:<br>Opponents:<br>';
  }
  return 'Your team:<br>Opponents:<br>Ending...';
}

export function clanCupValues(me: Int, them: Int, remaining: Int): String {
  const mine: String = groupDigits(me, THOUSANDS);
  const theirs: String = groupDigits(them, THOUSANDS);

  let scores: String = `${mine}<br>${theirs}`;
  if (me > them) {
    scores = `<col=ffffff>${mine}</col><br>${theirs}`;
  } else if (me < them) {
    scores = `${mine}<br><col=ffffff>${theirs}</col>`;
  }

  if (remaining >= NOT_STARTED) {
    return `${scores}<br>`;
  }
  if (remaining > 1) {
    return `${scores}<br>${stringOf(remaining)} mins`;
  }
  if (remaining === 1) {
    return `${scores}<br>1 min`;
  }
  if (me === them) {
    return `${scores}<br>Next kill wins!`;
  }
  return `${scores}<br>`;
}
