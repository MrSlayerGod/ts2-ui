import { CS2, useState } from 'ts2';

import {
  clanLastclansearch00,
  clanLastclansearch01,
  clanLastclansearch02,
  clanLastclansearch03,
  clanLastclansearch04,
  clanLastclansearch05,
  clanLastclansearch06,
  clanLastclansearch07,
  clanLastclansearch08,
  clanLastclansearch09,
  clanLastclansearch10,
  clanLastclansearch11,
} from '../lib/game/varcs';

const MAX_INT_TEXT = '2147483647';

export function countDialogValue(typed: String): String {
  let text: String = typed;
  let length: Int = CS2.string_length(text);
  if (length <= 0) {
    return '0';
  }
  if (length > 10) {
    return MAX_INT_TEXT;
  }
  text = CS2.lowercase(text);
  let i: Int = 0;
  while (i < length) {
    const c: String = CS2.substring(text, i, i + 1);
    if (CS2.compare(c, 'k') === 0) {
      if (length > 8) {
        return MAX_INT_TEXT;
      }
      text = expandSuffix(text, i, length, '000');
      length = length + 2;
    } else if (CS2.compare(c, 'm') === 0) {
      if (length > 5) {
        return MAX_INT_TEXT;
      }
      text = expandSuffix(text, i, length, '000000');
      length = length + 5;
    } else if (CS2.compare(c, 'b') === 0) {
      if (length > 2) {
        return MAX_INT_TEXT;
      }
      text = expandSuffix(text, i, length, '000000000');
      length = length + 8;
    }
    i = i + 1;
  }
  if (length < 10) {
    return text;
  }
  i = 0;
  while (i < length) {
    const order: Int = CS2.compare(CS2.substring(text, i, i + 1), CS2.substring(MAX_INT_TEXT, i, i + 1));
    if (order > 0) {
      return MAX_INT_TEXT;
    }
    if (order < 0) {
      return text;
    }
    i = i + 1;
  }
  return text;
}

function expandSuffix(text: String, at: Int, length: Int, zeros: String): String {
  let tail: String = '';
  if (length > at + 1) {
    tail = CS2.substring(text, at + 1, length);
  }
  return CS2.append(CS2.append(CS2.substring(text, 0, at), zeros), tail);
}

export function replaceAllIgnoringCase(subject: String, search: String, replacement: String): String {
  const needle: String = CS2.lowercase(search);
  if (CS2.compare(needle, replacement) === 0) {
    return subject;
  }
  const needleLength: Int = CS2.string_length(needle);
  if (needleLength <= 0) {
    return subject;
  }
  let out: String = subject;
  let at: Int = CS2.string_indexof_string(CS2.lowercase(out), needle, 0);
  while (at !== -1) {
    const total: Int = CS2.string_length(out);
    out = CS2.append(CS2.append(CS2.substring(out, 0, at), replacement), CS2.substring(out, at + needleLength, total));
    at = CS2.string_indexof_string(CS2.lowercase(out), needle, 0);
  }
  return out;
}

const CLAN_SEARCH_ALPHABET = '0123456789abcdefghijklmnopqrstuvwxyz _-';

function clanSearchChar(key: Int): String {
  if (key < 0 || key >= CS2.string_length(CLAN_SEARCH_ALPHABET)) {
    return '';
  }
  return CS2.substring(CLAN_SEARCH_ALPHABET, key, key + 1);
}

export function lastClanSearch(): String {
  const [c00] = useState(clanLastclansearch00);
  const [c01] = useState(clanLastclansearch01);
  const [c02] = useState(clanLastclansearch02);
  const [c03] = useState(clanLastclansearch03);
  const [c04] = useState(clanLastclansearch04);
  const [c05] = useState(clanLastclansearch05);
  const [c06] = useState(clanLastclansearch06);
  const [c07] = useState(clanLastclansearch07);
  const [c08] = useState(clanLastclansearch08);
  const [c09] = useState(clanLastclansearch09);
  const [c10] = useState(clanLastclansearch10);
  const [c11] = useState(clanLastclansearch11);
  let name: String = '';
  name = CS2.append(name, clanSearchChar(c00 - 1));
  name = CS2.append(name, clanSearchChar(c01 - 1));
  name = CS2.append(name, clanSearchChar(c02 - 1));
  name = CS2.append(name, clanSearchChar(c03 - 1));
  name = CS2.append(name, clanSearchChar(c04 - 1));
  name = CS2.append(name, clanSearchChar(c05 - 1));
  name = CS2.append(name, clanSearchChar(c06 - 1));
  name = CS2.append(name, clanSearchChar(c07 - 1));
  name = CS2.append(name, clanSearchChar(c08 - 1));
  name = CS2.append(name, clanSearchChar(c09 - 1));
  name = CS2.append(name, clanSearchChar(c10 - 1));
  name = CS2.append(name, clanSearchChar(c11 - 1));
  return name;
}

export function appendAmountSuffix(typed: String, enabled: Int, letter: String): String {
  const length: Int = CS2.string_length(typed);
  if (CS2.string_length(letter) > 0 && enabled === 1) {
    if (length > 0) {
      const last: String = CS2.lowercase(CS2.substring(typed, length - 1, length));
      if (CS2.compare(last, 'k') === 0 || CS2.compare(last, 'm') === 0 || CS2.compare(last, 'b') === 0) {
        return typed;
      }
    }
    const first: String = CS2.substring(letter, 0, 1);
    let suffix: Int = 0;
    if (CS2.string_indexof_string('kKmMbB', first, 0) !== -1) {
      suffix = 1;
    }
    if ((suffix === 1 || CS2.string_indexof_string('0123456789', first, 0) !== -1) && length < 10) {
      if (suffix === 1 && length <= 0) {
        return typed;
      }
      return CS2.append(typed, first);
    }
  }
  return typed;
}

export function findAndReplace(subject: String, search: String, replacement: String): String {
  if (CS2.compare(search, replacement) === 0) {
    return subject;
  }
  const searchLength: Int = CS2.string_length(search);
  if (searchLength <= 0) {
    return subject;
  }
  let out: String = subject;
  let at: Int = CS2.string_indexof_string(out, search, 0);
  while (at !== -1) {
    const total: Int = CS2.string_length(out);
    out = CS2.append(CS2.append(CS2.substring(out, 0, at), replacement), CS2.substring(out, at + searchLength, total));
    at = CS2.string_indexof_string(out, search, 0);
  }
  return out;
}
