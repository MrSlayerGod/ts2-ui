function paletteOverride(slot: Int, transparent: Boolean): Int {
  if (transparent) {
    switch (slot) {
      case 0:
        return useServerState(Varps.OPTION_CHAT_COLOUR_PUBLIC_TRANSPARENT);
      case 1:
        return useServerState(Varps.OPTION_CHAT_COLOUR_PRIVATE_TRANSPARENT);
      case 2:
        return useServerState(Varps.OPTION_CHAT_COLOUR_AUTOCHAT_TRANSPARENT);
      case 3:
        return useServerState(Varps.OPTION_CHAT_COLOUR_BROADCAST_TRANSPARENT);
      case 4:
        return useServerState(Varps.OPTION_CHAT_COLOUR_FRIENDSCHAT_TRANSPARENT);
      case 5:
        return useServerState(Varps.OPTION_CHAT_COLOUR_CLANCHAT_TRANSPARENT);
      case 6:
        return useServerState(Varps.OPTION_CHAT_COLOUR_TRADEREQ_TRANSPARENT);
      case 7:
        return useServerState(Varps.OPTION_CHAT_COLOUR_CHALLENGEREQ_TRANSPARENT);
      case 8:
        return useServerState(Varps.OPTION_CHAT_COLOUR_GUESTCLAN_TRANSPARENT);
      case 9:
        return useServerState(Varps.OPTION_CHAT_COLOUR_GIMCHAT_TRANSPARENT);
      case 10:
        return useServerState(Varps.OPTION_CHAT_COLOUR_CLANBROADCAST_TRANSPARENT);
      case 11:
        return useServerState(Varps.OPTION_CHAT_COLOUR_GIMBROADCAST_TRANSPARENT);
      default:
        return useServerState(Varps.OPTION_CHAT_COLOUR_DIDYOUKNOW_TRANSPARENT);
    }
  }
  switch (slot) {
    case 0:
      return useServerState(Varps.OPTION_CHAT_COLOUR_PUBLIC_OPAQUE);
    case 1:
      return useServerState(Varps.OPTION_CHAT_COLOUR_PRIVATE_OPAQUE);
    case 2:
      return useServerState(Varps.OPTION_CHAT_COLOUR_AUTOCHAT_OPAQUE);
    case 3:
      return useServerState(Varps.OPTION_CHAT_COLOUR_BROADCAST_OPAQUE);
    case 4:
      return useServerState(Varps.OPTION_CHAT_COLOUR_FRIENDSCHAT_OPAQUE);
    case 5:
      return useServerState(Varps.OPTION_CHAT_COLOUR_CLANCHAT_OPAQUE);
    case 6:
      return useServerState(Varps.OPTION_CHAT_COLOUR_TRADEREQ_OPAQUE);
    case 7:
      return useServerState(Varps.OPTION_CHAT_COLOUR_CHALLENGEREQ_OPAQUE);
    case 8:
      return useServerState(Varps.OPTION_CHAT_COLOUR_GUESTCLAN_OPAQUE);
    case 9:
      return useServerState(Varps.OPTION_CHAT_COLOUR_GIMCHAT_OPAQUE);
    case 10:
      return useServerState(Varps.OPTION_CHAT_COLOUR_CLANBROADCAST_OPAQUE);
    case 11:
      return useServerState(Varps.OPTION_CHAT_COLOUR_GIMBROADCAST_OPAQUE);
    default:
      return useServerState(Varps.OPTION_CHAT_COLOUR_DIDYOUKNOW_OPAQUE);
  }
}

export function paletteTag(slot: Int, transparent: Boolean): String {
  const chosen: Int = paletteOverride(slot, transparent) - 1;
  if (chosen !== -1) {
    return colourTag(chosen, 'col');
  }
  if (transparent) {
    return colourTag(TransparentDefault.get(slot) ?? 0, 'col');
  }
  return colourTag(OpaqueDefault.get(slot) ?? 0, 'col');
}

function broadcastPrefixTag(transparent: Boolean): String {
  return transparent ? '<col=30ff30>' : '<col=004f00>';
}

function channelTag(transparent: Boolean): String {
  return transparent ? '<col=9070ff>' : '<col=0000ff>';
}

function type113Tag(transparent: Boolean): String {
  return transparent ? '<col=ff8f3e>' : '<col=93370c>';
}

function type114Tag(transparent: Boolean): String {
  return transparent ? '<col=12ea77>' : '<col=004a23>';
}

const GROUPING_TAG = '<col=1a31f2>';

export function tradePartnerTest(type: Int, sender: String, friend: Int): Boolean {
  const [view] = useState(chatView);
  if (view !== 6) {
    return false;
  }
  const [partner] = useState(tradepartner);
  if (CS2.string_length(partner) <= 0) {
    return false;
  }
  if (type === 2 || type === 1 || type === 3 || type === 6 || type === 7 || type === 9) {
    const name: String = CS2.tags_remove(sender);
    if (CS2.compare(name, CS2.tags_remove(CS2.chat_playername())) === 0) {
      return true;
    }
    if (CS2.compare(name, CS2.tags_remove(partner)) === 0) {
      if (type === 1 || type === 7) {
        return true;
      }
      if (CS2.chat_filter_trade_get() === 0) {
        return true;
      }
      if (CS2.chat_filter_trade_get() === 1 && friend === 1) {
        return true;
      }
    }
  }
  return false;
}

function groupIron(): Boolean {
  const kind: Int = useServerState(Varbits.IRONMAN);
  return kind === 4 || kind === 5 || kind === 6;
}

export function chatViewTest(type: Int, sender: String, friend: Int, text: String): Boolean {
  const [view] = useState(chatView);
  if (view === 0) {
    return true;
  }
  if (type === -1) {
    return false;
  }
  switch (view) {
    case 1:
      if (MesboxChatTypes.get(type) ?? false) {
        return true;
      }
      if (type === 43 && (isGimNotification(text) || isPvpArenaNotification(text))) {
        return true;
      }
      return false;
    case 2:
      return type === 1 || type === 2 || type === 90 || type === 91;
    case 3:
      return type === 3 || type === 5 || type === 6 || type === 7;
    case 4:
      return type === 9 || type === 11 || type === 104;
    case 5:
      if (type === 41 || type === 44 || type === 46 || type === 109 || type === 110 || type === 112) {
        return !startsWithPipe(text);
      }
      if (type === 43) {
        return !isGimNotification(text) || !isPvpArenaNotification(text);
      }
      return false;
    case 6:
      if (type === 101 || type === 103 || type === 102 || type === 113) {
        return true;
      }
      if (type === 41 || type === 43 || type === 111 || type === 112) {
        if (!groupIron()) {
          return false;
        }
        if (startsWithPipe(text) || isGimNotification(text) || isPvpArenaNotification(text)) {
          return true;
        }
      }
      return tradePartnerTest(type, sender, friend);
  }
  return false;
}

export function chatFilterTest(
  type: Int,
  sender: String,
  line: String,
  text: String,
  cycle: Int,
  privateTab: Int,
  me: String,
  friend: Int,
): Boolean {
  if (type === -1) {
    return false;
  }
  const [allCleared] = useState(allChatClearedTime);
  if (cycle < allCleared) {
    return false;
  }
  if ((MesboxChatTypes.get(type) ?? false) && type !== 106) {
    if (type === 105 && useServerState(Varbits.GAME_FILTER) === 1) {
      return false;
    }
    if (type === 114 && useServerState(Varbits.SHOW_DIALOGUE_IN_CHATBOX) === 0) {
      return false;
    }
    if (type === 115 && useServerState(Varbits.SHOW_MESBOX_IN_CHATBOX) === 0) {
      return false;
    }
    if (type === 118) {
      const [skillGuideCleared] = useState(bondifConvertPerbondCs);
      if (cycle < skillGuideCleared) {
        return false;
      }
    }
    return true;
  }
  const mine: Boolean = CS2.compare(me, CS2.tags_remove(sender)) === 0;
  const messageFilter: String = CS2.chat_message_filter_get();
  const filtered: Boolean =
    CS2.string_length(messageFilter) > 0 && CS2.string_indexof_string(CS2.lowercase(line), messageFilter, 0) === -1;
  switch (type) {
    case 2:
    case 1: {
      const [publicCleared] = useState(publicChatClearedTime);
      if (cycle < publicCleared) return false;
      if (mine) return true;
      if (friend === 2) return false;
      const publicFilter: Int = CS2.chat_filter_public_get();
      if (publicFilter === 2 || publicFilter === 3) return false;
      if (filtered) return false;
      if (publicFilter === 1) return friend === 1;
      return true;
    }
    case 90:
    case 91: {
      const [publicCleared] = useState(publicChatClearedTime);
      if (cycle < publicCleared) return false;
      if (mine) return true;
      if (friend === 2) return false;
      if (CS2.chat_filter_public_get() !== 4) return false;
      if (filtered) return false;
      return true;
    }
    case 3:
    case 7: {
      const [privateCleared] = useState(privateChatClearedTime);
      if (cycle < privateCleared) return false;
      if (friend === 2) return false;
      if (useServerState(Varps.OPTION_PM) === 1 && privateTab === 0 && !tradePartnerTest(type, sender, friend)) {
        return false;
      }
      if (CS2.chat_filter_private_get() === 0) return true;
      if (CS2.chat_filter_private_get() === 1 && friend === 1) return true;
      return false;
    }
    case 101:
    case 103:
    case 113:
      if (friend === 2) return false;
      if (CS2.chat_filter_trade_get() === 0) return true;
      if (CS2.chat_filter_trade_get() === 1 && friend === 1) return true;
      return false;
    case 5:
    case 6: {
      const [privateCleared] = useState(privateChatClearedTime);
      if (cycle < privateCleared) return false;
      if (type === 5) {
        const mode: Int = noticeMode(
          useServerState(Varbits.LOGINLOGOUT_PERMANENT),
          useServerState(Varbits.LOGINLOGOUT_SETTING),
        );
        if (mode === 2) return false;
        if (mode === 0 && CS2.clientclock() - cycle >= 500) return false;
      }
      if (useServerState(Varps.OPTION_PM) === 1 && privateTab === 0 && !tradePartnerTest(type, sender, friend)) {
        return false;
      }
      return CS2.chat_filter_private_get() !== 2;
    }
    case 9:
    case 104: {
      const [fcCleared] = useState(friendschatClearedTime);
      if (cycle < fcCleared) return false;
      if (mine) return true;
      if (friend === 2) return false;
      const fcFilter: Int = useServerState(Varbits.CHAT_FILTER_FRIENDSCHAT);
      if (fcFilter === 0) return true;
      if (fcFilter === 1 && friend === 1) return true;
      return false;
    }
    case 11: {
      const [fcCleared] = useState(friendschatClearedTime);
      if (cycle < fcCleared) return false;
      return useServerState(Varbits.CHAT_FILTER_FRIENDSCHAT) !== 2;
    }
    case 41:
    case 44:
    case 43:
    case 46:
    case 109:
    case 110:
    case 111:
    case 112: {
      const [groupCleared] = useState(groupChatClearedTime);
      if (type === 43 && (isGimNotification(text) || isPvpArenaNotification(text))) {
        if (cycle < groupCleared) return false;
        return CS2.chat_filter_trade_get() !== 2;
      }
      if (type === 41 && startsWithPipe(text)) {
        if (cycle < groupCleared) return false;
        if (mine) return true;
        if (CS2.chat_filter_trade_get() === 2) return false;
        if (CS2.chat_filter_trade_get() === 1 && friend !== 1) return false;
        return friend !== 2;
      }
      const [clanCleared] = useState(clanChatClearedTime);
      if (cycle < clanCleared) return false;
      if (mine) return true;
      const clanFilter: Int = useServerState(Varbits.CHAT_FILTER_CLANCHAT);
      if (clanFilter === 0) return true;
      if (clanFilter === 1 && friend === 1) return true;
      return false;
    }
    case 102:
      return CS2.chat_filter_trade_get() !== 2;
    case 106:
      return friend !== 2;
    case 14: {
      const [broadcastCleared] = useState(broadcastClearedTime);
      if (cycle < broadcastCleared) return false;
      if (broadcastLink(line) === 4 && CS2.reboottimer() > 0) return false;
      return true;
    }
  }
  return true;
}

export function rowShape(type: Int, text: String): Int {
  switch (type) {
    case 1:
    case 2:
    case 90:
    case 91:
    case 3:
    case 7:
    case 6:
    case 9:
    case 14:
      return RowShape.SPLIT;
    case 41:
    case 44:
    case 46:
      return RowShape.QUAD;
    case 43:
      if (isGimNotification(text) || isPvpArenaNotification(text)) {
        return RowShape.SPLIT;
      }
      return RowShape.QUAD;
    case 114:
    case 116:
      return CS2.string_length(pipeHead(text)) > 0 ? RowShape.SPLIT : RowShape.SINGLE;
  }
  return RowShape.SINGLE;
}

function channelLead(timestamped: Boolean, stamp: String, name: String, transparent: Boolean): String {
  return affixTimestamp(timestamped, stamp, `[${channelTag(transparent)}${name}</col>]`, 'null');
}

function affinedRankTitle(sender: String): String {
  const slot: Int = CS2.activeclansettings_affined_slot_get(CS2.tags_remove(sender));
  if (slot === -1) {
    return clanRankTitle(-1);
  }
  return clanRankTitle(CS2.activeclansettings_affined_rank_get(slot));
}

export function rowSprite(type: Int, sender: String, text: String): Sprite {
  if (type === 41) {
    if (CS2.activeclansettings_affined_find(1) && CS2.activeclanchannel_affined_find(1) && startsWithPipe(text)) {
      return -1;
    }
    if (!(CS2.activeclansettings_affined_find(0) && CS2.activeclanchannel_affined_find(0))) {
      return -1;
    }
  } else if (type === 44) {
    if (!(CS2.activeclansettings_listened_find() && CS2.activeclanchannel_listened_find())) {
      return -1;
    }
  } else {
    return -1;
  }
  const slot: Int = CS2.activeclansettings_affined_slot_get(CS2.tags_remove(sender));
  if (slot === -1) {
    return clanRankIcon(-1);
  }
  return clanRankIcon(CS2.activeclansettings_affined_rank_get(slot));
}

export function rowPart(part: Int, uid: Int, transparent: Boolean, timestamped: Boolean): String {
  const [type, cycle, sender0, clan, text0, _friend, stamp, _mode] = CS2.chat_history_by_uid_get(uid);
  let sender: String = sender0;
  let text: String = text0;
  let lead: String = '';
  let name: String = '';
  let body: String = '';
  switch (type) {
    case 2:
    case 1:
      lead = affixTimestamp(timestamped, stamp, `${sender}:`, 'null');
      body = `${paletteTag(Palette.PUBLIC, transparent)}${text}</col>`;
      break;
    case 90:
    case 91:
      lead = affixTimestamp(timestamped, stamp, `${sender}:`, 'null');
      body = `${paletteTag(Palette.AUTOCHAT, transparent)}${text}</col>`;
      break;
    case 3:
    case 7:
      lead = affixTimestamp(timestamped, stamp, `From ${sender}:`, 'null');
      body = `${paletteTag(Palette.PRIVATE, transparent)}${text}</col>`;
      break;
    case 101:
      lead = affixTimestamp(timestamped, stamp, `${paletteTag(Palette.TRADEREQ, transparent)}${text}</col>`, 'null');
      break;
    case 5:
      lead = affixTimestamp(timestamped, stamp, `${paletteTag(Palette.PRIVATE, transparent)}${text}</col>`, 'null');
      break;
    case 6:
      lead = affixTimestamp(timestamped, stamp, `To ${sender}:`, 'null');
      body = `${paletteTag(Palette.PRIVATE, transparent)}${text}</col>`;
      break;
    case 103:
    case 104:
    case 110:
      lead = affixTimestamp(
        timestamped,
        stamp,
        `${paletteTag(Palette.CHALLENGEREQ, transparent)}${text}</col>`,
        'null',
      );
      break;
    case 109:
      lead = affixTimestamp(timestamped, stamp, `${GROUPING_TAG}${text}</col>`, 'null');
      break;
    case 9:
      lead = affixTimestamp(timestamped, stamp, `[${channelTag(transparent)}${clan}</col>] ${sender}:`, 'null');
      body = `${paletteTag(Palette.FRIENDSCHAT, transparent)}${text}</col>`;
      break;
    case 111:
    case 112:
      lead = affixTimestamp(timestamped, stamp, `${GROUPING_TAG}${pipeTail(text)}</col>`, 'null');
      break;
    case 41:
      lead = channelLead(timestamped, stamp, clan, transparent);
      name = `${sender}:`;
      if (CS2.activeclansettings_affined_find(1) && CS2.activeclanchannel_affined_find(1) && startsWithPipe(text)) {
        body = `${paletteTag(Palette.GIMCHAT, transparent)}${pipeTail(text)}</col>`;
      } else {
        body = `${paletteTag(Palette.CLANCHAT, transparent)}${text}</col>`;
        if (
          CS2.activeclansettings_affined_find(0) &&
          CS2.activeclanchannel_affined_find(0) &&
          CS2.activeclansettings_affined_slot_get(CS2.tags_remove(sender)) !== -1 &&
          rowSprite(type, sender, text) === -1
        ) {
          name = `${channelTag(transparent)}${affinedRankTitle(sender)}</col> ${sender}:`;
        }
      }
      break;
    case 44:
      lead = channelLead(timestamped, stamp, clan, transparent);
      name = `${sender}:`;
      body = `${paletteTag(Palette.GUESTCLAN, transparent)}${text}</col>`;
      if (
        CS2.activeclansettings_listened_find() &&
        CS2.activeclanchannel_listened_find() &&
        CS2.activeclansettings_affined_slot_get(CS2.tags_remove(sender)) !== -1 &&
        rowSprite(type, sender, text) === -1
      ) {
        name = `${channelTag(transparent)}${affinedRankTitle(sender)}</col> ${sender}:`;
      }
      break;
    case 43:
      if (isGimNotification(text)) {
        const gim: String = paletteTag(Palette.GIMBROADCAST, transparent);
        text = pipeTail(text);
        if (CS2.string_length(text) > 0 && CS2.string_indexof_string(text, '|', 0) !== -1) {
          text = pipeTail(text);
        }
        text = replaceAll(text, '</col>', `</col>${gim}`);
        if (CS2.activeclansettings_affined_find(1)) {
          lead = channelLead(timestamped, stamp, CS2.activeclansettings_clan_name_get(), transparent);
        } else {
          lead = affixTimestamp(timestamped, stamp, '', 'null');
        }
        body = `${gim}${text}</col>`;
      } else if (isPvpArenaNotification(text)) {
        text = pipeTail(text);
        if (CS2.activeclanchannel_affined_find(2)) {
          lead = affixTimestamp(timestamped, stamp, `[${channelTag(transparent)}PvP Arena</col>]`, 'null');
        } else {
          lead = affixTimestamp(timestamped, stamp, '', 'null');
        }
        body = text;
      } else {
        const clanBroadcast: String = paletteTag(Palette.CLANBROADCAST, transparent);
        text = replaceAll(text, '</col>', `</col>${clanBroadcast}`);
        if (CS2.string_length(text) > 0 && CS2.string_indexof_string(text, '|', 0) !== -1) {
          text = pipeTail(text);
        }
        if (CS2.activeclanchannel_affined_find(0)) {
          lead = channelLead(timestamped, stamp, CS2.activeclanchannel_clan_name_get(), transparent);
        } else {
          lead = affixTimestamp(timestamped, stamp, '', 'null');
        }
        body = `${clanBroadcast}${text}</col>`;
      }
      break;
    case 46:
      if (CS2.activeclanchannel_listened_find()) {
        lead = channelLead(timestamped, stamp, CS2.activeclanchannel_clan_name_get(), transparent);
      } else {
        lead = affixTimestamp(timestamped, stamp, '', 'null');
      }
      body = text;
      break;
    case 14:
      lead = affixTimestamp(timestamped, stamp, `${broadcastPrefixTag(transparent)}Broadcast:</col>`, 'null');
      body = `${paletteTag(Palette.BROADCAST, transparent)}${broadcastText(text)}</col>`;
      break;
    case 118:
      lead = affixTimestamp(timestamped, stamp, pipeTail(text), 'null');
      break;
    case 107:
      if (CS2.clientclock() - cycle > 500) {
        lead = '';
      } else {
        lead = affixTimestamp(timestamped, stamp, text, 'null');
      }
      break;
    case 113:
      lead = affixTimestamp(timestamped, stamp, `${type113Tag(transparent)}${text}</col>`, 'null');
      break;
    case 114:
      sender = pipeHead(text);
      text = pipeTail(text);
      if (CS2.string_length(sender) > 0) {
        lead = affixTimestamp(timestamped, stamp, `${sender}:`, 'null');
        body = `${type114Tag(transparent)}${text}</col>`;
      } else {
        lead = affixTimestamp(timestamped, stamp, `${type114Tag(transparent)}${text}</col>`, 'null');
      }
      break;
    case 116:
      sender = pipeHead(text);
      text = pipeTail(text);
      if (CS2.string_length(sender) > 0) {
        lead = affixTimestamp(timestamped, stamp, `${sender}:`, 'null');
        body = `${paletteTag(Palette.PUBLIC, transparent)}${text}</col>`;
      } else {
        lead = affixTimestamp(timestamped, stamp, `${paletteTag(Palette.PUBLIC, transparent)}${text}</col>`, 'null');
      }
      break;
    case 0:
      if (CS2.string_length(text) > 0 && CS2.string_indexof_string(text, '|', 0) !== -1) {
        text = pipeTail(text);
      }
      lead = affixTimestamp(timestamped, stamp, text, 'null');
      break;
    case 117:
      lead = affixTimestamp(timestamped, stamp, `${paletteTag(Palette.DIDYOUKNOW, transparent)}${text}</col>`, 'null');
      break;
    default:
      lead = affixTimestamp(timestamped, stamp, text, 'null');
      break;
  }
  if (part === Part.LEAD) {
    return lead;
  }
  if (part === Part.NAME) {
    return name;
  }
  return body;
}

export function singleRowHeight(line: String, width: Int): Int {
  return textLineCount(line, width, LINE_FONT) * LINE_HEIGHT;
}

export function splitInset(prefix: String): Int {
  return textWidth(prefix, UNWRAPPED, LINE_FONT) + 3;
}

export function splitRowHeight(prefix: String, body: String, width: Int): Int {
  return textLineCount(body, width - splitInset(prefix), LINE_FONT) * LINE_HEIGHT;
}

export function unwrappedWidth(text: String): Int {
  return textWidth(text, UNWRAPPED, LINE_FONT);
}

export function quadColumn(which: Int, lead: String, hasSprite: Boolean, spriteW: Int, name: String): Int {
  const leadW: Int = unwrappedWidth(lead);
  const nameW: Int = unwrappedWidth(name);
  let x: Int = 0;
  if (leadW > 0) {
    x = leadW;
    if (hasSprite) {
      x = x + 1;
    } else if (nameW > 0) {
      x = x + 3;
    }
  }
  let spriteX: Int = 0;
  if (hasSprite) {
    spriteX = x;
    x = x + spriteW;
    if (nameW > 0) {
      x = x + 1;
    }
  }
  let nameX: Int = 0;
  if (nameW > 0) {
    nameX = x;
    x = x + nameW;
  }
  if (x > 0) {
    x = x + 3;
  }
  if (which === 0) return spriteX;
  if (which === 1) return nameX;
  return x;
}

export function quadRowHeight(
  lead: String,
  hasSprite: Boolean,
  spriteW: Int,
  spriteH: Int,
  name: String,
  body: String,
  width: Int,
): Int {
  const bodyX: Int = quadColumn(2, lead, hasSprite, spriteW, name);
  return Math.max(spriteH, textLineCount(body, width - bodyX, LINE_FONT) * LINE_HEIGHT);
}

export const RANK_ICON = 13;

export function rowOptionSubject(uid: Int): String {
  const [type, _cycle, sender, _clan, text, _friend, _stamp, _mode] = CS2.chat_history_by_uid_get(uid);
  switch (type) {
    case 1:
    case 2:
    case 3:
    case 6:
    case 7:
    case 9:
    case 90:
    case 91:
    case 106:
    case 41:
    case 44:
    case 101:
    case 103:
    case 104:
    case 110:
      return `<col=ffffff>${sender}</col>`;
    case 109:
    case 111:
    case 112:
      return `<col=0xffffff>${sender}</col>`;
    case 0:
      if (
        CS2.string_length(sender) > 0 &&
        CS2.compare(CS2.tags_remove(CS2.chat_playername()), CS2.tags_remove(sender)) !== 0
      ) {
        return `<col=ffffff>${sender}</col>`;
      }
      return '';
    case 14:
      return '<col=ff9040>Notification</col>';
    case 118:
      return '<col=ff9040>Skill guide</col>';
  }
  return '';
}

export function rowOption(op: Int, uid: Int, pvp: Boolean): String {
  const [type, _cycle, sender, _clan, text, friend, _stamp, _mode] = CS2.chat_history_by_uid_get(uid);
  const me: String = CS2.tags_remove(CS2.chat_playername());
  const other: Boolean = CS2.compare(me, CS2.tags_remove(sender)) !== 0;
  switch (type) {
    case 1:
    case 2:
    case 3:
    case 6:
    case 7:
    case 9:
    case 90:
    case 91:
    case 106:
    case 41:
    case 44: {
      if (op === 10 && type !== 41 && hasModCrown(sender)) {
        return 'Crown Info';
      }
      if (!other) {
        return '';
      }
      if (op === 6) return friend === 1 ? 'Message' : 'Add friend';
      if (op === 7) return friend === 1 ? '' : 'Add ignore';
      if (op === 8) return 'Report';
      if (op === 9 && type === 9) {
        if (
          CS2.friendschat_chat_count_get() > 0 &&
          CS2.friendschat_chat_rank_get() >= CS2.friendschat_chat_min_kick_get()
        ) {
          return 'Kick';
        }
      }
      return '';
    }
    case 0:
      if (op === 8 && CS2.string_length(sender) > 0 && other) {
        return 'Report';
      }
      return '';
    case 101:
      if (op === 1) return pvp ? 'Accept invitation' : 'Accept trade';
      if (op === 6) return friend === 1 ? 'Message' : 'Add friend';
      if (op === 7) return friend === 1 ? '' : 'Add ignore';
      return '';
    case 103:
    case 104:
    case 110:
      if (op === 2) return 'Accept challenge';
      if (op === 6) return friend === 1 ? 'Message' : 'Add friend';
      if (op === 7) return friend === 1 ? '' : 'Add ignore';
      return '';
    case 109:
    case 111:
    case 112:
      if (op === 2) return type === 109 ? 'Form clan' : type === 111 ? 'Form group' : 'Group with';
      if (op === 6) return friend === 1 ? 'Message' : 'Add friend';
      if (op === 7) return friend === 1 ? '' : 'Add ignore';
      return '';
    case 14:
      if (op === 6 && CS2.string_length(broadcastUrl(text)) > 0 && broadcastLink(text) !== -1) return 'Open';
      if (op === 7 && CS2.string_length(broadcastUrl(text)) > 0 && broadcastLink(text) !== -1) return 'Check';
      if (op === 9) return 'Clear history';
      return '';
    case 118:
      if (op === 9) return 'Clear all';
      return '';
  }
  return '';
}

export function chatRowOp(op: Int, subject: String, type: Int, text: String): void {
  if (type === 14) {
    broadcastOp(op, text);
    return;
  }
  if (type === 118) {
    skillGuideOp(op);
    return;
  }
  chatOp(op, subject, type);
}

function broadcastOp(op: Int, text: String): void {
  if (op === 9) {
    const [, setCleared] = useState(broadcastClearedTime);
    setCleared(CS2.clientclock());
    newestChatUid();
    return;
  }
  const url: String = broadcastUrl(text);
  if (CS2.string_length(url) <= 0) {
    return;
  }
  if (op === 6) {
    CS2.sound_effect(2266, 1, 0);
    CS2.url_open(url, true);
  } else {
    CS2.message(`Link destination: <col=ef1020>${url}</col>`);
  }
}

function skillGuideOp(op: Int): void {
  if (op === 9) {
    const [, setCleared] = useState(bondifConvertPerbondCs);
    setCleared(CS2.clientclock());
    newestChatUid();
  }
}

export function chatOp(op: Int, subject: String, type: Int): void {
  const name: String = CS2.tags_remove(subject);
  switch (op) {
    case 1:
      CS2.opplayer(4, name);
      return;
    case 2:
      CS2.opplayer(1, name);
      return;
    case 8: {
      const [, setReported] = useState(snapshotName);
      setReported(name);
      return;
    }
    case 9:
      if (type === 41) {
        if (CS2.activeclanchannel_affined_find(0)) {
          clanSidepanelOp(7, -1, name, CS2.activeclanchannel_user_slot_get(name), 0, -1);
        } else {
          CS2.message("The game cannot process your Kick request now. Please reconnect to the clan's channel.");
        }
      } else {
        friendschatSendKick(name);
      }
      return;
    case 10:
      if (type === 41) {
        if (CS2.activeclanchannel_affined_find(0)) {
          clanSidepanelOp(8, -1, name, CS2.activeclanchannel_user_slot_get(name), 0, -1);
        } else {
          CS2.message("The game cannot process your Ban request now. Please reconnect to the clan's channel.");
        }
      } else {
        crownInfo();
      }
      return;
  }
  const named: Boolean = useServerState(Varbits.HAS_DISPLAYNAME_TRANSMITTER) === 1;
  if (CS2.friend_test(name)) {
    if (op === 6 || op === 7) {
      if (named) {
        meslayerMode6(name);
      } else {
        CS2.message('You must set a name before you can do that.');
      }
    }
  } else if (op === 6) {
    if (named) {
      CS2.friend_add(name);
    } else {
      CS2.message('You must set a name before you can do that.');
    }
  } else if (op === 7) {
    if (named) {
      CS2.ignore_add(name);
    } else {
      CS2.message('You must set a name before you can do that.');
    }
  }
}

export function chatTransmit(): void {
  const newest: Int = newestChatUid();
  if (CS2.if_sub_has(chatoverlayRef) && useServerState(Varbits.CHATOVERLAY_ALLOWMESOVERLAP) === 1) {
    const [type, _cycle, _sender, _clan, text, _friend, stamp, _mode] = CS2.chat_history_by_uid_get(newest);
    if (meslayerMode1Enabled(type)) {
      meslayerMode1(affixTimestamp(timestampsShown(), stamp, text, 'null'));
    }
  }
  chatAlerts(newest);
}

export function rowHoverInk(type: Int, text: String): Int {
  if (type === 14 && CS2.string_length(broadcastUrl(text)) > 0 && broadcastLink(text) !== -1) {
    return 0x3030ff;
  }
  return -1;
}

export function chatAlerts(newest: Int): void {
  const [lastCheck, setLastCheck] = useState(chatLastalertcheck);
  const since: Int = lastCheck;
  const mobile: Boolean = onMobile();
  setLastCheck(CS2.clientclock());
  const [view] = useState(chatView);
  const [chatDisabled] = useState(osmChatboxDisabled);
  if (view === 0 && (!mobile || chatDisabled === 0)) {
    return;
  }
  const privateTab: Int = view === 1337 ? 1 : 0;
  const me: String = CS2.tags_remove(CS2.chat_playername());
  const timestamped: Boolean = timestampsShown();
  let uid: Int = newest;
  while (uid !== -1) {
    const [type, cycle, sender, _clan, text, friend, stamp, _mode] = CS2.chat_history_by_uid_get(uid);
    if (cycle <= since) {
      return;
    }
    if (
      chatFilterTest(
        type,
        sender,
        affixTimestamp(timestamped, stamp, text, 'null'),
        text,
        cycle,
        privateTab,
        me,
        friend,
      ) &&
      !tradePartnerTest(type, sender, friend)
    ) {
      switch (type) {
        case 1:
        case 2:
          chatAlertEnable(2);
          break;
        case 3:
        case 6:
        case 7:
          chatAlertEnable(3);
          break;
        case 5:
          if (!mobile) {
            chatAlertEnable(3);
          }
          break;
        case 101:
        case 102:
        case 103:
        case 113:
          chatAlertEnable(6);
          break;
        case 9:
        case 11:
        case 104:
          chatAlertEnable(4);
          break;
        case 41:
        case 44:
        case 46:
        case 109:
        case 110:
        case 111:
        case 112:
          chatAlertEnable(startsWithPipe(text) ? 6 : 5);
          break;
        case 43:
          chatAlertEnable(isGimNotification(text) || isPvpArenaNotification(text) ? 1 : 5);
          break;
        default:
          if ((MesboxChatTypes.get(type) ?? false) && type !== 108) {
            chatAlertEnable(1);
          }
          break;
      }
    }
    uid = CS2.chat_prev_uid_get(uid);
  }
}

export function newestUid(): Int {
  let newest: Int = -1;
  let newestStamp: Int = -2147483648;
  let type: Int = 0;
  while (type <= 118) {
    if (CS2.chat_history_length_get(type) > 0) {
      const [uid, stamp, _sender, _title, _body, _friend, _prefix, _mode] = CS2.chat_history_by_type_and_line_get(
        type,
        0,
      );
      if (stamp > newestStamp || uid > newest) {
        newestStamp = stamp;
        newest = uid;
      }
    }
    type = type + 1;
  }
  return newest;
}
