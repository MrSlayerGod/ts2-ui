import { DelayColor, DelayFonts, Layout } from './deadman-delay.constants';
import { recolour } from './deadman-delay.helpers';
import { continueLine, countHolder, countLine, headline } from './deadman-delay.timer';

export function DeadmanDelay(): Component {
  return (
    <>
      <text
        ref={headline}
        x={0}
        y={0}
        w={Layout.title.w}
        h={Layout.title.h}
        text="Running away? Not so fast!"
        font={DelayFonts.ROW}
        color={DelayColor.TITLE}
        align="center"
        valign="middle"
      />

      <layer ref={countHolder} x={0} y={Layout.countHolder.y} w={Layout.countHolder.w} h={Layout.countHolder.h} hide>
        <text
          ref={countLine}
          x={0}
          y={0}
          w="fill"
          h={Layout.count.h}
          text="There are 10 seconds remaining before you can teleport..."
          font={DelayFonts.ROW}
          color={DelayColor.BODY}
          align="center"
          valign="middle"
        />
      </layer>

      <layer x={0} y={Layout.continueHolder.y} w={Layout.continueHolder.w} h={Layout.continueHolder.h} hide>
        <text
          ref={continueLine}
          x={0}
          y={0}
          w={Layout.continue.w}
          h={Layout.continue.h}
          text="Get me out of here!"
          font={DelayFonts.ROW}
          color={DelayColor.CONTINUE}
          align="center"
          continueOp
          onMouseEnter={(event) => recolour(event.component, DelayColor.CONTINUE_HOVER)}
          onMouseLeave={(event) => recolour(event.component, DelayColor.CONTINUE)}
        />
      </layer>
    </>
  );
}
