import { onMounted, onUpdated } from 'ts2';

import { BoardButton } from '../lib/board-button.component';
import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { SteelBorderEntrypoint } from '../lib/steel-border-entrypoint.component';
import { ThinBoxEntrypoint } from '../lib/thin-box-entrypoint.component';
import { MyGroupButton } from './my-group-button.component';
import {
  BoardColor,
  BoardFonts,
  BoardScrollbar,
  BoardSprites,
  Copy,
  Layout,
  BoardPausebutton,
  boardAnchorsRef,
  filtersRef,
  listRef,
  mygroupRef,
  optionsRef,
  refreshRef,
  universeRef,
} from './pvp-arena-board.constants';
import { buttonGap, mygroupWidth, optionsWidth, refreshWidth, resetBoardPoll } from './pvp-arena-board.helpers';

export function PvpArenaBoard(): Component {
  return (
    <layer
      ref={universeRef}
      x="center"
      y="center"
      w={Layout.PANEL_W}
      h={Layout.PANEL_H}
      onLoad={() => resetBoardPoll()}
    >
      <SteelBorderEntrypoint title={Copy.TITLE} />

      <layer
        x="center"
        y={{ bottom: Layout.CONTENT_BOTTOM }}
        w={{ fill: Layout.CONTENT_INSET_W }}
        h={{ fill: Layout.CONTENT_INSET_H }}
      >
        <layer x={0} y="center" w={Layout.FILTER_BOX_W} h="fill">
          <layer
            ref={filtersRef}
            x={Layout.FILTERS_X}
            y={Layout.FILTERS_Y}
            w={{ fill: Layout.FILTERS_INSET_W }}
            h={{ fill: Layout.FILTERS_INSET_H }}
          />
          <layer
            right={Layout.SCROLLBAR_RIGHT}
            y={Layout.FILTERS_Y}
            w={Layout.SCROLLBAR_W}
            h={{ fill: Layout.FILTERS_INSET_H }}
          >
            <ScrollbarVertical
              content={filtersRef}
              track={BoardScrollbar.TRACK}
              capTopSprite={BoardScrollbar.CAP_TOP}
              thumbSprite={BoardScrollbar.THUMB}
              capBottomSprite={BoardScrollbar.CAP_BOTTOM}
              arrowUp={BoardScrollbar.ARROW_UP}
              arrowDown={BoardScrollbar.ARROW_DOWN}
            />
          </layer>
          <layer x="center" y="bottom" w="fill" h={Layout.LEGEND_H}>
            <sprite
              x={Layout.LEGEND_ICON_X}
              y={Layout.LEGEND_ICON_Y}
              w={Layout.LEGEND_ICON}
              h={Layout.LEGEND_ICON}
              sprite={BoardSprites.LEGEND_TICK}
            />
            <text
              right={Layout.LEGEND_TEXT_RIGHT}
              y={Layout.LEGEND_TEXT_Y}
              w={{ fill: Layout.LEGEND_TEXT_INSET_W }}
              h={Layout.LEGEND_TEXT_H}
              text={Copy.LEGEND}
              font={BoardFonts.BODY}
              color={BoardColor.LABEL}
              align="center"
              valign="middle"
              shadow
            />
            <layer
              hide
              x="center"
              y={{ bottom: Layout.RESET_BOTTOM }}
              w={Layout.RESET_W}
              h={{ fill: Layout.RESET_INSET_H }}
            >
              <BoardButton label={Copy.RESET} resumeIn={boardAnchorsRef} resumeAt={BoardPausebutton.RESET} />
            </layer>
            <ThinBoxEntrypoint />
          </layer>
          <ThinBoxEntrypoint />
        </layer>

        <layer x="right" y="center" w={{ fill: Layout.LIST_COLUMN_INSET_W }} h="fill">
          <layer x="center" y={0} w="fill" h={{ fill: Layout.LIST_BOX_INSET_H }}>
            <sprite
              x="center"
              y="center"
              w={{ fill: Layout.BACKING_INSET }}
              h={{ fill: Layout.BACKING_INSET }}
              sprite={BoardSprites.BACKING}
              tiling
            />
            <layer x="center" y={0} w="fill" h={Layout.SORT_H}>
              <layer x={Layout.SORT_A_X} y="center" w={Layout.SORT_A_W} h={{ fill: Layout.SORT_INSET_H }} />
              <layer x={Layout.SORT_B_X} y="center" w={Layout.SORT_B_W} h={{ fill: Layout.SORT_INSET_H }} />
              <layer
                right={Layout.SORT_C_RIGHT}
                y="center"
                w={{ fill: Layout.SORT_C_INSET_W }}
                h={{ fill: Layout.SORT_INSET_H }}
              />
              <ThinBoxEntrypoint />
            </layer>
            <layer
              ref={listRef}
              x={Layout.LIST_X}
              y={{ bottom: Layout.LIST_BOTTOM }}
              w={{ fill: Layout.LIST_INSET_W }}
              h={{ fill: Layout.LIST_INSET_H }}
            >
              <text
                x="center"
                y="center"
                w="fill"
                h="fill"
                text={Copy.LOADING}
                font={BoardFonts.BODY}
                color={BoardColor.LOADING}
                align="center"
                valign="middle"
                shadow
              />
            </layer>
            <layer
              right={Layout.SCROLLBAR_RIGHT}
              y={{ bottom: Layout.LIST_BOTTOM }}
              w={Layout.SCROLLBAR_W}
              h={{ fill: Layout.LIST_INSET_H }}
            >
              <ScrollbarVertical
                content={listRef}
                track={BoardScrollbar.TRACK}
                capTopSprite={BoardScrollbar.CAP_TOP}
                thumbSprite={BoardScrollbar.THUMB}
                capBottomSprite={BoardScrollbar.CAP_BOTTOM}
                arrowUp={BoardScrollbar.ARROW_UP}
                arrowDown={BoardScrollbar.ARROW_DOWN}
              />
            </layer>
            <ThinBoxEntrypoint />
          </layer>
          <layer x="center" y="bottom" w="fill" h={Layout.BOTTOM_H}>
            <layer static ref={mygroupRef} hide x={0} y="center" w={0} h={{ fill: Layout.BUTTON_INSET_H }}>
              <MyGroupButton />
            </layer>
            <layer static ref={refreshRef} hide x={0} y="center" w={0} h={{ fill: Layout.BUTTON_INSET_H }}>
              <BoardButton label={Copy.REFRESH} resumeIn={boardAnchorsRef} resumeAt={BoardPausebutton.REFRESH} />
            </layer>
            <layer static ref={optionsRef} hide x={0} y="center" w={0} h={{ fill: Layout.BUTTON_INSET_H }}>
              <BoardButton label={Copy.OPTIONS} resumeIn={boardAnchorsRef} resumeAt={BoardPausebutton.OPTIONS} />
            </layer>
            <ThinBoxEntrypoint />
          </layer>
        </layer>
      </layer>

      <layer x={0} y={0} w="fill" h="fill" />

      <BoardButtonLayout />
    </layer>
  );
}

function BoardButtonLayout(): Component {
  const mygroupW: Int = mygroupWidth();
  const refreshW: Int = refreshWidth();
  const optionsW: Int = optionsWidth();
  const gap: Int = buttonGap(mygroupW, refreshW, optionsW);
  const mygroupX: Int = Layout.BOTTOM_EDGE + gap;
  const optionsX: Int = mygroupX + mygroupW + gap;
  const refreshX: Int = optionsX + optionsW + gap;

  onMounted(() => placeButtons(mygroupX, mygroupW, optionsX, optionsW, refreshX, refreshW));
  onUpdated(() => placeButtons(mygroupX, mygroupW, optionsX, optionsW, refreshX, refreshW));

  return <layer x={0} y={0} w={0} h={0} />;
}

function placeButtons(mygroupX: Int, mygroupW: Int, optionsX: Int, optionsW: Int, refreshX: Int, refreshW: Int): void {
  mygroupRef.props = { x: mygroupX, y: 'center', w: mygroupW, h: { fill: Layout.BUTTON_INSET_H } };
  optionsRef.props = { x: optionsX, y: 'center', w: optionsW, h: { fill: Layout.BUTTON_INSET_H } };
  refreshRef.props = { x: refreshX, y: 'center', w: refreshW, h: { fill: Layout.BUTTON_INSET_H } };
}
