import { useState } from 'ts2';

import { pollId, pollYpos } from '../lib/game/varcs';
import { textWidth } from '../lib/lib.engine';
import { BoardFonts, Copy, Layout } from './pvp-arena-board.constants';

export function bottomBarWidth(): Int {
  return Layout.PANEL_W - Layout.CONTENT_INSET_W - Layout.LIST_COLUMN_INSET_W;
}

export function mygroupWidth(): Int {
  return Layout.BUTTON_PAD +
    Math.max(
      textWidth(Copy.LIST_GROUP, Layout.MEASURE_W, BoardFonts.BODY),
      textWidth(Copy.VIEW_APPLICATIONS, Layout.MEASURE_W, BoardFonts.BODY),
    );
}

export function refreshWidth(): Int {
  return Layout.BUTTON_PAD + textWidth(Copy.REFRESH, Layout.MEASURE_W, BoardFonts.BODY);
}

export function optionsWidth(): Int {
  return Layout.BUTTON_PAD + textWidth(Copy.OPTIONS, Layout.MEASURE_W, BoardFonts.BODY);
}

export function buttonGap(mygroupW: Int, refreshW: Int, optionsW: Int): Int {
  return (bottomBarWidth() - Layout.BOTTOM_INSET - (mygroupW + refreshW + optionsW)) / 4;
}

export function resetBoardPoll(): void {
  const [, setPollId] = useState(pollId);
  const [, setPollYpos] = useState(pollYpos);
  setPollId(0);
  setPollYpos(0);
}
