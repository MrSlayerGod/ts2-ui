import { useState } from 'ts2';
import { inLeagueTutorial } from '../0654_league_info/league-info.helpers';
import { toplevelMainmodalBgColour, toplevelMainmodalBgTrans } from '../lib/game/varcs';
import { ToplevelComponents } from '../lib/lib.constants';
import { onMobile, toplevelComponents } from '../lib/lib.helpers';
import { Modal, Panel, hudContainerFrontRef, mainmodalRef } from './toplevel-osm.constants';
import { chatboxOff, switchSidePanel } from './toplevel-osm.helpers';

export function toplevelMainmodalOpen(colour: Int, trans: Int): void {
  mainmodalBackground(colour, trans);
  if (onMobile() && !inLeagueTutorial()) {
    mobileMainmodalOpen();
  }
}

export function mainmodalBackground(colour: Int, trans: Int): void {
  const [, setColour] = useState(toplevelMainmodalBgColour);
  const [, setTrans] = useState(toplevelMainmodalBgTrans);
  setColour(colour);
  setTrans(trans);
}

export function mobileMainmodalOpen(): void {
  if (toplevelComponents() !== ToplevelComponents.MOBILE) {
    return;
  }
  const modalW: Int = mainmodalRef.width;
  const frontW: Int = hudContainerFrontRef.width;
  if (modalW + Modal.SIDE_W - Modal.SIDE_PAD >= frontW) {
    switchSidePanel(Panel.NONE, 0);
  } else if (chatboxOff()) {
    switchSidePanel(Panel.NONE, 0);
  }
}
