import { createRef, onMounted, onUpdated, useState } from 'ts2';
import { Fonts } from '../lib/game/fonts';
import { closeInterface } from '../lib/lib.helpers';
import { messageboxUrlLabel, messageboxUrlOpen } from './messagebox-url.state';

const LABEL = Fonts.Q8_FULL;

enum UrlBoxColor {
  LINE = 0x0000ff,
  LINE_HOVER = 0xffffff,
  BODY = 0x000000,
}

function textColourSwapper(component: ComponentId, colour: Int): void {
  component.color = colour;
}

export function MessageBoxUrl(): Component {
  return (
    <>
      <text x={0} y={0} w={479} h={63} font={LABEL} color={UrlBoxColor.BODY} align="center" valign="middle" />

      <text
        x={0}
        y={80}
        w={479}
        h={17}
        font={LABEL}
        color={UrlBoxColor.LINE}
        align="center"
        options={['Continue']}
        onClick={() => closeInterface()}
        onMouseEnter={(event) => textColourSwapper(event.component, UrlBoxColor.LINE_HOVER)}
        onMouseLeave={(event) => textColourSwapper(event.component, UrlBoxColor.LINE)}
      />

      <text
        static
        ref={urlLine}
        x={0}
        y={58}
        w={479}
        h={17}
        font={LABEL}
        color={UrlBoxColor.LINE}
        align="center"
        options={['Information']}
        onOptionSelect={() => messageboxUrlOpen()}
        onMouseEnter={(event) => textColourSwapper(event.component, UrlBoxColor.LINE_HOVER)}
        onMouseLeave={(event) => textColourSwapper(event.component, UrlBoxColor.LINE)}
      />

      <UrlOption />
    </>
  );
}

const urlLine = createRef('messagebox_url_url');

function UrlOption(): Component {
  const [label] = useState(messageboxUrlLabel);
  const shown: String = label;
  onMounted(() => urlLine.options = [shown]);
  onUpdated(() => urlLine.options = [shown]);
  return <layer x={0} y={0} w={0} h={0} />;
}
