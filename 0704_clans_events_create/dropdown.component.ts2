import { CS2, useRef, useState, useUniverse } from 'ts2';
import { ScrollbarVertical } from '../lib/scrollbar-vertical.component';
import { ThinBox } from '../lib/thin-box.component';
import { onMobile } from '../lib/lib.helpers';
import {
  Dropdown,
  EventArt,
  EventColor,
  EventField,
  EventFonts,
  EventSounds,
  Layout,
} from './clans-events-create.constants';
import { EventOptions, OptionSet, optionSetCount } from './event-options.data';
import { setEventValue, truncateToWidth } from './clans-events-create.helpers';
import {
  dropdownCellWidth,
  dropdownCellX,
  dropdownRowHeight,
  dropdownRowY,
  openField,
  openSet,
} from './dropdown.state';

export function EventDropdown(): Component {
  const [open, setOpen] = useState(openField);
  if (open === -1) {
    return null;
  }

  const field: EventField = open as EventField;
  const universe = useUniverse();
  const [heldSet] = useState(openSet);
  const set: OptionSet = heldSet as OptionSet;
  const rowHeight: Int = dropdownRowHeight();
  const contentHeight: Int = optionSetCount(set) * rowHeight;
  const wanted: Int = contentHeight + Dropdown.BOX_PADDING;

  const cellWidth: Int = dropdownCellWidth(field);
  const frameX: Int = (universe.width - Layout.FRAME_W) / 2;
  const frameY: Int = (universe.height - Layout.FRAME_H) / 2;
  const contentX: Int = frameX + Layout.CONTENT_INSET_W / 2;
  const cellX: Int = contentX + dropdownCellX(field);
  const cellY: Int = frameY + Layout.CONTENT_Y + dropdownRowY(field);

  const above: Int = cellY > universe.height / 2 ? 1 : 0;
  const edge: Int = above === 1 ? cellY + Dropdown.ABOVE_NUDGE : cellY + Layout.ROW_H - 1;
  const room: Int = above === 1 ? edge : universe.height - edge;
  const boxHeight: Int = Math.min(wanted, room);
  const boxY: Int = above === 1 ? edge - boxHeight : edge;

  const scrollHeight: Int = wanted > boxHeight ? contentHeight : 0;

  const list = useRef();

  return (
    <layer
      w="fill"
      h="fill"
      noClickThrough
      onClick={() => {
        setOpen(-1);
      }}
    >
      <layer x={cellX} y={boxY} w={cellWidth} h={boxHeight} noClickThrough>
        <sprite x="center" y="center" w="fill" h="fill" sprite={EventArt.CELL_BACKING} tiling />

        <layer
          ref={list}
          x={Dropdown.LIST_X}
          y="center"
          w={{ fill: Dropdown.LIST_INSET_W }}
          h={{ fill: Dropdown.LIST_INSET_H }}
          scrollHeight={scrollHeight}
        >
          <DropdownEntries field={field} set={set} rowHeight={rowHeight} cellWidth={cellWidth} />
        </layer>

        <layer
          x={{ right: Dropdown.SCROLLBAR_X }}
          y="center"
          w={Dropdown.SCROLLBAR_W}
          h={{ fill: Dropdown.LIST_INSET_H }}
        >
          <ScrollbarVertical
            content={list}
            track={EventArt.SCROLL_TRACK}
            capTopSprite={EventArt.SCROLL_CAP_TOP}
            thumbSprite={EventArt.SCROLL_THUMB}
            capBottomSprite={EventArt.SCROLL_CAP_BOTTOM}
            arrowUp={EventArt.SCROLL_ARROW_UP}
            arrowDown={EventArt.SCROLL_ARROW_DOWN}
          />
        </layer>

        <ThinBox />
      </layer>
    </layer>
  );
}

function DropdownEntries({
  field,
  set,
  rowHeight,
  cellWidth,
}: {
  field: EventField;
  set: OptionSet;
  rowHeight: Int;
  cellWidth: Int;
}): Component {
  const textWidth: Int = cellWidth - Dropdown.ENTRY_TEXT_INSET;

  return (
    <layer w="fill" h="fill">
      {EventOptions.filter((row) => row.set === set).map((row) => (
        <DropdownEntry
          field={field}
          slot={row.slot}
          top={row.order * rowHeight}
          rowHeight={rowHeight}
          label={truncateToWidth(row.label, textWidth, EventFonts.VALUE)}
        />
      ))}
    </layer>
  );
}

function DropdownEntry({
  field,
  slot,
  top,
  rowHeight,
  label,
}: {
  field: EventField;
  slot: Int;
  top: Int;
  rowHeight: Int;
  label: String;
}): Component {
  const [, setOpen] = useState(openField);
  const [lit, setLit] = useState(0);

  return (
    <layer x="center" y={top} w="fill" h={rowHeight}>
      <rect
        x="center"
        y={0}
        w="fill"
        h={rowHeight}
        fill
        color={EventColor.HOVER_STRIP}
        transparency={Dropdown.HOVER_TRANSPARENCY}
        hide={lit === 0}
      />
      <text
        x="center"
        y={0}
        w="fill"
        h={rowHeight}
        color={EventColor.ACCENT}
        shadow
        font={EventFonts.VALUE}
        align="center"
        valign="middle"
        text={label}
        options={['Select']}
        onMouseRepeat={() => {
          if (!onMobile()) {
            setLit(1);
          }
        }}
        onMouseLeave={() => setLit(0)}
        onOptionSelect={() => {
          CS2.sound_effect(EventSounds.SELECT, 1, 0);
          setEventValue(field, slot);
          setOpen(-1);
        }}
      />
    </layer>
  );
}
