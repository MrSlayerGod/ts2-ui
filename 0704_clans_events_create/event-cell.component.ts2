import { useDerived, useServerStateOnce, useState } from 'ts2';
import { onMobile, opsound } from '../lib/lib.helpers';
import {
  CellSkin,
  EventArt,
  EventColor,
  EventField,
  EventFieldLabels,
  EventFonts,
  EventVarbits,
  Layout,
} from './clans-events-create.constants';
import { OptionSet } from './event-options.data';
import {
  eventValue,
  fieldOptionSet,
  intCellText,
  joinRankTitle,
  selectedOptionLabel,
  truncateToWidth,
  valueTextWidth,
} from './clans-events-create.helpers';
import { openField, openSet } from './dropdown.state';

export function SelectionCell({ field, cellWidth = 110 }: { field: EventField; cellWidth?: Int }): Component {
  const [open, setOpen] = useState(openField);
  const [, setOpenSet] = useState(openSet);
  const type: Int = useServerStateOnce(EventVarbits.TYPE);
  const value: Int = useDerived(() => eventValue(field));
  const [lit, setLit] = useState(0);

  const set: OptionSet = fieldOptionSet(field, type);
  const text: String = truncateToWidth(selectedOptionLabel(set, value), valueTextWidth(cellWidth), EventFonts.VALUE);

  let isOpen: Int = 0;
  if (open === field) {
    isOpen = 1;
  }
  let backingSkin: Int = CellSkin.REST_TRANSPARENCY;
  let arrowSkin: Int = CellSkin.REST_TRANSPARENCY;
  let openArrow: Int = 0;
  if (isOpen === 1) {
    if (lit === 3) {
      backingSkin = CellSkin.HOVER_TRANSPARENCY;
      arrowSkin = CellSkin.HOVER_ARROW_TRANSPARENCY;
    } else {
      backingSkin = CellSkin.OPEN_TRANSPARENCY;
      openArrow = 1;
    }
  } else if (lit === 1) {
    backingSkin = CellSkin.HOVER_TRANSPARENCY;
    arrowSkin = CellSkin.HOVER_ARROW_TRANSPARENCY;
  }

  return (
    <>
      <sprite
        x="center"
        y="bottom"
        w="fill"
        h={Layout.VALUE_H}
        sprite={EventArt.CELL_BACKING}
        tiling
        transparency={backingSkin}
        onClick={() => {
          setLit(2);
          setOpenSet(set);
          setOpen(field);
        }}
        onMouseEnter={() => {
          if (isOpen === 0 && !onMobile()) {
            if (lit === 2) {
              setLit(3);
            } else {
              setLit(1);
            }
          }
        }}
        onMouseLeave={() => {
          if (isOpen === 0 || lit === 2) {
            setLit(0);
          }
        }}
      />
      <rect x="center" y="bottom" w="fill" h={Layout.VALUE_H} color={EventColor.OUTLINE_OUTER} />
      <rect
        x="center"
        y={{ bottom: Layout.INNER_OUTLINE_INSET }}
        w={{ fill: 2 }}
        h={Layout.INNER_OUTLINE_H}
        color={EventColor.OUTLINE_INNER}
      />
      <sprite
        x={{ right: 2 }}
        y={{ bottom: 2 }}
        w={Layout.ARROW}
        h={Layout.ARROW}
        sprite={openArrow === 1 ? EventArt.ARROW_OPEN : EventArt.ARROW_CLOSED}
        transparency={arrowSkin}
      />
      <text
        x={{ left: 2 }}
        y={{ bottom: 2 }}
        w={{ fill: Layout.VALUE_INSET }}
        h={Layout.ARROW}
        font={EventFonts.VALUE}
        shadow
        color={EventColor.ACCENT}
        align="center"
        valign="middle"
        text={text}
      />
      <text
        x={2}
        y={0}
        w={{ fill: 3 }}
        h={Layout.CAPTION_H}
        color={EventColor.ACCENT}
        shadow
        font={EventFonts.LABEL}
        align="left"
        valign="middle"
        text={`${EventFieldLabels.get(field)}:`}
      />
    </>
  );
}

export function RankCell(): Component {
  const text: String = truncateToWidth(joinRankTitle(), valueTextWidth(Layout.CELL_W), EventFonts.VALUE);
  const [lit, setLit] = useState(0);

  return (
    <>
      <sprite
        x="center"
        y="bottom"
        w="fill"
        h={Layout.VALUE_H}
        sprite={EventArt.CELL_BACKING}
        tiling
        transparency={lit === 1 ? CellSkin.HOVER_TRANSPARENCY : CellSkin.REST_TRANSPARENCY}
        onMouseEnter={() => {
          if (!onMobile()) {
            setLit(1);
          }
        }}
        onMouseLeave={() => setLit(0)}
      />
      <rect x="center" y="bottom" w="fill" h={Layout.VALUE_H} color={EventColor.OUTLINE_OUTER} />
      <rect
        x="center"
        y={{ bottom: Layout.INNER_OUTLINE_INSET }}
        w={{ fill: 2 }}
        h={Layout.INNER_OUTLINE_H}
        color={EventColor.OUTLINE_INNER}
      />
      <sprite
        x={{ right: 2 }}
        y={{ bottom: 2 }}
        w={Layout.ARROW}
        h={Layout.ARROW}
        sprite={EventArt.ARROW_CLOSED}
        transparency={lit === 1 ? CellSkin.HOVER_ARROW_TRANSPARENCY : CellSkin.REST_TRANSPARENCY}
      />
      <text
        x={{ left: 2 }}
        y={{ bottom: 2 }}
        w={{ fill: Layout.VALUE_INSET }}
        h={Layout.ARROW}
        font={EventFonts.VALUE}
        shadow
        color={EventColor.ACCENT}
        align="center"
        valign="middle"
        text={text}
      />
      <text
        x={2}
        y={0}
        w={{ fill: 3 }}
        h={Layout.CAPTION_H}
        color={EventColor.ACCENT}
        shadow
        font={EventFonts.LABEL}
        align="left"
        valign="middle"
        text={`${EventFieldLabels.get(EventField.JOIN_RANK)}:`}
      />
    </>
  );
}

export function IntCell({ field }: { field: EventField }): Component {
  const value: Int = useDerived(() => eventValue(field));
  const [lit, setLit] = useState(0);

  return (
    <>
      <sprite
        x="center"
        y="bottom"
        w="fill"
        h={Layout.VALUE_H}
        sprite={EventArt.CELL_BACKING}
        tiling
        transparency={lit === 1 ? CellSkin.HOVER_TRANSPARENCY : CellSkin.REST_TRANSPARENCY}
      />
      <rect x="center" y="bottom" w="fill" h={Layout.VALUE_H} color={EventColor.OUTLINE_OUTER} />
      <rect
        x="center"
        y={{ bottom: Layout.INNER_OUTLINE_INSET }}
        w={{ fill: 2 }}
        h={Layout.INNER_OUTLINE_H}
        color={EventColor.OUTLINE_INNER}
      />
      <layer
        w="fill"
        h="fill"
        onMouseEnter={() => {
          if (!onMobile()) {
            setLit(1);
          }
        }}
        onMouseLeave={() => setLit(0)}
      >
        <text
          x={2}
          y={{ bottom: 2 }}
          w="fill"
          h={Layout.ARROW}
          font={EventFonts.VALUE}
          shadow
          color={EventColor.ACCENT}
          align="center"
          valign="middle"
          text={intCellText(field, value)}
        />
      </layer>
      <text
        x={2}
        y={0}
        w={{ fill: 3 }}
        h={Layout.CAPTION_H}
        color={EventColor.ACCENT}
        shadow
        font={EventFonts.LABEL}
        align="left"
        valign="middle"
        text={`${EventFieldLabels.get(field)}:`}
      />
    </>
  );
}
