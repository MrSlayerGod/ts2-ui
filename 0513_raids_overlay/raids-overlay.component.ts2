import { createRef, onMounted, onUpdated, useInterval, useState } from 'ts2';

import { Anchor, overlayInit } from '../lib/lib.overlay';
import { ThinStoneBox } from '../lib/thin-stone-box.component';
import { Layout, RaidsColor, RaidsFonts, RaidsOverlayDodge, RaidsSprites } from './raids-overlay.constants';
import {
  raidsClockTick,
  raidsLabelColumn,
  raidsPlateBuilds,
  raidsPlateWidth,
  raidsValueColumn,
} from './raids-overlay.helpers';
import {
  raidsFadeFrom,
  raidsFadeHidden,
  raidsFadeStep,
  raidsFadeTick,
  raidsFadeTo,
  raidsFadeTransparency,
} from './raids-overlay.state';

const dodger = createRef('raids_overlay_dodger');
const plate = createRef('raids_overlay_plate');

export function RaidsOverlay(): Component {
  useInterval(() => raidsClockTick(), plate);

  return (
    <layer x="center" y="center" w="fill" h="fill">
      <RaidsFader />

      <layer
        static
        ref={dodger}
        onLoad={() => overlayInit(dodger, plate, RaidsOverlayDodge.DODGE, Anchor.LEFT, Anchor.TOP, 1)}
        x={0}
        y={0}
        w="fill"
        h="fill"
      >
        <layer static ref={plate} x={Layout.PLATE_X} y={Layout.PLATE_Y} w={Layout.PLATE_W} h={Layout.PLATE_H}>
          <RaidsPlateContent />
        </layer>
      </layer>
    </layer>
  );
}

function RaidsPlateContent(): Component {
  const builds: Boolean = raidsPlateBuilds();

  const width: Int = builds ? raidsPlateWidth() : Layout.PLATE_W;
  const height: Int = builds ? Layout.PLATE_BUILT_H : Layout.PLATE_H;
  onMounted(() => sizePlate(width, height));
  onUpdated(() => sizePlate(width, height));

  return (
    <layer w="fill" h="fill">
      {builds && (
        <>
          <sprite x="center" y="center" w="fill" h="fill" sprite={RaidsSprites.BACKING} tiling />

          <ThinStoneBox />

          <text
            x="center"
            y="center"
            w={{ fill: Layout.COLUMN_MARGIN }}
            h="fill"
            text={raidsLabelColumn()}
            font={RaidsFonts.ROW}
            color={RaidsColor.LABEL}
            shadow
            align="left"
            valign="middle"
          />

          <text
            x="center"
            y="center"
            w={{ fill: Layout.COLUMN_MARGIN }}
            h="fill"
            text={raidsValueColumn()}
            font={RaidsFonts.ROW}
            color={RaidsColor.VALUE}
            shadow
            align="right"
            valign="middle"
          />
        </>
      )}
    </layer>
  );
}

function sizePlate(width: Int, height: Int): void {
  plate.props = { x: Layout.PLATE_X, y: Layout.PLATE_Y, w: width, h: height };
}

function RaidsFader(): Component {
  const [from] = useState(raidsFadeFrom);
  const [to] = useState(raidsFadeTo);
  const [step] = useState(raidsFadeStep);
  useInterval(() => raidsFadeTick());

  return (
    <layer x="center" y="center" w="fill" h="fill">
      <rect
        x="center"
        y="center"
        w="fill"
        h="fill"
        color={RaidsColor.FADER}
        fill
        transparency={raidsFadeTransparency(from, to, step)}
        hide={raidsFadeHidden(to, step)}
      />
    </layer>
  );
}
