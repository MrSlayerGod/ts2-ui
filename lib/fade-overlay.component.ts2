import { CS2, useInterval, useState } from 'ts2';

import { hexToRgb, rgbToHex } from '../0259_area_task/area-task.helpers';

export function FadeOverlay({
  from,
  fromAlpha,
  to,
  toAlpha,
  cycles,
  end,
  keepHidden,
}: {
  from: Int;
  fromAlpha: Int;
  to: Int;
  toAlpha: Int;
  cycles: Int;
  end: Int;
  keepHidden: Int;
}): Component {
  const [seenEnd, setSeenEnd] = useState(-1);
  const [left, setLeft] = useState(0);

  useInterval(() => {
    if (cycles > 0) {
      const now: Int = end - CS2.clientclock();
      setSeenEnd(end);
      setLeft(now > 0 ? now : 0);
    }
  });

  let remaining: Int = 0;
  if (cycles > 0) {
    remaining = seenEnd === end ? left : cycles;
  }
  const colour: Int = remaining > 0 ? fadeColourAt(from, to, remaining, cycles) : to;
  const alpha: Int = remaining > 0 ? toAlpha - CS2.interpolate(0, remaining, 0, cycles, toAlpha - fromAlpha) : toAlpha;
  const hidden: Boolean = remaining <= 0 && (toAlpha >= 255 || (cycles <= 0 && keepHidden === 1));

  return <rect w="fill" h="fill" fill color={colour} transparency={alpha} hide={hidden} />;
}

export function fadeColourAt(from: Int, to: Int, left: Int, cycles: Int): Int {
  const [r0, g0, b0] = hexToRgb(from);
  const [r1, g1, b1] = hexToRgb(to);
  return rgbToHex(
    r1 - CS2.interpolate(0, left, 0, cycles, r1 - r0),
    g1 - CS2.interpolate(0, left, 0, cycles, g1 - g0),
    b1 - CS2.interpolate(0, left, 0, cycles, b1 - b0),
  );
}

export function fadeAlpha(value: Int): Int {
  if (value < 0) {
    return 0;
  }
  if (value > 255) {
    return 255;
  }
  return value;
}

export function fadeHiddenBefore(called: Int, toAlpha: Int, cycles: Int, end: Int, keepHidden: Int): Int {
  if (called === 0) {
    return 0;
  }
  if (cycles <= 0 && keepHidden === 1) {
    return 1;
  }
  if (toAlpha < 255) {
    return 0;
  }
  if (cycles <= 0 || CS2.clientclock() >= end) {
    return 1;
  }
  return 0;
}
