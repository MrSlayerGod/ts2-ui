import { sessionState, useState } from 'ts2';
import { playSound } from '../lib.engine';
import { xpdropsFake6 } from '../game/varcs';
import { closeSeekPrompt } from './loadout-chrome.component';
import {
  Layout,
  SuppliesColor,
  SuppliesFonts,
  SuppliesSounds,
  SuppliesSprites,
} from '../../0758_pvp_arena_stagingarea_supplies/pvp-arena-stagingarea-supplies.constants';

export function SuppliesTab({
  index,
  label,
  active,
  repaint,
}: {
  index: Int;
  label: String;
  active: Boolean;
  repaint: Int;
}): Component {
  const [hoverPaint, setHoverPaint] = useState(0);
  const [hoverStamp, setHoverStamp] = useState(0);
  const hovered: Boolean = hoverPaint === (active ? 2 : 1) && hoverStamp === repaint;
  let end: Sprite = active ? SuppliesSprites.TAB_END_ON : SuppliesSprites.TAB_END_OFF;
  let middle: Sprite = active ? SuppliesSprites.TAB_MID_ON : SuppliesSprites.TAB_MID_OFF;
  if (hovered) {
    end = SuppliesSprites.TAB_END_HOVER;
    middle = SuppliesSprites.TAB_MID_HOVER;
  }

  return (
    <layer
      w="fill"
      h="fill"
      onMouseEnter={
        active
          ? undefined
          : () => {
              setHoverPaint(suppliesTabNow() === index ? 2 : 1);
              setHoverStamp(repaint);
            }
      }
      onMouseLeave={
        active
          ? undefined
          : () => {
              if (suppliesTabNow() !== index) {
                setHoverPaint(0);
              }
            }
      }
      onClick={
        active
          ? undefined
          : () => {
              playSound(SuppliesSounds.CLICK);
              closeSeekPrompt();
              chooseSuppliesTab(index);
            }
      }
    >
      <sprite x="left" y="bottom" w={Layout.tab.endW} h={Layout.tab.endH} sprite={end} />
      <sprite x="right" y="bottom" w={Layout.tab.endW} h={Layout.tab.endH} sprite={end} hflip />
      <sprite x="center" y="bottom" w={{ fill: Layout.tab.middleInset }} h={Layout.tab.endH} sprite={middle} tiling />
      <text
        x="center"
        y={{ center: Layout.tab.labelDy }}
        w="fill"
        h="fill"
        font={SuppliesFonts.BODY}
        color={SuppliesColor.LABEL}
        shadow
        align="center"
        valign="middle"
        text={label}
      />
    </layer>
  );
}

export function suppliesTabNow(): Int {
  const [tab] = useState(xpdropsFake6);
  return tab;
}

export const suppliesTabUnpainted = sessionState(0);

export function chooseSuppliesTab(tab: Int): void {
  const [, setTab] = useState(xpdropsFake6);
  const [, setUnpainted] = useState(suppliesTabUnpainted);
  setTab(tab);
  setUnpainted(0);
}
