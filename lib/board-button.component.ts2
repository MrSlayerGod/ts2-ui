import { CS2, onMounted, useInterval, useState } from 'ts2';

import { Fonts } from './game/fonts';
import { Sounds } from './game/sounds';
import { clientClock, playSound } from './lib.engine';
import { onMobile } from './lib.helpers';
import { StoneButtonOutFilled } from './stone-button-out-filled.component';
import { StoneButtonPressedFilled } from './stone-button-pressed-filled.component';

export function BoardButton({
  label,
  pressed = false,
  pressedAt = 0,
  resumeIn = -1,
  resumeAt = -1,
}: {
  label: String;
  pressed?: Boolean;
  pressedAt?: Int;
  resumeIn?: ComponentId;
  resumeAt?: Int;
}): Component {
  const [hovered, setHovered] = useState(0);
  const [readyAt, setReadyAt] = useState(0);

  useInterval(() => {
    if (readyAt !== 0 && clientClock() >= readyAt) {
      setReadyAt(0);
      setHovered(0);
    }
  });

  let deadline: Int = readyAt;
  if (pressedAt !== 0 && pressedAt + BUSY_CYCLES > deadline) {
    deadline = pressedAt + BUSY_CYCLES;
  }

  const busy: Int = deadline !== 0 ? 1 : 0;
  const down: Int = busy === 1 || pressed || hovered === 1 ? 1 : 0;

  return (
    <layer
      w="fill"
      h="fill"
      options={[CS2.tags_remove(label)]}
      onMouseRepeat={
        busy === 1 || pressed
          ? undefined
          : () => {
              if (!onMobile()) {
                setHovered(1);
              }
            }
      }
      onMouseLeave={
        busy === 1 || pressed
          ? undefined
          : () => {
              setHovered(0);
            }
      }
      onOptionSelect={(event) => {
        if (readyAt !== 0) {
          return;
        }
        playSound(Sounds.INTERFACE_SELECT1);
        if (resumeAt === -1) {
          CS2.if_resume_pausebutton(event.component);
        } else if (CS2.cc_find(resumeIn, resumeAt) === true) {
          CS2.cc_resume_pausebutton();
        }
        setReadyAt(clientClock() + BUSY_CYCLES);
      }}
    >
      {down === 1 ? <StoneButtonPressedFilled /> : <StoneButtonOutFilled />}
      <text
        x="center"
        y="center"
        w="fill"
        h="fill"
        text={busy === 1 ? LOADING_LABEL : label}
        font={Fonts.P12_FULL}
        color={LABEL_COLOR}
        align="center"
        valign="middle"
        shadow
      />
    </layer>
  );
}

export function BoardAnchors({ universe, count }: { universe: ComponentId; count: Int }): Component {
  onMounted(() => {
    let n: Int = 0;
    while (n < count) {
      CS2.cc_create(universe, IFTYPE_RECTANGLE, n, false);
      CS2.cc_hide_set(true);
      n = n + 1;
    }
  });
  return <rect x={0} y={0} w={0} h={0} hide />;
}

const IFTYPE_RECTANGLE = 3;

export function setColorTransparency(target: ComponentId, color: Int, transparency: Int): void {
  target.color = color;
  target.transparency = transparency;
}

const LOADING_LABEL = '<col=7f7f7f>...</col>';
const LABEL_COLOR = 0xff981f;
const BUSY_CYCLES = 80;
