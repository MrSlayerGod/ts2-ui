import { Cell, HiscoresColour, HiscoresFonts } from './hiscores.constants';
import { HiscoresActivities, HiscoresBosses, HiscoresSkills } from './hiscores.data';
import { hiscoreCount, hiscoreLevel } from './hiscores.helpers';

export function SkillCells({ third, top, loaded }: { third: Int; top: Int; loaded: Boolean }): Component {
  return (
    <>
      {HiscoresSkills.map((row, i) => (
        <>
          <sprite
            x={(i % 3) * third + third / 2 - Cell.ICON}
            y={top + (i / 3) * Cell.PITCH}
            w={Cell.ICON}
            h={Cell.ICON}
            sprite={row.icon}
          />
          <text
            x={(i % 3) * third + third / 2}
            y={top + (i / 3) * Cell.PITCH}
            w={Cell.VALUE_W}
            h={Cell.ICON}
            font={HiscoresFonts.VALUE}
            shadow
            color={HiscoresColour.ORANGE}
            align="center"
            valign="middle"
            text={loaded ? `${hiscoreLevel(row.skill)}` : Cell.PLACEHOLDER}
          />
        </>
      ))}
    </>
  );
}

